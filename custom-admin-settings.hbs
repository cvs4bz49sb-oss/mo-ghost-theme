{{!< default}}
{{!-- /admin/settings/ — site-wide operational settings + admin user management.
     Journal status, gate config stored in KV. Admin permissions stored in KV.
     Staff-only writes; site settings are read publicly by site-settings.js. --}}

<main class="admin-page admin-workspace">

  {{#if @member}}

    {{> "admin-sidebar" active="settings"}}
    <div class="admin-main">
      <header class="admin-topbar">
        <h1 class="admin-topbar-title"><em>Settings</em></h1>
        <p class="admin-topbar-sub">Site configuration and admin access control.</p>
      </header>

    <section class="admin-body">
      <div class="container container-narrow">
        <div class="admin-settings"
             data-admin-settings
             data-worker-url="{{@custom.admin_worker_url}}">

          {{!-- Site Settings --}}
          <div class="settings-section" data-settings-form>
            <h2 class="settings-section-title"><em>Site</em></h2>
            <p class="settings-section-desc">Operational values that affect the public site. Changes take effect within a minute.</p>

            <div class="settings-group">
              <h3 class="settings-group-title">Journal Status</h3>
              <label class="settings-field">
                <span class="settings-field-label">Issue label</span>
                <input type="text" name="journal_status_issue" class="settings-input" placeholder="e.g. Summer 2026" />
              </label>
              <label class="settings-field">
                <span class="settings-field-label">Current stage</span>
                <select name="journal_status_stage" class="settings-select">
                  <option value="Drafting">Drafting</option>
                  <option value="In Production">In Production</option>
                  <option value="Arriving">Arriving</option>
                </select>
              </label>
            </div>

            <div class="settings-group">
              <h3 class="settings-group-title">Subscriber Gate</h3>
              <label class="settings-field">
                <span class="settings-field-label">Gate days</span>
                <input type="number" name="gate_days" class="settings-input settings-input--short" min="0" step="1" placeholder="7" />
                <span class="settings-field-hint">Days after publication before the soft gate appears. 0 disables.</span>
              </label>
              <label class="settings-field">
                <span class="settings-field-label">Gate tier</span>
                <select name="gate_tier" class="settings-select">
                  <option value="members">Members (any signed-in)</option>
                  <option value="paid">Paid only</option>
                </select>
              </label>
            </div>

            <div class="settings-group">
              <h3 class="settings-group-title">Sponsorship Inventory</h3>
              <p class="settings-group-desc">Status of each ad spot shown on the public /sponsorship/ page. Set "Filled" and a date to show when a spot opens up.</p>

              <h4 class="settings-subgroup-title">Weekly Digest</h4>
              <div class="settings-row">
                <label class="settings-field settings-field--half">
                  <span class="settings-field-label">Top Ad</span>
                  <select name="sponsor_nl_top_status" class="settings-select">
                    <option value="available">Available</option>
                    <option value="filled">Filled</option>
                  </select>
                </label>
                <label class="settings-field settings-field--half">
                  <span class="settings-field-label">Filled until</span>
                  <input type="text" name="sponsor_nl_top_until" class="settings-input" placeholder="e.g. August 2026" />
                </label>
              </div>
              <div class="settings-row">
                <label class="settings-field settings-field--half">
                  <span class="settings-field-label">Bottom Ad</span>
                  <select name="sponsor_nl_bottom_status" class="settings-select">
                    <option value="available">Available</option>
                    <option value="filled">Filled</option>
                  </select>
                </label>
                <label class="settings-field settings-field--half">
                  <span class="settings-field-label">Filled until</span>
                  <input type="text" name="sponsor_nl_bottom_until" class="settings-input" placeholder="e.g. August 2026" />
                </label>
              </div>

              <h4 class="settings-subgroup-title">Website</h4>
              <div class="settings-row">
                <label class="settings-field settings-field--half">
                  <span class="settings-field-label">Homepage Slide-In</span>
                  <select name="sponsor_web_homepage_status" class="settings-select">
                    <option value="available">Available</option>
                    <option value="filled">Filled</option>
                  </select>
                </label>
                <label class="settings-field settings-field--half">
                  <span class="settings-field-label">Filled until</span>
                  <input type="text" name="sponsor_web_homepage_until" class="settings-input" placeholder="e.g. August 2026" />
                </label>
              </div>
              <div class="settings-row">
                <label class="settings-field settings-field--half">
                  <span class="settings-field-label">Church</span>
                  <select name="sponsor_web_cat_church_status" class="settings-select">
                    <option value="available">Available</option>
                    <option value="filled">Filled</option>
                  </select>
                </label>
                <label class="settings-field settings-field--half">
                  <span class="settings-field-label">Filled until</span>
                  <input type="text" name="sponsor_web_cat_church_until" class="settings-input" placeholder="e.g. August 2026" />
                </label>
              </div>
              <div class="settings-row">
                <label class="settings-field settings-field--half">
                  <span class="settings-field-label">Culture</span>
                  <select name="sponsor_web_cat_culture_status" class="settings-select">
                    <option value="available">Available</option>
                    <option value="filled">Filled</option>
                  </select>
                </label>
                <label class="settings-field settings-field--half">
                  <span class="settings-field-label">Filled until</span>
                  <input type="text" name="sponsor_web_cat_culture_until" class="settings-input" placeholder="e.g. August 2026" />
                </label>
              </div>
              <div class="settings-row">
                <label class="settings-field settings-field--half">
                  <span class="settings-field-label">Formation</span>
                  <select name="sponsor_web_cat_formation_status" class="settings-select">
                    <option value="available">Available</option>
                    <option value="filled">Filled</option>
                  </select>
                </label>
                <label class="settings-field settings-field--half">
                  <span class="settings-field-label">Filled until</span>
                  <input type="text" name="sponsor_web_cat_formation_until" class="settings-input" placeholder="e.g. August 2026" />
                </label>
              </div>
              <div class="settings-row">
                <label class="settings-field settings-field--half">
                  <span class="settings-field-label">Family</span>
                  <select name="sponsor_web_cat_family_status" class="settings-select">
                    <option value="available">Available</option>
                    <option value="filled">Filled</option>
                  </select>
                </label>
                <label class="settings-field settings-field--half">
                  <span class="settings-field-label">Filled until</span>
                  <input type="text" name="sponsor_web_cat_family_until" class="settings-input" placeholder="e.g. August 2026" />
                </label>
              </div>
              <div class="settings-row">
                <label class="settings-field settings-field--half">
                  <span class="settings-field-label">Theology</span>
                  <select name="sponsor_web_cat_theology_status" class="settings-select">
                    <option value="available">Available</option>
                    <option value="filled">Filled</option>
                  </select>
                </label>
                <label class="settings-field settings-field--half">
                  <span class="settings-field-label">Filled until</span>
                  <input type="text" name="sponsor_web_cat_theology_until" class="settings-input" placeholder="e.g. August 2026" />
                </label>
              </div>
              <div class="settings-row">
                <label class="settings-field settings-field--half">
                  <span class="settings-field-label">Technology</span>
                  <select name="sponsor_web_cat_technology_status" class="settings-select">
                    <option value="available">Available</option>
                    <option value="filled">Filled</option>
                  </select>
                </label>
                <label class="settings-field settings-field--half">
                  <span class="settings-field-label">Filled until</span>
                  <input type="text" name="sponsor_web_cat_technology_until" class="settings-input" placeholder="e.g. August 2026" />
                </label>
              </div>
              <div class="settings-row">
                <label class="settings-field settings-field--half">
                  <span class="settings-field-label">Book Reviews</span>
                  <select name="sponsor_web_cat_bookreviews_status" class="settings-select">
                    <option value="available">Available</option>
                    <option value="filled">Filled</option>
                  </select>
                </label>
                <label class="settings-field settings-field--half">
                  <span class="settings-field-label">Filled until</span>
                  <input type="text" name="sponsor_web_cat_bookreviews_until" class="settings-input" placeholder="e.g. August 2026" />
                </label>
              </div>

              <h4 class="settings-subgroup-title">Mere Fidelity</h4>
              <div class="settings-row">
                <label class="settings-field settings-field--half">
                  <span class="settings-field-label">Pre-Roll</span>
                  <select name="sponsor_mf_preroll_status" class="settings-select">
                    <option value="available">Available</option>
                    <option value="filled">Filled</option>
                  </select>
                </label>
                <label class="settings-field settings-field--half">
                  <span class="settings-field-label">Filled until</span>
                  <input type="text" name="sponsor_mf_preroll_until" class="settings-input" placeholder="e.g. August 2026" />
                </label>
              </div>
              <div class="settings-row">
                <label class="settings-field settings-field--half">
                  <span class="settings-field-label">Mid-Roll</span>
                  <select name="sponsor_mf_midroll_status" class="settings-select">
                    <option value="available">Available</option>
                    <option value="filled">Filled</option>
                  </select>
                </label>
                <label class="settings-field settings-field--half">
                  <span class="settings-field-label">Filled until</span>
                  <input type="text" name="sponsor_mf_midroll_until" class="settings-input" placeholder="e.g. August 2026" />
                </label>
              </div>
              <div class="settings-row">
                <label class="settings-field settings-field--half">
                  <span class="settings-field-label">Post-Roll</span>
                  <select name="sponsor_mf_postroll_status" class="settings-select">
                    <option value="available">Available</option>
                    <option value="filled">Filled</option>
                  </select>
                </label>
                <label class="settings-field settings-field--half">
                  <span class="settings-field-label">Filled until</span>
                  <input type="text" name="sponsor_mf_postroll_until" class="settings-input" placeholder="e.g. August 2026" />
                </label>
              </div>

              <h4 class="settings-subgroup-title">Christians Reading Classics</h4>
              <div class="settings-row">
                <label class="settings-field settings-field--half">
                  <span class="settings-field-label">Pre-Roll</span>
                  <select name="sponsor_crc_preroll_status" class="settings-select">
                    <option value="available">Available</option>
                    <option value="filled">Filled</option>
                  </select>
                </label>
                <label class="settings-field settings-field--half">
                  <span class="settings-field-label">Filled until</span>
                  <input type="text" name="sponsor_crc_preroll_until" class="settings-input" placeholder="e.g. August 2026" />
                </label>
              </div>
              <div class="settings-row">
                <label class="settings-field settings-field--half">
                  <span class="settings-field-label">Mid-Roll</span>
                  <select name="sponsor_crc_midroll_status" class="settings-select">
                    <option value="available">Available</option>
                    <option value="filled">Filled</option>
                  </select>
                </label>
                <label class="settings-field settings-field--half">
                  <span class="settings-field-label">Filled until</span>
                  <input type="text" name="sponsor_crc_midroll_until" class="settings-input" placeholder="e.g. August 2026" />
                </label>
              </div>
              <div class="settings-row">
                <label class="settings-field settings-field--half">
                  <span class="settings-field-label">Post-Roll</span>
                  <select name="sponsor_crc_postroll_status" class="settings-select">
                    <option value="available">Available</option>
                    <option value="filled">Filled</option>
                  </select>
                </label>
                <label class="settings-field settings-field--half">
                  <span class="settings-field-label">Filled until</span>
                  <input type="text" name="sponsor_crc_postroll_until" class="settings-input" placeholder="e.g. August 2026" />
                </label>
              </div>
            </div>

            <div class="settings-actions">
              <button type="button" class="btn btn-primary" data-settings-submit>Save settings</button>
              <span class="settings-status" data-settings-status hidden></span>
            </div>
          </div>

          {{!-- Admin Users (staff-only section — hidden for non-staff via JS) --}}
          <div class="settings-section" data-admin-users-section hidden>
            <h2 class="settings-section-title"><em>Admin Access</em></h2>
            <p class="settings-section-desc">Grant dashboard access to people who aren't Ghost staff. Each user gets per-tool permissions enforced on every request.</p>

            <div class="settings-actions settings-actions--top">
              <button type="button" class="btn btn-primary" data-au-add>+ Add user</button>
            </div>

            <div class="au-list" data-au-list>
              <p class="au-empty" data-au-empty>No admin users configured yet.</p>
            </div>
          </div>

        </div>
      </div>
    </section>

    </div>

  {{else}}
    {{> "admin-denied"}}
  {{/if}}

</main>

<script src="{{asset "js/admin-auth.js"}}"></script>
<script src="{{asset "js/admin-sidebar.js"}}"></script>
<script src="{{asset "js/admin-settings.js"}}"></script>
