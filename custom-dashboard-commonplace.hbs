{{!< default}}
{{#contentFor "moHead"}}
<title>Your Commonplace Book | Mere Orthodoxy</title>
<meta name="description" content="Passages you have marked and kept from Mere Orthodoxy essays." />
<meta property="og:title" content="Your Commonplace Book" />
<meta property="og:description" content="Passages you have marked and kept from Mere Orthodoxy essays." />
<meta name="twitter:title" content="Your Commonplace Book" />
<meta name="twitter:description" content="Passages you have marked and kept from Mere Orthodoxy essays." />
{{/contentFor}}
{{!-- /dashboard/commonplace/ — full commonplace book list. Gating logic
     mirrors custom-dashboard.hbs. Paid/comped only. --}}

<main class="dashboard">

  {{#unless @member}}
    <section class="hero dashboard-hero">
      <div class="container">
        <p class="hero-kicker"><span class="dot"></span> Member Dashboard</p>
        <h1 class="hero-headline">Sign in to view your <span class="highlight"><em>Commonplace Book</em></span>.</h1>
        <p class="dashboard-actions">
          <a href="#/portal/signin" class="btn btn-primary" data-portal="signin">Sign in</a>
          <a href="/membership/" class="btn btn-ghost">Become a Member</a>
        </p>
      </div>
    </section>
  {{else}}

    {{#match @member.status "paid"}}{{> "dashboard-full-list" kind="commonplace"}}{{else}}
    {{#match @member.status "comped"}}{{> "dashboard-full-list" kind="commonplace"}}{{else}}
      <section class="hero dashboard-hero">
        <div class="container">
          <p class="hero-kicker"><span class="dot"></span> Member Dashboard</p>
          <h1 class="hero-headline">Commonplace Book is a <span class="highlight"><em>member feature</em></span>.</h1>
          <p class="dashboard-actions"><a href="/membership/" class="btn btn-primary">Become a Member</a></p>
        </div>
      </section>
    {{/match}}
    {{/match}}

  {{/unless}}

</main>

<script src="{{asset "js/dashboard.js"}}"></script>
