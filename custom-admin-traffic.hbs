{{!< default}}
{{!-- /admin/traffic/ — Plausible analytics.
     Page skeleton renders for any signed-in member; the mo-admin
     worker returns 403 if the caller's email isn't in ADMIN_EMAILS,
     and admin-traffic.js surfaces that as a denied state. --}}

<main class="admin-page admin-workspace">

  {{#if @member}}
    {{> "admin-sidebar" active="traffic"}}
    <div class="admin-main">
      <header class="admin-topbar">
        <h1 class="admin-topbar-title"><em>Traffic</em></h1>
        <p class="admin-topbar-sub">Who's reading what, from where, how long. Via Plausible.</p>
      </header>
    {{> "admin-traffic-body"}}
    </div>
  {{else}}
    {{> "admin-denied"}}
  {{/if}}

</main>

<script src="{{asset "js/admin-auth.js"}}"></script>
<script src="{{asset "js/admin-sidebar.js"}}"></script>
<script src="{{asset "js/admin-traffic.js"}}"></script>
