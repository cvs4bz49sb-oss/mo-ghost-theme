{{!< default}}
{{#contentFor "moHead"}}
<title>Search The Faith Received</title>
<meta name="description" content="Search across every creed, confession, catechism, and classic work in The Faith Received." />
<meta property="og:title" content="Search The Faith Received" />
<meta property="og:description" content="Search across every creed, confession, catechism, and classic work in The Faith Received." />
<meta name="twitter:title" content="Search The Faith Received" />
<meta name="twitter:description" content="Search across every creed, confession, catechism, and classic work in The Faith Received." />
{{/contentFor}}
{{!-- /the-faith-received/search/ — full-text search across every
     document, section, Q&A, thesis, and chapter in The Faith Received.
     Index is built at theme-build time (scripts/build-faith-received.mjs)
     and served as a static asset. fuse.js is loaded from a CDN. --}}

<main class="faith-received faith-feature">

  <section class="bhero bhero--tool">
  <div class="bhero-inner container">
    <p class="bhero-kicker">The Faith Received &middot; Search</p>
    <h1>Search</h1>
    <p class="bhero-sub">Search across every creed, confession, catechism, and library work in the reading room. Results link directly to the passage.</p>
      <form class="faith-search-form" data-faith-search novalidate>
        <label class="visually-hidden" for="faith-search-input">Search The Faith Received</label>
        <input
          type="search"
          id="faith-search-input"
          name="q"
          autocomplete="off"
          autocapitalize="off"
          autocorrect="off"
          spellcheck="false"
          placeholder="Try &ldquo;justification&rdquo; or &ldquo;Lord's Supper&rdquo; or &ldquo;Augustine&rdquo;"
          data-faith-search-input
        />
        <button type="submit" class="btn btn-primary" aria-label="Search">
          <span class="btn-label">Search</span>
        </button>
      </form>
  </div>
</section>


  <section class="bband faith-feature-body">
    <div class="container container-narrow" data-faith-search-page>
      <p class="faith-search-status" data-faith-search-status role="status" aria-live="polite"></p>
      <ol class="faith-search-results" data-faith-search-results></ol>

      <div class="faith-search-empty" data-faith-search-empty hidden>
        <p>No results. Try a different phrase, or browse by document.</p>
        <p><a class="btn btn-outline" href="/the-faith-received/">Back to The Faith Received</a></p>
      </div>
    </div>
  </section>

  {{!-- No prices here on purpose: /membership/ is where they live, and a
       number repeated in two places is a number that goes stale in one. --}}
  <section class="faith-join">
  <div class="container">
    <p class="blabel">Become a member</p>
    <h2>Use the tools and support the work.</h2>
    {{#match @member.status "paid"}}{{else}}{{#match @member.status "comped"}}{{else}}
      <div class="toggle-wrap" role="tablist" aria-label="Billing interval">
        <div class="toggle">
          <button type="button" class="toggle-option is-active" data-interval="annual" role="tab" aria-selected="true" data-hm-goal="plan-annual">
            Annual
            <span class="badge">Save 17%</span>
          </button>
          <button type="button" class="toggle-option" data-interval="monthly" role="tab" aria-selected="false" data-hm-goal="plan-monthly">Monthly</button>
        </div>
      </div>
    {{/match}}{{/match}}
  </div>
</section>

{{> "membership-pricing"}}
</main>

<script src="{{asset "js/page/membership-toggle.js"}}"></script>
<script src="{{asset "js/page/membership-cards.js"}}"></script>


{{!-- SRI on the CDN script: the browser refuses to execute if the
     hash doesn't match, so a jsdelivr compromise can't ship attacker
     JS to /the-faith-received/search/ visitors. Hash regenerated by:
       openssl dgst -sha384 -binary fuse.min.js | openssl base64 -A --}}
<script src="https://cdn.jsdelivr.net/npm/fuse.js@7.0.0/dist/fuse.min.js"
        integrity="sha384-PCSoOZTpbkikBEtd/+uV3WNdc676i9KUf01KOA8CnJotvlx8rRrETbDuwdjqTYvt"
        crossorigin="anonymous"></script>
<script src="{{asset "js/faith-received.js"}}"></script>

{{!-- Citation resolver — a reader arriving at search often already
     holds a reference ("PL 176, 17c") rather than a phrase. --}}
<script src="{{asset "js/faith-corpora.js"}}"></script>
<script src="{{asset "js/faith-resolve.js"}}"></script>

<script src="{{asset "js/faith-gate.js"}}"></script>
