{{!< default}}
{{#contentFor "moHead"}}
<title>Search The Faith Received</title>
<meta name="description" content="Search across every creed, confession, catechism, and classic work in The Faith Received." />
<meta property="og:title" content="Search The Faith Received" />
<meta property="og:description" content="Search across every creed, confession, catechism, and classic work in The Faith Received." />
<meta name="twitter:title" content="Search The Faith Received" />
<meta name="twitter:description" content="Search across every creed, confession, catechism, and classic work in The Faith Received." />
{{/contentFor}}
{{!-- /the-faith-received/search/ — full-text search across every
     document, section, Q&A, thesis, and chapter in The Faith Received.
     Index is built at theme-build time (scripts/build-faith-received.mjs)
     and served as a static asset. fuse.js is loaded from a CDN. --}}

<main class="faith-received faith-feature">

  <section class="bhero bhero--tool">
  <div class="bhero-inner container">
    <p class="bhero-kicker">The Faith Received &middot; Search</p>
    <h1>Search</h1>
    <p class="bhero-sub">Search across every creed, confession, catechism, and library work in the reading room. Results link directly to the passage.</p>
  </div>
</section>


  <section class="bband faith-feature-body">
    <div class="container container-narrow" data-faith-search-page>
      <p class="faith-search-status" data-faith-search-status role="status" aria-live="polite"></p>
      <ol class="faith-search-results" data-faith-search-results></ol>

      <div class="faith-search-empty" data-faith-search-empty hidden>
        <p>No results. Try a different phrase, or browse by document.</p>
        <p><a class="btn btn-outline" href="/the-faith-received/">Back to The Faith Received</a></p>
      </div>
    </div>
  </section>


  {{!-- Read is free; Use is for members. Everything that puts a text in
       front of you costs nothing. Everything that makes the corpus
       workable — search it, ask it, index it, annotate it, cite it —
       belongs to membership. --}}
  <section class="bband faith-tools">
    <div class="container">
      <header class="bhead">
        <p class="blabel">Free to read</p>
        <h2>Reading the tradition costs nothing.</h2>
      </header>
      <ul class="blist blist--2 blist--tools">
      <li><span class="brow-t">The text itself</span><span class="brow-m">Every work in the reading room, start to finish.</span></li>
      <li><span class="brow-t">Latin beside English</span><span class="brow-m">The original and the translation in parallel columns.</span></li>
      <li><span class="brow-t">The printed page</span><span class="brow-m">The scanned leaf beside both, where the book was photographed.</span></li>
      <li><span class="brow-t">Search</span><span class="brow-m">Keyword search across every collection at once.</span></li>
      <li><span class="brow-t">The scripture index</span><span class="brow-m">Every father who cites your verse, gathered into one list.</span></li>
      <li><span class="brow-t">The topic index</span><span class="brow-m">What the church has said on a doctrine, across two thousand years.</span></li>
      <li><span class="brow-t">Find in this work</span><span class="brow-m">Every match in the work you are reading, stepped through in order.</span></li>
      <li><span class="brow-t">Contents and filmstrip</span><span class="brow-m">A depth-tiered outline, or thumbnails of the scans.</span></li>
      <li><span class="brow-t">Reading modes</span><span class="brow-m">Read, parallel or study, with the type set to your eyes.</span></li>
      <li><span class="brow-t">Who and what</span><span class="brow-m">The author&rsquo;s life and the work&rsquo;s introduction, before you begin.</span></li>
      <li><span class="brow-t">Modern spelling</span><span class="brow-m">Archaic English rendered readable, at a switch.</span></li>
      <li><span class="brow-t">Continue reading</span><span class="brow-m">The room remembers where you stopped.</span></li>
      </ul>
    </div>
  </section>

  <section class="bband bband--cream faith-tools">
    <div class="container">
      <header class="bhead">
        <p class="blabel">For members</p>
        <h2>Using it is what membership pays for.</h2>
      </header>
      <ul class="blist blist--2 blist--tools">
      <li><span class="brow-t">Ask<span class="lp-members">Members</span></span><span class="brow-m">A question answered from the corpus, with the pages it drew on cited inline.</span></li>
      <li><span class="brow-t">Semantic search<span class="lp-members">Members</span></span><span class="brow-m">Search by meaning rather than by word, across thirty thousand works.</span></li>
      <li><span class="brow-t">Latin word forms<span class="lp-members">Members</span></span><span class="brow-m">One search across every inflection of a word.</span></li>
      <li><span class="brow-t">Constellations<span class="lp-members">Members</span></span><span class="brow-m">The passages that stand behind a passage, shareable as a link.</span></li>
      <li><span class="brow-t">Citation export<span class="lp-members">Members</span></span><span class="brow-m">Copy, permalink, BibTeX or Zotero, each stamped with its locus.</span></li>
      <li><span class="brow-t">The notebook<span class="lp-members">Members</span></span><span class="brow-m">Highlight a paragraph, keep a private note, or write your own translation.</span></li>
      </ul>
    </div>
  </section>

  {{!-- No prices here on purpose: /membership/ is where they live, and a
       number repeated in two places is a number that goes stale in one. --}}
  <section class="bband bband--dark faith-join">
    <div class="container">
      <header class="bhead">
        <p class="blabel">Become a member</p>
        <h2>The reading stays free. The tools are how it gets paid for.</h2>
      </header>
      <div class="faith-join-cards">
        <div class="faith-join-card">
          <h3>Ask the corpus</h3>
          <p>Put a question to thirty thousand works and get an answer that cites the pages it came from.</p>
        </div>
        <div class="faith-join-card">
          <h3>Search by meaning</h3>
          <p>Semantic search across every collection, and one Latin search that finds every inflection of a word.</p>
        </div>
        <div class="faith-join-card">
          <h3>Keep your work</h3>
          <p>Highlight, annotate, write your own translation, and export a citation with its locus already stamped.</p>
        </div>
      </div>
      <p class="faith-join-cta">
        <a class="btn btn-primary btn-lg" href="/membership/">Become a member</a>
      </p>
    </div>
  </section>
</main>

{{!-- SRI on the CDN script: the browser refuses to execute if the
     hash doesn't match, so a jsdelivr compromise can't ship attacker
     JS to /the-faith-received/search/ visitors. Hash regenerated by:
       openssl dgst -sha384 -binary fuse.min.js | openssl base64 -A --}}
<script src="https://cdn.jsdelivr.net/npm/fuse.js@7.0.0/dist/fuse.min.js"
        integrity="sha384-PCSoOZTpbkikBEtd/+uV3WNdc676i9KUf01KOA8CnJotvlx8rRrETbDuwdjqTYvt"
        crossorigin="anonymous"></script>
<script src="{{asset "js/faith-received.js"}}"></script>

{{!-- Citation resolver — a reader arriving at search often already
     holds a reference ("PL 176, 17c") rather than a phrase. --}}
<script src="{{asset "js/faith-corpora.js"}}"></script>
<script src="{{asset "js/faith-resolve.js"}}"></script>

<script src="{{asset "js/faith-gate.js"}}"></script>
