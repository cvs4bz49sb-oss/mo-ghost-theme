{{!< default}}
{{#contentFor "moHead"}}
<title>Daily Devotional | The Faith Received</title>
<meta name="description" content="A daily reading from the catechisms and classic works of the Christian tradition." />
<meta property="og:title" content="Daily Devotional | The Faith Received" />
<meta property="og:description" content="A daily reading from the catechisms and classic works of the Christian tradition." />
<meta name="twitter:title" content="Daily Devotional | The Faith Received" />
<meta name="twitter:description" content="A daily reading from the catechisms and classic works of the Christian tradition." />
{{/contentFor}}
{{!-- /the-faith-received/devotional/ — Devotional plan engine.
     Two states on the same page (no plan: setup view; plan saved:
     today's reading queue). All state in localStorage; no backend.
     Body markup lives in _devotional-body.hbs so the home Devotional
     tab and this routed page render identical content. --}}

<main class="faith-received faith-feature faith-devotional" data-faith-devotional>

  <section class="hero faith-feature-hero">
    <div class="container">
      <p class="hero-kicker"><span class="dot"></span> The Faith Received &middot; Devotional</p>
      <h1 class="hero-headline faith-hero-headline">
        <em>Devotional</em>
      </h1>
      <p class="hero-sub">Pick the creeds, confessions, and classics you want to read. Pair them with the Bible track of your choice. Read at your own pace; we keep your place.</p>
    </div>
  </section>

  {{> "faith-received/_nav"}}

  {{> "faith-received/_devotional-body"}}

</main>

<script src="{{asset "js/faith-modernize.js"}}"></script>
<script src="{{asset "js/faith-received.js"}}"></script>
<script src="{{asset "js/faith-devotional.js"}}"></script>

<script src="{{asset "js/faith-gate.js"}}"></script>
