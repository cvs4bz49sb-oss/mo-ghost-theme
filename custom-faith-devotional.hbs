{{!< default}}
{{!-- The TFR rail, first on the page and pinned under the masthead as on the reader (Ian, 2026-09-23). --}}
{{> "faith-received/_tfr-rail"}}
{{#contentFor "moHead"}}
<title>Daily Devotional | The Faith Received</title>
<meta name="description" content="A daily reading from the catechisms and classic works of the Christian tradition." />
<meta property="og:title" content="Daily Devotional | The Faith Received" />
<meta property="og:description" content="A daily reading from the catechisms and classic works of the Christian tradition." />
<meta name="twitter:title" content="Daily Devotional | The Faith Received" />
<meta name="twitter:description" content="A daily reading from the catechisms and classic works of the Christian tradition." />
<style>
/* The Devotional plan (2026-11-12). The page shipped in May with markup and no styles. Inline here rather than in
   assets/css/ so the TFR path guard allows it. Scoped under main.faith-devotional; tokens from screen.css and
   faith-received.css; hairline borders, no shadows, the body face throughout. */
main.faith-devotional [hidden] { display: none !important; }
main.faith-devotional .faith-devotional-setup .section-intro { margin: 0 0 20px; }
main.faith-devotional .faith-devotional-setup .section-intro + * { margin-bottom: 48px; }
main.faith-devotional :is(a, button, input):focus-visible { outline: 2px solid var(--color-secondary); outline-offset: 2px; }

/* ── Sources: two groups, a grid of tickable rows ── */
main.faith-devotional .faith-devotional-loading { margin: 0; padding: 24px 0; color: var(--color-muted); font-family: var(--font-body); }
main.faith-devotional .faith-devotional-group { margin: 0 0 28px; padding: 0; border: 0; min-width: 0; }
main.faith-devotional .faith-devotional-group-heading {
  margin: 0 0 10px; padding: 0; font: 600 12px/1.4 var(--font-body); letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-muted);
}
main.faith-devotional .faith-devotional-source-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 24px; border-top: 1px solid var(--color-rule); }
main.faith-devotional .faith-devotional-source {
  display: grid; grid-template-columns: auto 1fr auto; align-items: start; gap: 10px; padding: 10px 2px;
  border-bottom: 1px solid var(--color-rule); cursor: pointer; font-family: var(--font-body);
}
main.faith-devotional .faith-devotional-source input { margin: 4px 0 0; accent-color: var(--color-secondary); width: 16px; height: 16px; }
main.faith-devotional .faith-devotional-source-text { display: flex; flex-direction: column; min-width: 0; }
main.faith-devotional .faith-devotional-source-title { font-size: 16px; line-height: 1.35; color: var(--color-dark); }
main.faith-devotional .faith-devotional-source-meta { font-size: 13px; line-height: 1.4; color: var(--color-muted); }
main.faith-devotional .faith-devotional-source-order { min-width: 1.5em; font: 600 13px/1.6 var(--font-body); color: var(--color-secondary); text-align: right; }
main.faith-devotional .faith-devotional-source.is-picked .faith-devotional-source-title { font-weight: 600; }

/* ── Bible tracks: one column of radio rows ── */
main.faith-devotional .faith-devotional-tracks { display: flex; flex-direction: column; border-top: 1px solid var(--color-rule); }
main.faith-devotional .faith-devotional-track {
  display: grid; grid-template-columns: auto 1fr; gap: 2px 10px; padding: 12px 2px; border-bottom: 1px solid var(--color-rule);
  cursor: pointer; font-family: var(--font-body);
}
main.faith-devotional .faith-devotional-track input { grid-row: span 2; margin: 4px 0 0; accent-color: var(--color-secondary); width: 16px; height: 16px; }
main.faith-devotional .faith-devotional-track-label { font-size: 16px; line-height: 1.35; color: var(--color-dark); }
main.faith-devotional .faith-devotional-track-desc { font-size: 14px; line-height: 1.45; color: var(--color-muted); }

/* ── Save ── */
main.faith-devotional .faith-devotional-save { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; margin-top: 8px; }
main.faith-devotional .faith-devotional-save .btn[disabled] { opacity: 0.45; cursor: not-allowed; }
main.faith-devotional .faith-devotional-save-hint { flex-basis: 100%; margin: 0; font: 14px/1.4 var(--font-body); color: var(--color-muted); }

/* ── Today ── */
main.faith-devotional .faith-devotional-today-meta { margin: 0 0 20px; }
main.faith-devotional .faith-devotional-today-meta .eyebrow { margin: 0 0 4px; }
main.faith-devotional .faith-devotional-today-date { margin: 0; font: 20px/1.3 var(--font-body); color: var(--color-dark); }
main.faith-devotional .faith-devotional-done-note {
  margin: 0 0 16px; padding: 12px 16px; border: 1px solid var(--color-card-border); border-radius: 3px;
  font: 15px/1.5 var(--font-body); color: var(--color-dark); background: var(--color-white);
}
main.faith-devotional .faith-devotional-queue-list { list-style: none; margin: 0 0 32px; padding: 0; border-top: 1px solid var(--color-rule); }
main.faith-devotional .faith-devotional-entry { padding: 14px 2px; border-bottom: 1px solid var(--color-rule); font-family: var(--font-body); }
main.faith-devotional .faith-devotional-entry-source { margin: 0 0 2px; font: 600 12px/1.4 var(--font-body); letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-muted); }
main.faith-devotional .faith-devotional-entry-label { margin: 0; font-size: 18px; line-height: 1.45; color: var(--color-dark); }
main.faith-devotional .faith-devotional-entry-link { color: inherit; text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
main.faith-devotional .faith-devotional-entry-link:hover { color: var(--color-secondary); }
main.faith-devotional .faith-devotional-entry-progress { margin: 2px 0 0; font-size: 13px; color: var(--color-muted); }
main.faith-devotional .faith-devotional-entry.is-finished .faith-devotional-entry-label { font-size: 15px; color: var(--color-muted); }

main.faith-devotional .faith-devotional-bible { margin: 0 0 32px; }
main.faith-devotional .faith-devotional-bible-head { margin: 0 0 12px; }
main.faith-devotional .faith-devotional-bible-head .eyebrow { margin: 0 0 4px; }
main.faith-devotional .faith-devotional-bible-title { margin: 0; font: 600 22px/1.3 var(--font-body); color: var(--color-dark); }
main.faith-devotional .faith-devotional-bible-text {
  padding: 24px 28px; border: 1px solid var(--color-card-border); border-radius: 3px; background: var(--color-white);
  font: 17px/1.7 var(--font-body); color: var(--color-dark);
}
main.faith-devotional .faith-devotional-bible-text p { margin: 0 0 12px; }
main.faith-devotional .faith-devotional-bible-text sup { font-size: 0.65em; color: var(--color-muted); }
main.faith-devotional .faith-devotional-bible-credit { margin: 16px 0 0 !important; font-size: 13px; color: var(--color-muted); }
main.faith-devotional .faith-devotional-bible-more { margin: 10px 0 0; font: 15px/1.4 var(--font-body); }
main.faith-devotional .faith-devotional-bible-link { color: var(--color-secondary); text-underline-offset: 3px; }

main.faith-devotional .faith-devotional-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; }
main.faith-devotional .faith-devotional-actions .btn[disabled] { opacity: 0.45; cursor: not-allowed; }
main.faith-devotional .faith-devotional-reset {
  margin-left: auto; padding: 6px 0; border: 0; background: none; cursor: pointer;
  font: 14px/1.4 var(--font-body); color: var(--color-muted); text-decoration: underline; text-underline-offset: 3px;
}
main.faith-devotional .faith-devotional-reset.is-armed { color: var(--color-secondary); font-weight: 600; }

@media (max-width: 720px) {
  main.faith-devotional .faith-devotional-source-list { grid-template-columns: 1fr; }
  main.faith-devotional .faith-devotional-bible-text { padding: 18px 16px; }
  main.faith-devotional .faith-devotional-reset { margin-left: 0; }
}
</style>
{{/contentFor}}
{{!-- /the-faith-received/devotional/ — Devotional plan engine.
     Two states on the same page (no plan: setup view; plan saved:
     today's reading queue). All state in localStorage; no backend.
     Body markup lives in _devotional-body.hbs so the home Devotional
     tab and this routed page render identical content. --}}

<main class="faith-received faith-feature faith-devotional" data-faith-devotional>

  <section class="hero faith-feature-hero">
    <div class="container">
      <p class="hero-kicker"><span class="dot"></span> The Faith Received &middot; Devotional</p>
      <h1 class="hero-headline faith-hero-headline">
        <em>Devotional</em>
      </h1>
      <p class="hero-sub">Pick the creeds, confessions, and classics you want to read. Pair them with the Bible track of your choice. Read at your own pace; we keep your place.</p>
    </div>
  </section>
{{!-- The TFR rail, under the hero as on every other TFR page (Ian,
