{{!< default}}
{{#contentFor "moHead"}}
<title>All Contributors | Mere Orthodoxy</title>
<meta name="description" content="Every writer who has published with Mere Orthodoxy, listed alphabetically." />
<meta property="og:title" content="All Contributors" />
<meta property="og:description" content="Every writer who has published with Mere Orthodoxy, listed alphabetically." />
<meta name="twitter:title" content="All Contributors" />
<meta name="twitter:description" content="Every writer who has published with Mere Orthodoxy, listed alphabetically." />
{{/contentFor}}
{{!-- custom-all-contributors: Full alphabetical directory of every
     Mere Orthodoxy contributor. Linked from the main /contributors/
     page ("+ View All Contributors"). Pulls every public tag whose
     slug starts with "author-". Wired to /contributors/all/ in
     routes.yaml. --}}

<main class="contributors">
  <section class="contributors-hero">
    <div class="container">
      <p class="eyebrow">The Writers</p>
      <h1 class="contributors-title"><em>All Contributors</em></h1>
      <p class="contributors-sub">Everyone who has written for <em>Mere&nbsp;Orthodoxy</em>, in alphabetical order.</p>
    </div>
  </section>

  <section class="contributors-body">
    <div class="container">
      {{!-- Alphabet rail filters cards by last-name initial. JS marks
           letters with no matching contributors as disabled. --}}
      <nav class="contributors-rail" aria-label="Filter contributors by last name" data-contributors-rail>
        <span class="contributors-rail-label">Find by last name</span>
        <div class="contributors-rail-inner" data-contributors-rail-inner>
          <button type="button" class="contributors-rail-pill is-active" data-letter="all">All</button>
          <button type="button" class="contributors-rail-pill" data-letter="A">A</button>
          <button type="button" class="contributors-rail-pill" data-letter="B">B</button>
          <button type="button" class="contributors-rail-pill" data-letter="C">C</button>
          <button type="button" class="contributors-rail-pill" data-letter="D">D</button>
          <button type="button" class="contributors-rail-pill" data-letter="E">E</button>
          <button type="button" class="contributors-rail-pill" data-letter="F">F</button>
          <button type="button" class="contributors-rail-pill" data-letter="G">G</button>
          <button type="button" class="contributors-rail-pill" data-letter="H">H</button>
          <button type="button" class="contributors-rail-pill" data-letter="I">I</button>
          <button type="button" class="contributors-rail-pill" data-letter="J">J</button>
          <button type="button" class="contributors-rail-pill" data-letter="K">K</button>
          <button type="button" class="contributors-rail-pill" data-letter="L">L</button>
          <button type="button" class="contributors-rail-pill" data-letter="M">M</button>
          <button type="button" class="contributors-rail-pill" data-letter="N">N</button>
          <button type="button" class="contributors-rail-pill" data-letter="O">O</button>
          <button type="button" class="contributors-rail-pill" data-letter="P">P</button>
          <button type="button" class="contributors-rail-pill" data-letter="Q">Q</button>
          <button type="button" class="contributors-rail-pill" data-letter="R">R</button>
          <button type="button" class="contributors-rail-pill" data-letter="S">S</button>
          <button type="button" class="contributors-rail-pill" data-letter="T">T</button>
          <button type="button" class="contributors-rail-pill" data-letter="U">U</button>
          <button type="button" class="contributors-rail-pill" data-letter="V">V</button>
          <button type="button" class="contributors-rail-pill" data-letter="W">W</button>
          <button type="button" class="contributors-rail-pill" data-letter="X">X</button>
          <button type="button" class="contributors-rail-pill" data-letter="Y">Y</button>
          <button type="button" class="contributors-rail-pill" data-letter="Z">Z</button>
        </div>
      </nav>

      <div class="contributors-grid" data-contributors-grid data-mode="all">
        {{#get "tags" filter="visibility:public" order="name asc" limit="200" include="count.posts"}}
          {{#foreach tags}}
            {{#if count.posts}}
              <a href="{{url}}" class="contributor-card contributor-card--candidate" data-tag-slug="{{slug}}" data-count="{{count.posts}}">
                <div class="contributor-card-portrait" aria-hidden="true">
                  {{#if feature_image}}
                    <img src="{{img_url feature_image size="s"}}" alt="{{name}}" loading="lazy" width="120" height="120" />
                  {{else}}
                    <span class="contributor-card-initial">{{name}}</span>
                  {{/if}}
                </div>
                <div class="contributor-card-body">
                  <h2 class="contributor-card-name"><em>{{name}}</em></h2>
                  {{#if description}}
                    <p class="contributor-card-bio">{{description}}</p>
                  {{/if}}
                  <p class="contributor-card-count">
                    {{count.posts}}
                    {{#match count.posts "=" 1}}essay{{else}}essays{{/match}}
                  </p>
                </div>
              </a>
            {{/if}}
          {{/foreach}}
        {{/get}}
      </div>

      {{!-- Empty state for letter filters. --}}
      <p class="contributors-empty" data-contributors-empty hidden>
        No contributors with last names starting with <strong data-empty-letter></strong>.
      </p>
    </div>
  </section>
</main>

<script src="{{asset "js/contributors.js"}}"></script>
