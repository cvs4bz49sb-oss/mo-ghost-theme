{{!< default}}
{{!-- /the-faith-received/ — The Faith Received project home.
     Historic creeds, confessions, catechisms, and classics of the
     Christian tradition, presented in MO's editorial vocabulary.
     Per-document subroutes (see routes.yaml) point at
     custom-faith-{slug}.hbs templates which include the matching
     partial in partials/faith-received/. Card grids and the
     wrapper templates are generated by scripts/build-faith-received.mjs;
     run that script after editing JSON sources in data/faith-received/. --}}

<main class="faith-received">

  {{!-- Tab-aware dark hero: each tab brings its own header (kicker +
       title + lede) so the section title sits in the hero band rather
       than below the fold. JS swaps which hero block is visible based
       on the active tab. The shared section nav rail sits below the
       hero so readers can flip tabs without scrolling. --}}
  <section class="hero faith-hero faith-hero--tabbed">
    <div class="container">
      <div class="faith-hero-tab" data-faith-section="documents">
        <p class="hero-kicker"><span class="dot"></span> The Faith Received</p>
        <h1 class="hero-headline faith-hero-headline">
          <em>Documents</em>
        </h1>
        <p class="hero-sub">The standards by which the Church has confessed her faith, set in chronological order &mdash; from the Apostles' Creed in the second century to the Lausanne Covenant in the twentieth.</p>
      </div>
      <div class="faith-hero-tab" data-faith-section="library" hidden>
        <p class="hero-kicker"><span class="dot"></span> The Faith Received</p>
        <h1 class="hero-headline faith-hero-headline">
          <em>The Library</em>
        </h1>
        <p class="hero-sub">Classic works of theology, apology, and devotion, in chronological order &mdash; from Diognetus and Athanasius to Edwards, Calvin, and Leo XIII.</p>
      </div>
      <div class="faith-hero-tab" data-faith-section="traditions" hidden>
        <p class="hero-kicker"><span class="dot"></span> The Faith Received</p>
        <h1 class="hero-headline faith-hero-headline">
          <em>Traditions</em>
        </h1>
        <p class="hero-sub">Every document and library work, sorted by the Christian tradition it belongs to &mdash; from the Patristic Church through the Reformation to the modern evangelical movement.</p>
      </div>
    </div>
  </section>

  {{> "faith-received/_nav"}}

  {{!-- Body: just the cards grid for the active tab. The title + lede
       moved into the dark hero above; the body section no longer
       carries its own section-intro. --}}
  <div class="faith-section-tabs" data-faith-section-tabs>
    <section class="faith-section-band faith-band-documents" data-faith-section="documents">
      <div class="container">
        {{> "faith-received/_cards-documents"}}
      </div>
    </section>

    <section class="faith-section-band faith-band-library" data-faith-section="library" hidden>
      <div class="container">
        {{> "faith-received/_cards-library"}}
      </div>
    </section>

    <section class="faith-section-band faith-band-traditions" data-faith-section="traditions" hidden>
      {{> "faith-received/_cards-traditions"}}
    </section>
  </div>

  {{!-- Devotional / Topics / Scripture / Today / Search — call-to-action
       rail. Each is its own routed feature page. --}}
  <section class="faith-section-band faith-band-tools">
    <div class="container">
      <div class="section-intro">
        <p class="eyebrow">For Daily Use</p>
        <h2 class="section-heading"><em>Read with the Church.</em></h2>
      </div>
      <ol class="faith-tools-grid">
        <li class="faith-tool">
          <span class="faith-tool-numeral">I</span>
          <h3 class="faith-tool-title"><em>A daily reading plan</em></h3>
          <p class="faith-tool-body">Build a custom plan from any of the works in the library, paired with the Bible track of your choice.</p>
          <a href="/the-faith-received/devotional/" class="faith-tool-link">Build a plan <span aria-hidden="true">&rarr;</span></a>
        </li>
        <li class="faith-tool">
          <span class="faith-tool-numeral">II</span>
          <h3 class="faith-tool-title"><em>Today's reading</em></h3>
          <p class="faith-tool-body">A daily passage drawn from across the historic Christian texts. New each morning.</p>
          <a href="/the-faith-received/today/" class="faith-tool-link">Read today <span aria-hidden="true">&rarr;</span></a>
        </li>
        <li class="faith-tool">
          <span class="faith-tool-numeral">III</span>
          <h3 class="faith-tool-title"><em>By topic</em></h3>
          <p class="faith-tool-body">The great themes of the Christian faith &mdash; God, Trinity, salvation, sacraments, the last things &mdash; cross-referenced across the library.</p>
          <a href="/the-faith-received/topics/" class="faith-tool-link">Browse topics <span aria-hidden="true">&rarr;</span></a>
        </li>
        <li class="faith-tool">
          <span class="faith-tool-numeral">IV</span>
          <h3 class="faith-tool-title"><em>By Scripture</em></h3>
          <p class="faith-tool-body">Find every place a passage of the Bible is cited or expounded across the historic texts.</p>
          <a href="/the-faith-received/scripture/" class="faith-tool-link">Open Scripture index <span aria-hidden="true">&rarr;</span></a>
        </li>
        <li class="faith-tool">
          <span class="faith-tool-numeral">V</span>
          <h3 class="faith-tool-title"><em>Memorize the catechisms</em></h3>
          <p class="faith-tool-body">One question at a time, with the answer hidden until you're ready. Heidelberg, Westminster Shorter, and Westminster Larger.</p>
          <a href="/the-faith-received/heidelberg/memorize/" class="faith-tool-link">Begin memorizing <span aria-hidden="true">&rarr;</span></a>
        </li>
      </ol>
    </div>
  </section>

  {{!-- Editorial closing band — frames the project's place in MO. --}}
  <section class="journal-band faith-coda">
    <div class="container">
      <div class="faith-coda-inner">
        <p class="eyebrow eyebrow-light">A Mere Orthodoxy Project</p>
        <h2 class="faith-coda-heading">
          <em>The Christian tradition is the Christian's inheritance.</em>
        </h2>
        <p class="faith-coda-body">
          The Faith Received gathers the creeds, confessions, and classic works of the Christian tradition into a single reading room &mdash; typeset for the web the way they were typeset for the press, free for any reader to study.
        </p>
        <div class="faith-coda-ctas">
          <a href="#documents" class="btn btn-primary btn-lg">Begin reading</a>
          <a href="/membership/" class="btn btn-ghost btn-lg">Support the work</a>
        </div>
      </div>
    </div>
  </section>

</main>

<script src="{{asset "js/faith-received.js"}}"></script>
<script>
// Section-tab swap. The section nav rail toggles between the
// Documents and Library views inline — no navigation, no scroll.
// Hash (#documents / #library) drives the active tab so deep-links
// from other Faith Received pages land on the right view. Default
// when no hash: Documents.
(function () {
  var sections = document.querySelectorAll("[data-faith-section]");
  var navLinks = document.querySelectorAll(".faith-section-nav-link[data-faith-tab-target]");
  if (!sections.length) return;

  function show(name) {
    Array.prototype.forEach.call(sections, function (s) {
      var match = s.getAttribute("data-faith-section") === name;
      if (match) s.removeAttribute("hidden");
      else s.setAttribute("hidden", "");
    });
    Array.prototype.forEach.call(navLinks, function (a) {
      var match = a.getAttribute("data-faith-tab-target") === name;
      a.classList.toggle("is-active", match);
      if (match) a.setAttribute("aria-current", "page");
      else a.removeAttribute("aria-current");
    });
  }

  function fromHash() {
    var h = (window.location.hash || "").replace(/^#/, "");
    if (h === "library") return "library";
    if (h === "traditions") return "traditions";
    return "documents";
  }

  Array.prototype.forEach.call(navLinks, function (a) {
    a.addEventListener("click", function (e) {
      var target = a.getAttribute("data-faith-tab-target");
      if (!target) return;
      // Same-page hash change: prevent default scroll behavior, just
      // update the URL and swap the tab. The browser's hashchange
      // event will fire and we re-run show() from there.
      e.preventDefault();
      if (window.location.hash !== "#" + target) {
        history.pushState(null, "", "#" + target);
      }
      show(target);
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
  });

  window.addEventListener("hashchange", function () { show(fromHash()); });
  show(fromHash());
})();
</script>
