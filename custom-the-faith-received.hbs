<main class="faith-received faith-landing">
<!-- ── Hero ─────────────────────────────────────────────────────── -->
<section class="lp-hero">
  <div class="container">
    <p class="hero-kicker"><span class="dot"></span> The Faith Received <span class="faith-beta">Beta</span></p>
    {{!-- The space after the <br /> is load-bearing: the break is
          display:none below 700px, and without a space beside it the
          two text nodes ran together as "isthe". --}}
    <h1>The Christian tradition is<br /> the <em>Christian&rsquo;s inheritance.</em></h1>
    <p class="lp-hero-sub">The Faith Received gathers the creeds, confessions, and classic works of the Christian tradition into a single library, designed to be publicly available, practically usable, and beautifully readable.</p>
    {{!-- The library's search, in the hero (owner 2026-09-10 "make the landing page look like what you had"):
          a plain GET to the library page, which reads q and find from the address. --}}
    <form class="lp-search" action="/the-faith-received/library/" method="get" role="search" aria-label="Search the library" onsubmit="if(this.find.value==='ask'){this.action='/the-faith-received/ask/';}">
      <div class="lp-modes" role="group" aria-label="Search type">
        <label><input type="radio" name="find" value="works" checked> Works &amp; authors</label>
        <label><input type="radio" name="find" value="passages"> Passages</label>
        <label><input type="radio" name="find" value="ask"> Ask the library</label>
      </div>
      <div class="lp-query"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4.5 4.5"/></svg><input name="q" type="search" placeholder="Search works or authors" aria-label="Search works and authors" autocomplete="off"><button type="submit">Search</button></div>
      <p class="lp-search-help">Find an author, a title, or a volume such as PL 32, PG 64, or PO 2.</p>
    </form>
    <div class="lp-ctas">
      <a href="/the-faith-received/library/" class="btn btn-primary btn-lg">Begin reading</a>
      <a href="#become-a-member" class="btn btn-ghost btn-lg">Support the work</a>
    </div>
  </div>
</section>


<!-- ── I. Three doors ────────────────────────────────────────────── -->
<style>
  /* the hero's library search (2026-09-10) */
  .lp-search{max-width:820px;margin:0 auto 30px;text-align:left}
