{{!< default}}
{{!-- /the-faith-received/ — Theological research assistant.
     Frontend talks to the mo-faith-received Cloudflare Worker
     (Internet Archive search + Anthropic synthesis). Page is
     fully public; there is no gate, no member check, no preview
     mode. Editorial-charm aesthetic: dark hero, italic display
     headline, eyebrows, hairlines, brand-orange accents, no card
     chrome on the answer rows. --}}

<main class="faith-received">

  <section class="hero faith-hero">
    <div class="container">
      <p class="hero-kicker"><span class="dot"></span> The Faith Received</p>
      <h1 class="hero-headline">
        The riches of <span class="highlight"><em>the Christian tradition</em></span>, available at a question.
      </h1>
      <p class="hero-sub">
        A theological research assistant. Ask anything about church history, doctrine, or the great Christian thinkers, and read what they actually wrote. Every answer is grounded in primary sources from the Internet Archive and synthesized into a scholarly response.
      </p>
    </div>
  </section>

  <section class="faith-ask">
    <div class="container container-narrow">
      <form class="faith-ask-form" data-faith-form autocomplete="off" novalidate>
        <p class="eyebrow">Ask a question</p>
        <div class="faith-ask-row">
          <label class="faith-ask-label" for="faith-question">Your question</label>
          <input
            type="text"
            id="faith-question"
            name="question"
            data-faith-input
            placeholder="What did Augustine teach about original sin?"
            required
          />
          <button type="submit" class="btn btn-primary faith-ask-submit" data-faith-submit>
            <span data-faith-submit-label>Ask</span>
          </button>
        </div>
        <p class="faith-ask-hint" data-faith-status></p>
      </form>

      <div class="faith-examples">
        <p class="eyebrow">Try one of these</p>
        <ol class="faith-example-list">
          <li>
            <button type="button" class="faith-example" data-faith-example>
              <span class="faith-example-numeral">I</span>
              <span class="faith-example-text">What did Augustine teach about original sin?</span>
            </button>
          </li>
          <li>
            <button type="button" class="faith-example" data-faith-example>
              <span class="faith-example-numeral">II</span>
              <span class="faith-example-text">Compare Calvin and Luther on predestination.</span>
            </button>
          </li>
          <li>
            <button type="button" class="faith-example" data-faith-example>
              <span class="faith-example-numeral">III</span>
              <span class="faith-example-text">What does the Didache say about baptism?</span>
            </button>
          </li>
          <li>
            <button type="button" class="faith-example" data-faith-example>
              <span class="faith-example-numeral">IV</span>
              <span class="faith-example-text">How did Athanasius defend Christ's divinity?</span>
            </button>
          </li>
          <li>
            <button type="button" class="faith-example" data-faith-example>
              <span class="faith-example-numeral">V</span>
              <span class="faith-example-text">What did Edwards teach about religious affections?</span>
            </button>
          </li>
          <li>
            <button type="button" class="faith-example" data-faith-example>
              <span class="faith-example-numeral">VI</span>
              <span class="faith-example-text">How did Aquinas reason about the existence of God?</span>
            </button>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <section class="faith-answers" data-faith-answers hidden>
    <div class="container">
      <div class="flourish">{{> "flourish-mark"}}</div>
      <div data-faith-answers-list></div>
    </div>
  </section>

  {{!-- Hidden template cloned by faith-received.js for each
       answer rendered. Editorial split: prose left, sources
       right on desktop; stacked on mobile. --}}
  <template data-faith-answer-template>
    <article class="faith-answer">
      <header class="faith-answer-header">
        <p class="eyebrow">Question</p>
        <h2 class="faith-answer-question" data-faith-answer-question></h2>
      </header>
      <div class="faith-answer-grid">
        <div class="faith-answer-body">
          <p class="eyebrow">Response</p>
          <div class="faith-answer-prose" data-faith-answer-prose></div>
        </div>
        <aside class="faith-answer-sources">
          <p class="eyebrow">Sources</p>
          <ol class="faith-source-list" data-faith-answer-sources></ol>
        </aside>
      </div>
    </article>
  </template>

</main>

<script src="{{asset "js/faith-received.js"}}"></script>
