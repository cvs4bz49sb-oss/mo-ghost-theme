{{!< default}}
{{!-- /the-faith-received/ — The Faith Received project home.
     Historic creeds, confessions, catechisms, and classics of the
     Christian tradition, presented in MO's editorial vocabulary.
     Per-document subroutes (see routes.yaml) point at
     custom-faith-{slug}.hbs templates which include the matching
     partial in partials/faith-received/. Card grids and the
     wrapper templates are generated by scripts/build-faith-received.mjs;
     run that script after editing JSON sources in data/faith-received/. --}}

<main class="faith-received">

  {{!-- Editorial header: frames the project's place in MO. The tab
       labels and per-section ledes live below in the section nav rail
       so the hero stays static and confident across tab swaps. --}}
  <section class="hero faith-hero faith-hero--coda">
    <div class="container">
      <div class="faith-coda-inner">
        <p class="hero-kicker"><span class="dot"></span> The Faith Received</p>
        <h1 class="faith-coda-heading">
          <em>The Christian tradition is the Christian's inheritance.</em>
        </h1>
        <p class="faith-coda-body">
          The Faith Received gathers the creeds, confessions, and classic works of the Christian tradition into a single reading room &mdash; designed to be publicly available, practically usable, and beautifully readable.
        </p>
        <div class="faith-coda-ctas">
          <a href="#documents" class="btn btn-primary btn-lg">Begin reading</a>
          <a href="/membership/" class="btn btn-ghost btn-lg">Support the work</a>
        </div>
      </div>
    </div>
  </section>

  {{> "faith-received/_nav"}}

  {{!-- Body: just the cards grid for the active tab. Section labels
       come from the nav rail above; no per-section intro band. --}}
  <div class="faith-section-tabs" data-faith-section-tabs>
    <section class="faith-section-band faith-band-documents" data-faith-section="documents">
      <div class="container">
        {{> "faith-received/_cards-documents"}}
      </div>
    </section>

    <section class="faith-section-band faith-band-library" data-faith-section="library" hidden>
      <div class="container">
        {{> "faith-received/_cards-library"}}

        <div class="faith-latin-library" data-fr-library>
          <h2 class="faith-latin-library-heading">Latin Library</h2>
          <p class="faith-latin-library-dek">503 works of early modern Latin theology, with English translation and parallel text.</p>

          <div class="faith-latin-library-filters" data-fr-filters>
            <button type="button" class="faith-lang-btn" data-fr-filter="all" aria-pressed="true">All</button>
          </div>

          <div class="faith-card-grid" data-fr-library-grid>
            <p class="faith-latin-library-loading">Loading works&hellip;</p>
          </div>
        </div>
      </div>
    </section>

    <section class="faith-section-band faith-band-traditions" data-faith-section="traditions" hidden>
      {{> "faith-received/_cards-traditions"}}
    </section>

    {{!-- Topics, Scripture, Today, Devotional — feature tabs that
         used to live at /the-faith-received/topics/ etc. Each renders
         the same body partial that the standalone routed page does so
         a deep link continues to work but the home tab is now the
         primary entry point. --}}
    <section class="faith-section-band faith-band-topics" data-faith-section="topics" hidden>
      <div class="container">
        {{> "faith-received/_topics-body"}}
      </div>
    </section>

    <section class="faith-section-band faith-band-scripture" data-faith-section="scripture" hidden>
      <div class="container">
        {{> "faith-received/_scripture-body"}}
      </div>
    </section>

    <section class="faith-section-band faith-band-today" data-faith-section="today" hidden>
      <div class="container container-narrow">
        {{> "faith-received/_today-body"}}
      </div>
    </section>

    <section class="faith-section-band faith-band-devotional faith-devotional" data-faith-section="devotional" data-faith-devotional hidden>
      {{> "faith-received/_devotional-body"}}
    </section>
  </div>

</main>

<style>
.faith-latin-library { margin-top: 3rem; padding-top: 3rem; border-top: 1px solid var(--color-border); }
.faith-latin-library-heading { font: 600 1.4rem/1.2 var(--font-serif); margin: 0 0 0.5rem; }
.faith-latin-library-dek { font: 400 0.9rem/1.5 -apple-system, BlinkMacSystemFont, sans-serif; color: var(--color-secondary); margin: 0 0 1.5rem; }
.faith-latin-library-filters { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 1.5rem; }
.faith-latin-library-loading { font: 400 0.85rem/1.5 -apple-system, BlinkMacSystemFont, sans-serif; color: var(--color-secondary); }
</style>

<meta name="tfr-library-base" content="https://mo-tfr-library.mo-podcast-feed.workers.dev" />
<script src="{{asset "js/faith-modernize.js"}}"></script>
<script src="{{asset "js/faith-received.js"}}"></script>
<script src="{{asset "js/faith-devotional.js"}}"></script>
<script src="{{asset "js/faith-library-browse.js"}}"></script>
<script src="{{asset "js/page/faith-received-tabs.js"}}"></script>

<script src="{{asset "js/faith-gate.js"}}"></script>
