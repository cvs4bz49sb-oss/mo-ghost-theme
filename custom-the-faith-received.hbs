{{!< default}}
{{!-- /the-faith-received/ — The Faith Received project home.
     Historic creeds, confessions, catechisms, and classics of the
     Christian tradition, presented in MO's editorial vocabulary.
     Per-document subroutes (see routes.yaml) point at
     custom-faith-{slug}.hbs templates which include the matching
     partial in partials/faith-received/. Card grids and the
     wrapper templates are generated by scripts/build-faith-received.mjs;
     run that script after editing JSON sources in data/faith-received/. --}}

<main class="faith-received">

  {{!-- Editorial header: frames the project's place in MO. The tab
       labels and per-section ledes live below in the section nav rail
       so the hero stays static and confident across tab swaps. --}}
  <section class="hero faith-hero faith-hero--coda">
    <div class="container">
      <div class="faith-coda-inner">
        <p class="eyebrow eyebrow-light">A Mere Orthodoxy Project</p>
        <h1 class="faith-coda-heading">
          <em>The Christian tradition is the Christian's inheritance.</em>
        </h1>
        <p class="faith-coda-body">
          The Faith Received gathers the creeds, confessions, and classic works of the Christian tradition into a single reading room &mdash; designed to be publicly available, practically usable, and beautifully readable.
        </p>
        <div class="faith-coda-ctas">
          <a href="#documents" class="btn btn-primary btn-lg">Begin reading</a>
          <a href="/membership/" class="btn btn-ghost btn-lg">Support the work</a>
        </div>
      </div>
    </div>
  </section>

  {{> "faith-received/_nav"}}

  {{!-- Body: just the cards grid for the active tab. Section labels
       come from the nav rail above; no per-section intro band. --}}
  <div class="faith-section-tabs" data-faith-section-tabs>
    <section class="faith-section-band faith-band-documents" data-faith-section="documents">
      <div class="container">
        {{> "faith-received/_cards-documents"}}
      </div>
    </section>

    <section class="faith-section-band faith-band-library" data-faith-section="library" hidden>
      <div class="container">
        {{> "faith-received/_cards-library"}}
      </div>
    </section>

    <section class="faith-section-band faith-band-traditions" data-faith-section="traditions" hidden>
      {{> "faith-received/_cards-traditions"}}
    </section>

    {{!-- Topics, Scripture, Today, Devotional — feature tabs that
         used to live at /the-faith-received/topics/ etc. Each renders
         the same body partial that the standalone routed page does so
         a deep link continues to work but the home tab is now the
         primary entry point. --}}
    <section class="faith-section-band faith-band-topics" data-faith-section="topics" hidden>
      <div class="container">
        {{> "faith-received/_topics-body"}}
      </div>
    </section>

    <section class="faith-section-band faith-band-scripture" data-faith-section="scripture" hidden>
      <div class="container">
        {{> "faith-received/_scripture-body"}}
      </div>
    </section>

    <section class="faith-section-band faith-band-today" data-faith-section="today" hidden>
      <div class="container container-narrow">
        {{> "faith-received/_today-body"}}
      </div>
    </section>

    <section class="faith-section-band faith-band-devotional faith-devotional" data-faith-section="devotional" data-faith-devotional hidden>
      {{> "faith-received/_devotional-body"}}
    </section>
  </div>

</main>

<script src="{{asset "js/faith-modernize.js"}}"></script>
<script src="{{asset "js/faith-received.js"}}"></script>
<script src="{{asset "js/faith-devotional.js"}}"></script>
<script>
// Section-tab swap. The section nav rail toggles between the
// Documents and Library views inline — no navigation, no scroll.
// Hash (#documents / #library) drives the active tab so deep-links
// from other Faith Received pages land on the right view. Default
// when no hash: Documents.
(function () {
  var sections = document.querySelectorAll("[data-faith-section]");
  var navLinks = document.querySelectorAll(".faith-section-nav-link[data-faith-tab-target]");
  if (!sections.length) return;

  function show(name) {
    Array.prototype.forEach.call(sections, function (s) {
      var match = s.getAttribute("data-faith-section") === name;
      if (match) s.removeAttribute("hidden");
      else s.setAttribute("hidden", "");
    });
    Array.prototype.forEach.call(navLinks, function (a) {
      var match = a.getAttribute("data-faith-tab-target") === name;
      a.classList.toggle("is-active", match);
      if (match) a.setAttribute("aria-current", "page");
      else a.removeAttribute("aria-current");
    });
  }

  function fromHash() {
    var h = (window.location.hash || "").replace(/^#/, "");
    var valid = ["documents", "library", "traditions", "topics", "scripture", "today", "devotional"];
    return valid.indexOf(h) >= 0 ? h : "documents";
  }

  Array.prototype.forEach.call(navLinks, function (a) {
    a.addEventListener("click", function (e) {
      var target = a.getAttribute("data-faith-tab-target");
      if (!target) return;
      // Same-page hash change: prevent default scroll behavior, just
      // update the URL and swap the tab. The browser's hashchange
      // event will fire and we re-run show() from there.
      e.preventDefault();
      if (window.location.hash !== "#" + target) {
        history.pushState(null, "", "#" + target);
      }
      show(target);
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
  });

  window.addEventListener("hashchange", function () { show(fromHash()); });
  show(fromHash());
})();

// Traditions sub-tabs. Inside the Traditions section (Patristic /
// Catholic / Lutheran / Anglican / Reformed / Baptist / Evangelical),
// only one tradition's band is visible at a time. Click a tab to swap.
// State is in-page only — no URL hash, so the top-level #traditions
// hash drives the outer tab and the sub-tab state resets to the first
// tradition on each visit.
(function () {
  var subNav = document.querySelector("[data-faith-tradition-tabs]");
  if (!subNav) return;
  var tabs = subNav.querySelectorAll("[data-faith-tradition-target]");
  var bands = document.querySelectorAll("[data-faith-tradition]");
  if (!tabs.length || !bands.length) return;

  function show(slug) {
    Array.prototype.forEach.call(bands, function (b) {
      var match = b.getAttribute("data-faith-tradition") === slug;
      if (match) b.removeAttribute("hidden");
      else b.setAttribute("hidden", "");
    });
    Array.prototype.forEach.call(tabs, function (t) {
      var match = t.getAttribute("data-faith-tradition-target") === slug;
      t.classList.toggle("is-active", match);
      t.setAttribute("aria-pressed", match ? "true" : "false");
    });
  }

  Array.prototype.forEach.call(tabs, function (t) {
    t.addEventListener("click", function (e) {
      e.preventDefault();
      var slug = t.getAttribute("data-faith-tradition-target");
      if (slug) show(slug);
    });
  });
})();
</script>
