  .lp-modes input{position:absolute;opacity:0;width:0;height:0}
  .lp-query{display:flex;align-items:center;gap:10px;background:#fff;border:1px solid #ffffff66;border-radius:12px;padding:6px 6px 6px 16px;box-shadow:0 18px 50px -24px rgba(0,0,0,.6);color:#1c1c1a}
  .lp-query svg{flex:none;color:#6b675f}
  .lp-query input{flex:1;min-width:0;border:0;background:transparent;font:20px/1.4 var(--font-body);color:#1c1c1a;padding:10px 2px;outline:none}
