{{!< default}}
{{#contentFor "moHead"}}
<title>The Daily Liturgy Reader | Mere Orthodoxy</title>
<meta name="description" content="Read today's Daily Liturgy: a Scripture meditation with opening prayer, confession, and reading, plus the full archive of past days." />
<meta property="og:title" content="The Daily Liturgy Reader" />
<meta property="og:description" content="Read today's Daily Liturgy: a Scripture meditation with opening prayer, confession, and reading, plus the full archive of past days." />
<meta name="twitter:title" content="The Daily Liturgy Reader" />
<meta name="twitter:description" content="Read today's Daily Liturgy: a Scripture meditation with opening prayer, confession, and reading, plus the full archive of past days." />
{{/contentFor}}
{{!-- /daily-liturgy/read/ — routed via routes.yaml with
     `data: page.daily-liturgy-reader`. Displays one devotional per
     day from the Daily Liturgy, with backward navigation to catch up.
     Gated to subscribers/members. Paid members get translation switching. --}}

{{#if @member}}
<main class="dlr-page" data-dlr-page>
  <meta name="mo-bible-base" content="{{@custom.bible_worker_url}}" />

  {{!-- Header --}}
  <header class="dlr-header">
    <img src="{{asset "images/daily-liturgy-logo.png"}}" alt="The Daily Liturgy" class="dlr-header-logo" />
    <h1 class="dlr-title" data-dlr-title>Loading&hellip;</h1>
    <p class="dlr-season" data-dlr-season></p>
    <button class="dlr-theme-toggle dlr-header-theme" type="button" data-dark-mode-toggle aria-label="Toggle dark mode" aria-pressed="false">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
      </svg>
    </button>
  </header>

  {{!-- Navigation --}}
  <nav class="dlr-nav" data-dlr-nav>
    <button class="dlr-nav-btn" data-dlr-prev aria-label="Previous day">&larr;</button>
    <button class="dlr-nav-today" data-dlr-today>Today</button>
    <button class="dlr-nav-btn" data-dlr-next aria-label="Next day" disabled>&rarr;</button>
  </nav>

  {{!-- Catch-up notice --}}
  <p class="dlr-catchup" data-dlr-catchup hidden>You're viewing a past devotional.</p>

  {{!-- Podcast episode for the day being read --}}
  {{!-- .dlr-podcast carries the glow; .dlr-podcast-glass is the frosted
        pane over it. backdrop-filter only samples what is painted behind
        the element, so the glow has to live on an ancestor. --}}
  <div class="dlr-podcast" data-dlr-podcast hidden>
    <div class="dlr-podcast-glass">
    <div class="dlr-podcast-head">
      <p class="dlr-label">Listen</p>
      <p class="dlr-player-note" data-dlr-player-note>Follows the Devotional Plan</p>
    </div>
    <p class="dlr-player-title" data-dlr-player-title></p>

    <div class="dlr-player-progress" data-dlr-progress role="slider" tabindex="0"
         aria-label="Seek" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"
         aria-valuetext="0 seconds">
      <div class="dlr-player-bar" data-dlr-bar>
        <span class="dlr-player-thumb" aria-hidden="true"></span>
      </div>
    </div>
    <div class="dlr-player-times">
      <span data-dlr-elapsed>0:00</span>
      <span data-dlr-time></span>
    </div>

    <div class="dlr-player-transport">
      <button class="dlr-skip-btn" type="button" data-dlr-back aria-label="Back 15 seconds">
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" fill="none"
             stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 5V2L7 6l5 4V7a7 7 0 1 1-7 7"/>
        </svg>
        <span class="dlr-skip-num">15</span>
      </button>
      <button class="dlr-play-btn" type="button" data-dlr-play aria-label="Play episode">
        <svg class="dlr-play-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <polygon points="7,4 20,12 7,20" fill="currentColor"/>
        </svg>
        <svg class="dlr-pause-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" hidden>
          <rect x="6" y="4" width="4" height="16" fill="currentColor"/>
          <rect x="14" y="4" width="4" height="16" fill="currentColor"/>
        </svg>
      </button>
      <button class="dlr-skip-btn" type="button" data-dlr-forward aria-label="Forward 15 seconds">
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" fill="none"
             stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 5V2l5 4-5 4V7a7 7 0 1 0 7 7"/>
        </svg>
        <span class="dlr-skip-num">15</span>
      </button>
    </div>
    </div>

    <audio data-dlr-audio preload="metadata"></audio>
  </div>

  {{!-- Collapsible options --}}
  <details class="dlr-options" data-dlr-options>
    <summary class="dlr-options-toggle">Options</summary>
    <div class="dlr-options-body">
      <div class="dlr-mode-row" data-dlr-mode-toggle>
        <button class="dlr-mode-btn is-active" data-dlr-mode="devotional">Devotional</button>
        <button class="dlr-mode-btn" data-dlr-mode="bi2y">Bible in 2 Years</button>
      </div>
      <div class="dlr-settings-bar">
        <div class="dlr-scripture-toggle" data-dlr-scripture-toggle>
          <button class="dlr-scripture-toggle-btn is-active" data-dlr-expand="expand">Expand Scripture</button>
          <button class="dlr-scripture-toggle-btn" data-dlr-expand="collapse">Collapse</button>
        </div>
        {{#if @member.paid}}
        <select class="dlr-setting-select" id="dlr-translation-select" data-dlr-translation-select aria-label="Translation">
          <option value="ESV">ESV</option>
          <option value="CSB">CSB</option>
          <option value="NIV">NIV</option>
          <option value="NASB">NASB</option>
          <option value="KJV">KJV</option>
        </select>
        {{/if}}
      </div>
    </div>
  </details>

  {{!-- Devotional body --}}
  <article class="dlr-body" data-dlr-body>

    {{!-- Opening Prayer --}}
    <section class="dlr-section">
      <p class="dlr-label">Opening Prayer</p>
      <div class="dlr-prayer-lines" data-dlr-opening-prayer></div>
    </section>

    <hr class="dlr-rule" />

    {{!-- Confession --}}
    <section class="dlr-section">
      <p class="dlr-transition">A Prayer of Confession</p>
      <p class="dlr-label">Confession of Sin &amp; Prayer for Grace</p>
      <div class="dlr-prayer-text" data-dlr-confession></div>
    </section>

    <hr class="dlr-rule" />

    {{!-- OT Reading --}}
    <section class="dlr-section">
      <p class="dlr-transition">The word of the Lord, from the Old Testament</p>
      <p class="dlr-label">Old Testament Reading</p>
      <div class="dlr-scripture" data-dlr-ot-reading>
        <button class="dlr-scripture-ref" data-dlr-ot-ref aria-expanded="true"></button>
        <div class="dlr-scripture-text" data-dlr-ot-text>Loading Scripture&hellip;</div>
      </div>
    </section>

    <hr class="dlr-rule" />

    {{!-- Lord's Prayer --}}
    <section class="dlr-section">
      <p class="dlr-transition">And now we pray</p>
      <p class="dlr-label">The Lord's Prayer</p>
      <div class="dlr-prayer-lines">
        <span class="dlr-line">Our Father who art in heaven,</span>
        <span class="dlr-line">Hallowed be thy Name.</span>
        <span class="dlr-line">Thy kingdom come.</span>
        <span class="dlr-line">Thy will be done,</span>
        <span class="dlr-line">On earth as it is in heaven.</span>
        <span class="dlr-line">Give us this day our daily bread.</span>
        <span class="dlr-line">And forgive us our debts, as we forgive our debtors.</span>
        <span class="dlr-line">And lead us not into temptation,</span>
        <span class="dlr-line">But deliver us from evil.</span>
        <span class="dlr-line">For thine is the kingdom,</span>
        <span class="dlr-line">and the power, and the glory,</span>
        <span class="dlr-line">for ever.</span>
        <span class="dlr-line">Amen.</span>
      </div>
    </section>

    <hr class="dlr-rule" />

    {{!-- NT Reading --}}
    <section class="dlr-section">
      <p class="dlr-transition">The word of the Lord, from the New Testament</p>
      <p class="dlr-label">New Testament Reading</p>
      <div class="dlr-scripture" data-dlr-nt-reading>
        <button class="dlr-scripture-ref" data-dlr-nt-ref aria-expanded="true"></button>
        <div class="dlr-scripture-text" data-dlr-nt-text>Loading Scripture&hellip;</div>
      </div>
    </section>

    <hr class="dlr-rule" />

    {{!-- Prayer of Adoration --}}
    <section class="dlr-section">
      <p class="dlr-label">Prayer of Adoration</p>
      <div class="dlr-prayer-text" data-dlr-adoration></div>
    </section>

    <hr class="dlr-rule" />

    {{!-- Psalm Reading --}}
    <section class="dlr-section">
      <p class="dlr-transition">The word of the Lord, from the Psalms</p>
      <p class="dlr-label">Psalm Reading</p>
      <div class="dlr-scripture" data-dlr-psalm-reading>
        <button class="dlr-scripture-ref" data-dlr-psalm-ref aria-expanded="true"></button>
        <div class="dlr-scripture-text" data-dlr-psalm-text>Loading Scripture&hellip;</div>
      </div>
    </section>

    <hr class="dlr-rule" />

    {{!-- Prayer of Consecration --}}
    <section class="dlr-section">
      <p class="dlr-label">Prayer of Consecration</p>
      <div class="dlr-prayer-text" data-dlr-consecration></div>
    </section>

    <hr class="dlr-rule" />

    {{!-- Benediction --}}
    <section class="dlr-section dlr-section--benediction">
      <p class="dlr-ornament" aria-hidden="true">&#10013;&#xFE0E;</p>
      <p class="dlr-label dlr-label--center">Benediction</p>
      <div class="dlr-prayer-text dlr-prayer-text--benediction" data-dlr-benediction></div>
    </section>

  </article>

  {{!-- Footer --}}
  <footer class="dlr-footer">
    <p class="dlr-closing" data-dlr-closing>We'll see you again tomorrow for another Daily Liturgy.</p>
    <img src="https://storage.ghost.io/c/7b/0b/7b0bd699-d78f-4472-8d29-233bd333f048/content/images/2026/07/Mere-Orthodoxy---Coram-Deo.png" alt="Produced by Mere Orthodoxy and Coram Deo Church" class="dlr-partnership-logo" width="260" />
    <p class="dlr-footer-links">
      <a href="/daily-liturgy/">Subscribe</a>
      <span>&middot;</span>
      <a href="/">Mere Orthodoxy</a>
    </p>
  </footer>

  {{!-- Loading / error states --}}
  <div class="dlr-loading" data-dlr-loading hidden>
    <p>Loading today's devotional&hellip;</p>
  </div>
  <div class="dlr-error" data-dlr-error hidden>
    <p data-dlr-error-msg>Something went wrong loading today's devotional.</p>
    <button class="dlr-retry-btn" data-dlr-retry>Try again</button>
  </div>

  {{!-- No-content state (Sunday or outside liturgical year) --}}
  <div class="dlr-empty" data-dlr-empty hidden>
    <p class="dlr-empty-msg">Today is the Lord's Day. Rest, worship, and we'll see you tomorrow.</p>
    <a href="/daily-liturgy/" class="dlr-empty-link">Back to the Daily Liturgy</a>
  </div>

</main>

<script src="{{asset "js/daily-liturgy-reader.js"}}"></script>

{{else}}
{{!-- Not signed in: show gate --}}
<main class="dlr-gate">
  <div class="dlr-gate-inner">
    <img src="{{asset "images/daily-liturgy-logo.png"}}" alt="The Daily Liturgy" class="dlr-gate-logo" width="320" height="97" />
    <h1 class="dlr-gate-title">Subscribe to read online.</h1>
    <p class="dlr-gate-desc">The online Daily Liturgy reader is available to subscribers. Sign up free to access today's devotional, Scripture readings, and the full archive.</p>
    <div class="dlr-gate-ctas">
      <a href="/daily-liturgy/#subscribe" class="btn btn-copper btn-lg">Subscribe free</a>
      <a href="#/portal/signin" class="btn btn-outline btn-lg">Sign in</a>
    </div>
  </div>
</main>
{{/if}}
