{{!< default}}
{{#contentFor "moHead"}}
<title>Write for Mere Orthodoxy</title>
<meta name="description" content="Pitch guidelines, word counts, and what we are looking for in essays, reviews, and cultural commentary." />
<meta property="og:title" content="Write for Mere Orthodoxy" />
<meta property="og:description" content="Pitch guidelines, word counts, and what we are looking for in essays, reviews, and cultural commentary." />
<meta name="twitter:title" content="Write for Mere Orthodoxy" />
<meta name="twitter:description" content="Pitch guidelines, word counts, and what we are looking for in essays, reviews, and cultural commentary." />
{{/contentFor}}
{{!-- /submissions/ — routed via routes.yaml. Same 2-col layout as
     /contact/: editorial guidelines + AI policy on the left,
     submission form pinned top-right. --}}

<main class="contact-page">

  <section class="hero contact-page-hero">
    <div class="container">
      <p class="hero-kicker"><span class="dot"></span> Submissions</p>
      <h1 class="contact-page-headline">Write for <em><span class="highlight">Mere&nbsp;Orthodoxy</span>.</em></h1>
      <p class="contact-page-sub">We love reading new voices. Tell us what you're working on and we'll get back to you.</p>
    </div>
  </section>

  <section class="contact-page-body">
    <div class="container">
      <div class="contact-page-grid">

        <div class="contact-page-left">
          <div class="section-intro section-intro-left">
            <p class="eyebrow">Guidelines</p>
            <h2 class="section-heading"><em>Before you submit.</em></h2>
          </div>
          <ol class="submissions-guidelines">
            <li class="submissions-guideline">
              <span class="submissions-guideline-numeral">I</span>
              <div>
                <h3 class="submissions-guideline-label"><em>Format</em></h3>
                <p>Submit as a .docx file using the form.</p>
              </div>
            </li>
            <li class="submissions-guideline">
              <span class="submissions-guideline-numeral">II</span>
              <div>
                <h3 class="submissions-guideline-label"><em>Links, not footnotes</em></h3>
                <p>Use hyperlinks rather than footnotes.</p>
              </div>
            </li>
            <li class="submissions-guideline">
              <span class="submissions-guideline-numeral">III</span>
              <div>
                <h3 class="submissions-guideline-label"><em>Patience</em></h3>
                <p>Allow up to two weeks for a reply before asking for an update. If the submission is time-sensitive, note that in the subject line and we'll do our best to review it sooner.</p>
              </div>
            </li>
          </ol>

          <div class="flourish">{{> "flourish-mark"}}</div>

          <div class="section-intro section-intro-left">
            <p class="eyebrow">AI Policy</p>
            <h2 class="section-heading"><em>Written by a human.</em></h2>
          </div>
          <div class="contact-section">
            <p>All article text must be written by a human. We follow <a href="https://thedispatch.com/ai-policy/" target="_blank" rel="noopener"><em>The Dispatch</em>'s AI policy</a>.</p>
          </div>

          {{!-- New Writers Meetings cross-link. COMMENTED OUT until the
                /writers-meetings/ route is uploaded in Ghost admin —
                until then this link 404s, and /submissions/ is already
                live. Uncomment in the same pass that uncomments the
                routes.yaml entry and sets the digest promo's href. --}}
          {{!--
          <div class="flourish">{{> "flourish-mark"}}</div>

          <div class="section-intro section-intro-left">
            <p class="eyebrow">New Writers</p>
            <h2 class="section-heading"><em>Meet us first.</em></h2>
          </div>
          <div class="contact-section">
            <p>This fall we are hosting three one-hour conversations over Zoom for writers who have pitched us and for those who have been meaning to. Part introduction, part training, each one built around a single essay we read beforehand. They are free and open to anyone. <a href="/writers-meetings/">See the dates</a>.</p>
          </div>
          --}}
        </div>

        <aside class="contact-page-right">
          <div class="contact-form-panel">
            <p class="eyebrow">Submit an essay</p>
            <h2 class="contact-panel-heading"><em>Tell us about your piece.</em></h2>
            <form class="site-form" data-site-form="submissions" data-worker-url="{{@custom.forms_worker_url}}" enctype="multipart/form-data" novalidate>
              <div class="site-form-row">
                <div class="site-form-field">
                  <label for="sub-first">First name</label>
                  <input id="sub-first" name="firstName" type="text" autocomplete="given-name" required />
                </div>
                <div class="site-form-field">
                  <label for="sub-last">Last name</label>
                  <input id="sub-last" name="lastName" type="text" autocomplete="family-name" required />
                </div>
              </div>
              <div class="site-form-field">
                <label for="sub-email">Email</label>
                <input id="sub-email" name="email" type="email" autocomplete="email" required />
              </div>
              <div class="site-form-field">
                <label for="sub-phone">Phone</label>
                <input id="sub-phone" name="phone" type="tel" autocomplete="tel" required />
              </div>
              <div class="site-form-field">
                <label for="sub-about">What is your essay about?</label>
                <textarea id="sub-about" name="essayAbout" rows="4" required></textarea>
              </div>
              <div class="site-form-field">
                <label for="sub-bio">Author bio</label>
                <p class="site-form-note">150 characters max.</p>
                <textarea id="sub-bio" name="bio" rows="3" maxlength="150" required></textarea>
              </div>

              <div class="site-form-field">
                <label>Essay</label>
                <p class="site-form-note">.docx, 20 MB max.</p>
                <label class="site-form-upload" data-upload>
                  <input id="sub-essay" name="essay" type="file" accept=".docx,application/vnd.openxmlformats-officedocument.wordprocessingml.document" required />
                  <span class="site-form-upload-btn">Choose file</span>
                  <span class="site-form-upload-name" data-upload-name>No file chosen</span>
                </label>
              </div>

              <div class="site-form-field">
                <label>Author headshot</label>
                <p class="site-form-note">Square image preferred, 20 MB max.</p>
                <label class="site-form-upload" data-upload>
                  <input id="sub-headshot" name="headshot" type="file" accept="image/*" required />
                  <span class="site-form-upload-btn">Choose image</span>
                  <span class="site-form-upload-name" data-upload-name>No file chosen</span>
                </label>
              </div>

              <div class="site-form-field site-form-field-check">
                <label>
                  <input name="aiAttested" type="checkbox" value="true" required />
                  <span>I wrote this piece myself and abided by the AI policy.</span>
                </label>
              </div>

              {{!-- Cloudflare Turnstile widget — see custom-contact.hbs
                   for the rationale + site-key meta-tag pattern. --}}
              <div class="site-form-field" data-turnstile-wrap></div>
              <button type="submit" class="site-form-submit">Submit</button>
              <p class="site-form-status" data-form-status></p>
            </form>
          </div>
        </aside>

      </div>
    </div>
  </section>

</main>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What format should submissions be in?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Submit as a .docx file using the form."
      }
    },
    {
      "@type": "Question",
      "name": "Should I use footnotes?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Use hyperlinks rather than footnotes."
      }
    },
    {
      "@type": "Question",
      "name": "How long until I hear back?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Allow up to two weeks for a reply before asking for an update. If the submission is time-sensitive, note that in the subject line."
      }
    },
    {
      "@type": "Question",
      "name": "What is the AI policy for submissions?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "All article text must be written by a human. Mere Orthodoxy follows The Dispatch's AI policy."
      }
    }
  ]
}
</script>
<script src="{{asset "js/site-forms.js"}}"></script>
