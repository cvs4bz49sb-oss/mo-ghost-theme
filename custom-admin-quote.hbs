{{!< default}}
{{!-- /admin/quote/ — Quote Graphic creator.
     Canvas-based tool for turning pull quotes into branded
     shareable images (1080x1080 square format). --}}

<main class="admin-page admin-workspace">

  {{#if @member}}

    {{> "admin-sidebar" active="quote"}}
    <div class="admin-main">
      <header class="admin-topbar">
        <h1 class="admin-topbar-title"><em>Quote Graphic</em></h1>
        <p class="admin-topbar-sub">Turn any pull quote into a shareable branded image.</p>
      </header>

      <section class="admin-body">
        <div class="container">

          <div class="quote-creator" data-quote-creator>

            <div class="quote-workspace">

              <div class="quote-settings">
                <div class="quote-settings-group">
                  <p class="asset-settings-label">Quote</p>
                  <label class="asset-settings-field">
                    <span class="asset-settings-field-label">Text</span>
                    <textarea data-quote-text rows="5" placeholder="Enter the quote text..."></textarea>
                  </label>
                  <label class="asset-settings-field">
                    <span class="asset-settings-field-label">Attribution</span>
                    <input type="text" data-quote-author placeholder="Author name..." />
                  </label>
                  <label class="asset-settings-field">
                    <span class="asset-settings-field-label">Source</span>
                    <input type="text" data-quote-source placeholder="Article or book title..." />
                  </label>
                </div>

                <div class="quote-settings-group">
                  <p class="asset-settings-label">Style</p>
                  <div class="asset-color-swatches">
                    <button type="button" class="asset-swatch is-active" data-qbg="#1d1b18" style="background:#1d1b18" title="Dark"></button>
                    <button type="button" class="asset-swatch" data-qbg="#f1e0c9" style="background:#f1e0c9" title="Warm"></button>
                    <button type="button" class="asset-swatch" data-qbg="#f6f3f2" style="background:#f6f3f2" title="Light"></button>
                    <button type="button" class="asset-swatch" data-qbg="#ee7d51" style="background:#ee7d51" title="Orange"></button>
                  </div>
                  <label class="asset-settings-field">
                    <span class="asset-settings-field-label">Font size</span>
                    <input type="range" data-quote-fontsize min="28" max="72" value="40" />
                    <span class="asset-settings-field-value" data-quote-fontsize-val>40</span>
                  </label>
                  <label class="asset-settings-field asset-settings-field--checkbox">
                    <input type="checkbox" data-quote-watermark checked />
                    <span class="asset-settings-field-label">Show MO wordmark</span>
                  </label>
                </div>

                <button type="button" class="btn btn-pill btn-primary" data-quote-export style="margin-top:12px">Download PNG</button>
              </div>

              <div class="quote-preview">
                <div class="quote-canvas-wrap">
                  <canvas data-quote-canvas width="1080" height="1080"></canvas>
                </div>
              </div>

            </div>

          </div>

        </div>
      </section>

    </div>

  {{else}}
    {{> "admin-denied"}}
  {{/if}}

</main>

<script src="{{asset "js/admin-auth.js"}}"></script>
<script src="{{asset "js/admin-sidebar.js"}}"></script>
<script src="{{asset "js/admin-quote.js"}}"></script>
