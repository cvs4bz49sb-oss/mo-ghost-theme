{{!< default}}
{{#contentFor "moHead"}}
<title>Manage Your Institution | Mere Orthodoxy</title>
<meta name="robots" content="noindex, nofollow" />
<meta name="description" content="Provision seats and domain access for your institution's Mere Orthodoxy membership." />
<meta property="og:title" content="Manage Your Institution" />
<meta property="og:description" content="Provision seats and domain access for your institution's Mere Orthodoxy membership." />
<meta name="twitter:title" content="Manage Your Institution" />
<meta name="twitter:description" content="Provision seats and domain access for your institution's Mere Orthodoxy membership." />
{{/contentFor}}
{{!-- custom-institution-manage: Mere Orthodoxy institutional admin dashboard --}}

<main class="membership membership-support" data-api-base="{{@custom.membership_api_base}}">

  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Institutional Admin</p>
      <h1 class="page-hero-headline"><em>Provision your institution.</em></h1>
      <p class="page-hero-sub">Invite individuals by name and email when their address falls outside your institutional domain. Domain coverage itself is managed by Mere Orthodoxy &mdash; email <a href="mailto:institutions@mereorthodoxy.com">institutions@mereorthodoxy.com</a> to add or change a domain.</p>
    </div>
  </section>

  <section class="form-section">
    <div class="container">
      <div class="admin-summary admin-summary--two-col">
        <div class="admin-summary-item">
          <p class="admin-summary-label">Institution</p>
          <p class="admin-summary-value" id="inst-org">&mdash;</p>
        </div>
        <div class="admin-summary-item">
          <p class="admin-summary-label">Contract ends</p>
          <p class="admin-summary-value" id="inst-end-date">&mdash;</p>
        </div>
      </div>

      <div class="inst-detail-row" id="inst-code-row" hidden>
        <span class="inst-detail-label">Signup Code</span>
        <span class="inst-detail-value inst-detail-mono" id="inst-code"></span>
        <button type="button" class="inst-detail-copy" data-copy="inst-code" aria-label="Copy code">Copy</button>
      </div>
      <div class="inst-detail-row" id="inst-link-row" hidden>
        <span class="inst-detail-label">Share Link</span>
        <a class="inst-detail-value inst-detail-link" id="inst-share-link" href="#" target="_blank"></a>
        <button type="button" class="inst-detail-copy" data-copy="inst-share-link" aria-label="Copy link">Copy</button>
      </div>

      <section class="admin-summary-note">
        <p class="admin-summary-label">Email domains</p>
        <ul class="admin-domain-pills" id="domains-readonly-list" aria-live="polite">
          <li class="admin-list-empty" id="domains-readonly-empty">No domains on file yet.</li>
        </ul>
        <p class="form-hint">Anyone with an email at one of these domains gets automatic access for the life of your contract. To add or change a domain, email <a href="mailto:institutions@mereorthodoxy.com">institutions@mereorthodoxy.com</a>.</p>
      </section>

      <form id="single-add-form" class="stacked-form" novalidate>
        <fieldset class="form-group">
          <legend class="form-legend">Invite an individual</legend>
          <p class="form-intro">For staff, adjuncts, or partners whose primary email is outside your institutional domain.</p>
          <div class="form-row">
            <label class="form-field">
              <span class="form-label">First name</span>
              <input type="text" name="member_first" autocomplete="given-name" required />
            </label>
            <label class="form-field">
              <span class="form-label">Last name</span>
              <input type="text" name="member_last" autocomplete="family-name" required />
            </label>
            <label class="form-field">
              <span class="form-label">Email</span>
              <input type="email" name="member_email" autocomplete="off" required />
            </label>
          </div>
        </fieldset>
        <button type="submit" class="btn btn-pill btn-primary btn-wide" id="single-add-submit">
          <span class="btn-label">Add member</span>
          <span class="btn-spinner" aria-hidden="true"></span>
        </button>
        <p class="btn-error" id="single-add-error" role="alert"></p>
      </form>

      <details class="bulk-add">
        <summary>Invite several at once</summary>
        <form id="bulk-add-form" class="stacked-form stacked-form--nested" novalidate>
          <label class="form-field">
            <span class="form-label">Paste names and emails</span>
            <textarea name="bulk" rows="6" placeholder="Jane Smith, jane@example.edu&#10;John Doe, john@example.edu" required></textarea>
            <span class="form-hint">One per line. Name and email separated by a comma or tab.</span>
          </label>
          <button type="submit" class="btn btn-pill btn-dark btn-wide" id="bulk-add-submit">
            <span class="btn-label">Invite all</span>
            <span class="btn-spinner" aria-hidden="true"></span>
          </button>
          <p class="btn-error" id="bulk-add-error" role="alert"></p>
        </form>
      </details>

      <section class="admin-list">
        <header class="admin-list-header">
          <h2 class="admin-list-title"><em>Recently invited</em></h2>
          <p class="admin-list-hint">Shown from this session. A full member ledger arrives with the allowlist database.</p>
        </header>
        <ul class="admin-list-items" id="members-list" aria-live="polite">
          <li class="admin-list-empty" id="members-empty">No members invited yet.</li>
        </ul>
      </section>

      <section class="admin-list" data-curated-section hidden>
        <header class="admin-list-header">
          <h2 class="admin-list-title"><em>Curated content</em></h2>
          <p class="admin-list-hint">Articles and episodes you've pushed to your members. They see these on their dashboards.</p>
        </header>
        <ul class="admin-list-items" data-curated-list aria-live="polite">
          <li class="admin-list-empty" data-curated-empty>No content curated yet. Use the push button on any article or podcast episode.</li>
        </ul>
      </section>

      <section class="admin-list" data-admins-section hidden>
        <header class="admin-list-header">
          <h2 class="admin-list-title"><em>Administrators</em></h2>
          <p class="admin-list-hint">People who can push content and manage members for this institution.</p>
        </header>
        <form class="stacked-form stacked-form--inline" data-admin-add novalidate>
          <label class="form-field form-field--grow">
            <span class="form-label visually-hidden">Email</span>
            <input type="email" name="admin_email" placeholder="colleague@example.edu" autocomplete="off" required />
          </label>
          <button type="submit" class="btn btn-primary btn-sm" data-admin-add-submit>
            <span class="btn-label">Add admin</span>
            <span class="btn-spinner" aria-hidden="true"></span>
          </button>
          <p class="btn-error" data-admin-add-error role="alert"></p>
        </form>
        <ul class="admin-list-items" data-admins-list aria-live="polite">
          <li class="admin-list-empty" data-admins-empty>Loading...</li>
        </ul>
      </section>
    </div>
  </section>

  <script src="{{asset "js/admin-auth.js"}}"></script>
  <script src="{{asset "js/institution-manage.js"}}"></script>
</main>
