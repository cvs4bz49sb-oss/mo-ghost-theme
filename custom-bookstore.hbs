{{!< default}}
{{!-- /bookstore/ — curated book recommendations from Mere Orthodoxy.
     Data is loaded from data/bookstore.json. Each category shows 8
     featured titles with a link to the full list on Bookshop.org.
     Purchases through these links support both local bookstores and
     Mere Orthodoxy through the Bookshop.org affiliate program. --}}

<main class="bookstore-page">

  <section class="hero bookstore-hero">
    <div class="container">
      <p class="hero-kicker"><span class="dot"></span> The Bookshelf</p>
      <h1 class="hero-headline">What we're <span class="highlight"><em>reading</em></span>.</h1>
      <p class="hero-sub">Curated book recommendations from the editors and contributors of Mere Orthodoxy. Purchases support local bookstores through <a href="https://bookshop.org/shop/mereorthodoxy" target="_blank" rel="noopener">Bookshop.org</a>.</p>
    </div>
  </section>

  <section class="bookstore-body">
    <div class="container">

      <nav class="bookstore-nav" aria-label="Book categories">
        {{!-- Populated by JS from bookstore.json --}}
      </nav>

      <div class="bookstore-sections" data-bookstore-sections>
        <p class="bookstore-loading">Loading recommendations&hellip;</p>
      </div>

    </div>
  </section>

</main>

<script>
(function () {
  var data = {
    "shopUrl": "https://bookshop.org/shop/mereorthodoxy",
    "categories": [
      {
        "id": "introduction",
        "label": "Introduction to Mere Orthodoxy",
        "listUrl": "https://bookshop.org/lists/introduction-to-mere-orthodoxy",
        "totalCount": 12,
        "books": [
          { "title": "Mere Christianity", "author": "C. S. Lewis", "price": "$16.73" },
          { "title": "Orthodoxy", "author": "G. K. Chesterton", "price": "$9.29" },
          { "title": "Democracy and Solidarity", "author": "James Davison Hunter", "price": "$22.32" },
          { "title": "The Year of Our Lord 1943", "author": "Alan Jacobs", "price": "$39.99" },
          { "title": "Creation Regained", "author": "Albert M. Wolters", "price": "$17.66" },
          { "title": "The Case for Civility", "author": "Os Guinness", "price": "$7.99" },
          { "title": "To Change the World", "author": "James Davison Hunter", "price": "$55.19" },
          { "title": "A Time to Build", "author": "Yuval Levin", "price": "$17.66" }
        ]
      },
      {
        "id": "contributors",
        "label": "Mere Orthodoxy Contributors",
        "listUrl": "https://bookshop.org/lists/mere-orthodoxy-contributors",
        "totalCount": 61,
        "books": [
          { "title": "Christians Reading Classics", "author": "Nadya Williams", "price": "$30.68" },
          { "title": "Resisting Therapy Culture", "author": "Matthew Loftus and Alan Noble", "price": "$20.45" },
          { "title": "Digital Liturgies", "author": "Samuel James", "price": "$15.80" },
          { "title": "Uprooted", "author": "Grace Olmstead", "price": "$25.11" },
          { "title": "Bulwarks of Unbelief", "author": "Joseph Minich and Carl R. Trueman", "price": "$34.40" },
          { "title": "The Dignity of Dependence", "author": "Leah Libresco Sargeant", "price": "$26.04" },
          { "title": "The Church: A Guide to the People of God", "author": "Brad East", "price": "$17.66" },
          { "title": "What Are Christians For?", "author": "Jake Meador and Karen Swallow Prior", "price": "$21.38" }
        ]
      },
      {
        "id": "featured",
        "label": "Featured on Mere O",
        "listUrl": "https://bookshop.org/lists/featured-on-mere-o",
        "totalCount": 146,
        "books": [
          { "title": "Forty Acres Deep", "author": "Michael Perry", "price": "$12.04" },
          { "title": "The Ballad of the Lost Dogs of East Nashville", "author": "John J. Thompson", "price": "$22.31" },
          { "title": "For the Children’s Sake", "author": "Susan Schaeffer Macaulay", "price": "$16.73" },
          { "title": "Hannah Coulter", "author": "Wendell Berry", "price": "$15.76" },
          { "title": "Growing in Christ", "author": "J. I. Packer", "price": "$30.68" },
          { "title": "The Age of Diagnosis", "author": "Suzanne O’Sullivan", "price": "$29.76" },
          { "title": "The Wake", "author": "Paul Kingsnorth", "price": "$18.60" },
          { "title": "Cahokia Jazz", "author": "Francis Spufford", "price": "$18.60" }
        ]
      }
    ]
  };

  render(data);

  function render(data) {
    var sections = document.querySelector("[data-bookstore-sections]");
    var nav = document.querySelector(".bookstore-nav");
    if (!sections || !data.categories) return;

    var navHtml = "";
    var bodyHtml = "";

    data.categories.forEach(function (cat) {
      navHtml += '<a href="#' + cat.id + '" class="bookstore-nav-link">' + cat.label + '</a>';

      bodyHtml += '<div class="bookstore-section" id="' + cat.id + '">';
      bodyHtml += '<div class="bookstore-section-header">';
      bodyHtml += '<h2 class="bookstore-section-title"><em>' + cat.label + '</em></h2>';
      bodyHtml += '<a href="' + cat.listUrl + '" class="bookstore-view-all" target="_blank" rel="noopener">View all ' + cat.totalCount + ' &rarr;</a>';
      bodyHtml += '</div>';

      bodyHtml += '<div class="bookstore-grid">';
      cat.books.forEach(function (book) {
        var searchUrl = "https://bookshop.org/search?keywords=" + encodeURIComponent(book.title + " " + book.author);
        bodyHtml += '<a href="' + searchUrl + '" class="bookstore-book" target="_blank" rel="noopener">';
        bodyHtml += '<span class="bookstore-book-title">' + book.title + '</span>';
        bodyHtml += '<span class="bookstore-book-author">' + book.author + '</span>';
        bodyHtml += '<span class="bookstore-book-price">' + book.price + '</span>';
        bodyHtml += '</a>';
      });
      bodyHtml += '</div>';
      bodyHtml += '</div>';
    });

    nav.innerHTML = navHtml;
    sections.innerHTML = bodyHtml;
  }
})();
</script>
