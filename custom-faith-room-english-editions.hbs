<script data-contents="{{asset "data/faith-received/collected-work-contents.json"}}&amp;frv=16b5a319b51384d7" src="{{asset "js/faith-collected-contents.js"}}&amp;frv=95473b5afaf6e54c"></script>
<script src="{{asset "js/faith-editions.js"}}&amp;frv=34f749318c3d99b4"></script>
<script src="{{asset "js/faith-room.js"}}&amp;frv=d5eaf6eb2b7c9b8a"></script>
<script src="{{asset "js/faith-resolve.js"}}"></script>
