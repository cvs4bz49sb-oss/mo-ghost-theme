{{!< default}}
{{!-- The TFR rail, first on the page and pinned under the masthead as on the reader (Ian, 2026-09-23). --}}
{{> "faith-received/_tfr-rail"}}
{{#contentFor "moHead"}}
<meta name="tfr-room-collection" content="mo" />
<title>Library &mdash; The Faith Received</title>
<meta name="description" content="The full table of contents for a collection in The Faith Received: every author, every work, in one place." />
<meta property="og:title" content="Library — The Faith Received" />
<meta name="twitter:title" content="Library — The Faith Received" />
{{/contentFor}}
{{!-- /the-faith-received/room/ — a collection's whole table of contents.

     One route serves all seven collections; which one is read from
     ?collection= by faith-library-browse.js, the same module that used
     to drive the Library tab. It groups by author, pages, and draws the
     A-Z rail. This template supplies the section it binds to and the
     band language around it.

     Landing here without ?collection= shows the seven collections to
     choose from, which is the module's own top level. --}}

<main class="faith-received faith-room">

  <section class="bhero bhero--tool">
    <div class="bhero-inner container">
      <p class="bhero-kicker"><a href="/the-faith-received/">The Faith Received</a> <span aria-hidden="true">&middot;</span> <a href="/the-faith-received/curated/">Library</a></p>
      <h1>The whole table of contents.</h1>
      <p class="bhero-sub">Every author in the collection, with their works beneath their name. Jump by letter, or search for a name or a title.</p>
    </div>
  </section>
{{!-- The TFR rail, under the hero as on every other TFR page (Ian,
     2026-09-23: "The pages don't have the navrail"). --}}
<script src="{{asset "js/page/faith-tfr-rail.js"}}" defer></script>


  <section class="bband faith-room-body">
    <div class="container" data-faith-room data-fr-bookmark-rows></div>
  </section>

{{> "faith-received/_beta-band"}}
</main>
{{!-- Sitewide membership CTA. Same partial and same gate as the rest
     of the site: hidden for paid and comped members, shown to free
     subscribers and anonymous visitors. --}}
