{{!< default}}
{{!-- /daily-liturgy/ — routed via routes.yaml.

     Landing page for the Daily Liturgy: subscribe (newsletter) and
     listen (podcast) as co-equal paths, with the online reader
     surfaced as a subscriber benefit. Newsletter signup via mo-kit. --}}

<main class="daily-liturgy-page">

  {{!-- Hero: full-bleed dark with DL logo --}}
  <section class="dl-hero">
    <div class="container">
      <img src="{{asset "images/daily-liturgy-logo.png"}}" alt="The Daily Liturgy" class="dl-hero-logo" width="420" height="128" />
      <p class="dl-hero-tagline">Daily Scripture meditations that help you grow in your love for God and your understanding of His Word.</p>
      <div class="dl-hero-ctas">
        <a href="#subscribe" class="btn btn-copper btn-lg">Subscribe free</a>
        <a href="#listen" class="btn btn-ghost-light btn-lg">Listen on podcast</a>
      </div>
    </div>
  </section>

  {{!-- Two paths: Subscribe + Listen --}}
  <section class="dl-paths">
    <div class="container">
      <div class="dl-paths-grid">

        <div class="dl-path dl-path--subscribe" id="subscribe">
          <p class="dl-path-eyebrow">Read daily</p>
          <h2 class="dl-path-title">The newsletter.</h2>
          <p class="dl-path-desc">A short devotional in your inbox every morning: a call to worship, confession, Scripture, and benediction. Fifteen minutes to begin the day in the presence of God.</p>
          <form class="dl-signup-form" data-site-form="newsletter" data-worker-url="{{@custom.kit_worker_url}}" novalidate>
            <div class="dl-field-row">
              <label class="dl-field">
                <span class="dl-field-label">First name</span>
                <input type="text" name="firstName" required autocomplete="given-name" />
              </label>
              <label class="dl-field">
                <span class="dl-field-label">Last name</span>
                <input type="text" name="lastName" required autocomplete="family-name" />
              </label>
            </div>
            <label class="dl-field">
              <span class="dl-field-label">Email</span>
              <input type="email" name="email" required placeholder="you@example.com" autocomplete="email" inputmode="email" />
            </label>
            <div class="dl-turnstile" data-turnstile-wrap></div>
            <button type="submit" class="btn btn-copper">Subscribe</button>
            <p class="dl-form-status" data-form-status role="status" aria-live="polite"></p>
          </form>
          <p class="dl-form-fine">Free. One short email each morning. Unsubscribe anytime.</p>
        </div>

        <div class="dl-path dl-path--listen" id="listen">
          <p class="dl-path-eyebrow">Listen daily</p>
          <h2 class="dl-path-title">The podcast.</h2>
          <p class="dl-path-desc">The same devotional, read aloud. A new episode every morning, wherever you keep your habit of prayer.</p>
          <div class="dl-latest-episode dlr-podcast" data-dl-latest hidden>
            <button class="dlr-play-btn" data-dl-play aria-label="Play episode">
              <svg class="dlr-play-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                <polygon points="6,3 20,12 6,21" fill="currentColor"/>
              </svg>
              <svg class="dlr-pause-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" hidden>
                <rect x="5" y="3" width="4" height="18" fill="currentColor"/>
                <rect x="15" y="3" width="4" height="18" fill="currentColor"/>
              </svg>
            </button>
            <div class="dlr-player-info">
              <span class="dlr-player-title" data-dl-player-title></span>
              <div class="dlr-player-progress" data-dl-progress>
                <div class="dlr-player-bar" data-dl-bar></div>
              </div>
              <span class="dlr-player-subtitle">Follows Devotional Plan</span>
            </div>
            <span class="dlr-player-time" data-dl-time></span>
            <audio data-dl-audio preload="none"></audio>
          </div>
          <div class="dl-listen-ctas">
            <a href="https://podcasts.apple.com/us/podcast/the-daily-liturgy-podcast/id1177180357" class="btn btn-outline-copper" target="_blank" rel="noopener">Apple Podcasts</a>
            <a href="https://open.spotify.com/show/5QgbJ8qxN4W7ftSn7dyK6u" class="btn btn-outline-copper" target="_blank" rel="noopener">Spotify</a>
          </div>
        </div>

      </div>
    </div>
  </section>

  {{!-- Reading plans --}}
  <section class="dl-plans">
    <div class="container">
      <p class="dl-plans-eyebrow">Two plans, one habit</p>
      <h2 class="dl-plans-heading">Scripture every day of the year.</h2>

      <div class="dl-plans-grid">

        <div class="dl-plan-card">
          <div class="dl-plan-icon" aria-hidden="true">&#9753;</div>
          <h3 class="dl-plan-title">The Devotional Plan</h3>
          <p class="dl-plan-desc">A short order of daily prayer drawn from the historic liturgies of the church: a call to worship, confession, three Scripture readings, and a benediction. Fifteen minutes to begin the day in the presence of God.</p>
          <ul class="dl-plan-features">
            <li>Old Testament, New Testament, and Psalm each day</li>
            <li>Prayers from the Book of Common Prayer, The Valley of Vision, The Worship Sourcebook, and original contributions</li>
            <li>Monday through Saturday, every week</li>
          </ul>
        </div>

        <div class="dl-plan-card">
          <div class="dl-plan-icon" aria-hidden="true">&#128214;</div>
          <h3 class="dl-plan-title">The Bible in Two Years</h3>
          <p class="dl-plan-desc">Walk through the entire Bible in two years alongside the devotional readings. A manageable pace that lets you read deeply rather than rush, with the full text included in every email.</p>
          <ul class="dl-plan-features">
            <li>Every book, Genesis to Revelation</li>
            <li>Full ESV text included in each day's email</li>
            <li>Designed to complement the devotional readings</li>
          </ul>
        </div>

      </div>
    </div>
  </section>

  {{!-- Online reader + about --}}
  <section class="dl-about">
    <div class="container">
      <div class="dl-about-inner">
        <h2 class="dl-about-heading">Read online, anytime.</h2>
        <p class="dl-about-text">Subscribers can also <a href="/daily-liturgy/read/">read the full devotional online</a> with Scripture text, translation options, and the ability to go back through past days. Subscribe above to get access.</p>
        <img src="https://storage.ghost.io/c/7b/0b/7b0bd699-d78f-4472-8d29-233bd333f048/content/images/2026/07/Mere-Orthodoxy---Coram-Deo.png" alt="Produced by Mere Orthodoxy and Coram Deo Church" class="dl-partnership-logo" width="320" />
      </div>
    </div>
  </section>

</main>

<script src="{{asset "js/site-forms.js"}}"></script>
<script src="{{asset "js/daily-liturgy-player.js"}}"></script>
{{#if @custom.membership_api_base}}
    <script src="{{asset "js/institution-push.js"}}"></script>
{{/if}}
