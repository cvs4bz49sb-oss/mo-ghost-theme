{{!< default}}
{{#contentFor "moHead"}}
<title>Slide-in CTAs | MO Admin</title>
<meta name="robots" content="noindex, nofollow" />
<meta name="description" content="Internal Mere Orthodoxy staff tool." />
<meta property="og:title" content="Slide-in CTAs | MO Admin" />
<meta property="og:description" content="Internal Mere Orthodoxy staff tool." />
<meta name="twitter:title" content="Slide-in CTAs | MO Admin" />
<meta name="twitter:description" content="Internal Mere Orthodoxy staff tool." />
{{/contentFor}}
{{!-- /admin/slide-ins/ — create and manage slide-in CTAs.
     Staff-only writes; active slide-ins served publicly by
     GET /slide-ins on the admin worker. --}}

<main class="admin-page admin-workspace">

  {{#if @member}}

    {{> "admin-sidebar" active="slide-ins"}}
    <div class="admin-main">
      <header class="admin-topbar">
        <h1 class="admin-topbar-title"><em>Slide-in CTAs</em></h1>
        <p class="admin-topbar-sub">Subtle prompts that appear on the public site. Targeted by page, audience, and frequency.</p>
      </header>

    <section class="admin-body">
      <div class="container container-narrow">
        <div class="admin-slide-ins"
             data-admin-slide-ins
             data-worker-url="{{@custom.admin_worker_url}}"
             {{#if @custom.content_api_key}}data-content-api-key="{{@custom.content_api_key}}"{{/if}}
             data-site-url="{{@site.url}}">

          {{!-- List view --}}
          <div data-slide-in-list>
            <div class="dashboard-address-actions" style="margin-bottom: 36px;">
              <button type="button" class="btn btn-primary" data-slide-in-create>New slide-in</button>
            </div>
            <div data-slide-in-items>
              <p class="admin-sub">Loading&hellip;</p>
            </div>
          </div>

          {{!-- Edit / create form (hidden by default) --}}
          <div data-slide-in-editor hidden>
            <div class="dashboard-module" data-slide-in-form>

              <div class="dashboard-form-group">
                <p class="dashboard-form-legend"><em>Content</em></p>
                <label class="dashboard-form-field">
                  <span class="dashboard-form-label">Internal name</span>
                  <input type="text" name="name" placeholder="e.g. Spring membership push" />
                  <span class="dashboard-form-hint">For your reference only. Not shown to visitors.</span>
                </label>
                <label class="dashboard-form-field">
                  <span class="dashboard-form-label">Eyebrow</span>
                  <input type="text" name="eyebrow" placeholder="e.g. Sponsored" />
                  <span class="dashboard-form-hint">Optional. Small label above the headline.</span>
                </label>
                <label class="dashboard-form-field">
                  <span class="dashboard-form-label">Headline</span>
                  <input type="text" name="headline" placeholder="e.g. Support our work" />
                </label>
                <div class="dashboard-form-field">
                  <span class="dashboard-form-label">Image</span>
                  <div class="slide-in-image-upload" data-image-upload>
                    <div class="slide-in-image-preview" data-image-preview hidden>
                      <img data-image-preview-img alt="" />
                      <button type="button" class="slide-in-image-remove" data-image-remove aria-label="Remove image">&times;</button>
                    </div>
                    <div class="slide-in-image-picker" data-image-picker>
                      <input type="file" accept="image/jpeg,image/png,image/gif,image/webp,image/svg+xml" data-image-file hidden />
                      <button type="button" class="btn btn-ghost btn-sm" data-image-choose>Upload image</button>
                      <span class="slide-in-image-uploading" data-image-uploading hidden>Uploading&hellip;</span>
                    </div>
                    <input type="hidden" name="image" />
                  </div>
                  <span class="dashboard-form-hint">Optional. JPEG, PNG, GIF, WebP, or SVG under 5 MB.</span>
                </div>
                <label class="dashboard-form-field">
                  <span class="dashboard-form-label">Body text</span>
                  <textarea name="body" rows="3" placeholder="A sentence or two."></textarea>
                </label>
                <label class="dashboard-form-field">
                  <span class="dashboard-form-label">Button text</span>
                  <input type="text" name="button_text" placeholder="e.g. Become a Member" />
                </label>
                <label class="dashboard-form-field">
                  <span class="dashboard-form-label">Button URL</span>
                  <input type="url" name="button_url" placeholder="/membership/" />
                </label>
              </div>

              <div class="dashboard-form-group">
                <p class="dashboard-form-legend"><em>Targeting</em></p>
                <label class="dashboard-form-field">
                  <span class="dashboard-form-label">Show on</span>
                  <select name="pages_type">
                    <option value="all">All pages</option>
                    <option value="homepage">Homepage only</option>
                    <option value="posts">All posts</option>
                    <option value="tag">Posts with a specific tag</option>
                  </select>
                </label>
                <label class="dashboard-form-field" data-tag-field hidden>
                  <span class="dashboard-form-label">Tag slug</span>
                  <input type="text" name="tag_slug" placeholder="e.g. family" />
                  <span class="dashboard-form-hint">The tag's URL slug, not its display name.</span>
                </label>
                <div class="dashboard-form-field" data-exclude-group>
                  <span class="dashboard-form-label">Hide on</span>
                  <ul class="slide-in-exclude-list" data-exclude-list></ul>
                  <div class="slide-in-exclude-add">
                    <select data-exclude-select aria-label="Page to hide this slide-in on">
                      <option value="">Choose a page&hellip;</option>
                    </select>
                    <input type="text" data-exclude-custom aria-label="Custom path" placeholder="/some-page/" hidden />
                    <button type="button" class="btn btn-ghost btn-sm" data-exclude-add>Add</button>
                  </div>
                  <input type="hidden" name="exclude_paths" />
                  <span class="dashboard-form-hint">Optional. The slide-in never appears on these pages, even when "Show on" matches. End a path with * to cover everything beneath it.</span>
                </div>
                <fieldset class="dashboard-form-field" data-audience-group>
                  <span class="dashboard-form-label">Audience</span>
                  <div class="dashboard-checkbox-group">
                    <label class="dashboard-checkbox-item">
                      <input type="checkbox" name="audience" value="everyone" />
                      <span>Everyone</span>
                    </label>
                    <label class="dashboard-checkbox-item">
                      <input type="checkbox" name="audience" value="not-signed-in" />
                      <span>Not signed in</span>
                    </label>
                    <label class="dashboard-checkbox-item">
                      <input type="checkbox" name="audience" value="signed-in" />
                      <span>Any signed-in member</span>
                    </label>
                    <label class="dashboard-checkbox-item">
                      <input type="checkbox" name="audience" value="free" />
                      <span>Free subscribers only</span>
                    </label>
                    <label class="dashboard-checkbox-item">
                      <input type="checkbox" name="audience" value="paid" />
                      <span>Paid members only</span>
                    </label>
                  </div>
                  <span class="dashboard-form-hint">Select one or more. "Everyone" overrides other selections.</span>
                </fieldset>
              </div>

              <div class="dashboard-form-group">
                <p class="dashboard-form-legend"><em>Behavior</em></p>
                <label class="dashboard-form-field">
                  <span class="dashboard-form-label">Trigger</span>
                  <select name="trigger">
                    <option value="delay">After delay (seconds)</option>
                    <option value="exit">On exit intent</option>
                    <option value="scroll">Scroll depth (%)</option>
                  </select>
                </label>
                <label class="dashboard-form-field" data-trigger-value-field>
                  <span class="dashboard-form-label">Trigger value</span>
                  <input type="number" name="trigger_value" min="0" step="1" value="3" />
                  <span class="dashboard-form-hint" data-trigger-hint>Seconds before showing (default 3).</span>
                </label>
                <label class="dashboard-form-field">
                  <span class="dashboard-form-label">Frequency</span>
                  <select name="frequency">
                    <option value="weekly">Once a week</option>
                    <option value="daily">Once a day</option>
                    <option value="biweekly">Once every two weeks</option>
                    <option value="monthly">Once a month</option>
                    <option value="once">Once (until cleared)</option>
                  </select>
                  <span class="dashboard-form-hint">How often a visitor sees this after dismissing it.</span>
                </label>
                <label class="dashboard-form-field">
                  <span class="dashboard-form-label">Priority</span>
                  <input type="number" name="priority" min="0" step="1" value="0" />
                  <span class="dashboard-form-hint">Higher number wins when multiple slide-ins match.</span>
                </label>
                <label class="dashboard-form-field dashboard-form-field--checkbox">
                  <input type="checkbox" name="active" checked />
                  <span class="dashboard-form-label">Active</span>
                </label>
              </div>

              <div class="dashboard-address-actions">
                <button type="button" class="btn btn-primary" data-slide-in-save>Save</button>
                <button type="button" class="btn btn-ghost" data-slide-in-preview>Preview</button>
                <button type="button" class="btn btn-ghost" data-slide-in-cancel>Cancel</button>
              </div>
              <p class="dashboard-form-success" data-slide-in-status hidden></p>

              {{!-- Live preview panel --}}
              <div class="slide-in-preview-panel" data-slide-in-preview-panel hidden>
                <div class="slide-in-preview-toolbar">
                  <span class="slide-in-preview-title">Preview</span>
                  <div class="slide-in-preview-modes">
                    <button type="button" class="btn btn-sm btn-ghost is-active" data-preview-mode="desktop">Desktop</button>
                    <button type="button" class="btn btn-sm btn-ghost" data-preview-mode="mobile">Mobile</button>
                  </div>
                  <button type="button" class="btn btn-sm btn-ghost" data-slide-in-preview-close>&times;</button>
                </div>
                <div class="slide-in-preview-viewport" data-preview-viewport="desktop">
                  <div class="slide-in-preview-stage" data-slide-in-preview-stage></div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    </div>

  {{else}}
    {{> "admin-denied"}}
  {{/if}}

</main>

<script src="{{asset "js/admin-auth.js"}}"></script>
<script src="{{asset "js/admin-sidebar.js"}}"></script>
<script src="{{asset "js/admin-slide-ins.js"}}"></script>
