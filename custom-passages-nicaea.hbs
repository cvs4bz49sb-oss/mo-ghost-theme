{{!< default}}
{{#contentFor "moHead"}}
<title>Passages: Nicaea | Mere Orthodoxy</title>
<meta name="description" content="A Mere Orthodoxy podcast on the documents, arguments, and people behind the Nicene Creed. All thirteen episodes, show notes, and where to listen." />
<meta property="og:title" content="Passages: Nicaea" />
<meta property="og:description" content="A Mere Orthodoxy podcast on the documents, arguments, and people behind the Nicene Creed. All thirteen episodes, show notes, and where to listen." />
<meta name="twitter:title" content="Passages: Nicaea" />
<meta name="twitter:description" content="A Mere Orthodoxy podcast on the documents, arguments, and people behind the Nicene Creed. All thirteen episodes, show notes, and where to listen." />
{{/contentFor}}
{{!-- /podcasts/passages-nicaea/ — routed via routes.yaml.

     Same layout as the Mere Fidelity and Christians Reading Classics
     pages, with three differences that follow from the show itself:

       1. Passages is still hosted on Libsyn, not Buzzsprout. The
          mo-podcast-feed worker reads it from the Libsyn RSS feed
          (SHOWS["passages-nicaea"]) and returns no embed URL, so the
          cards render our own audio player off the enclosure URL.
       2. No wiki lens and no Most Listened rail. Both are built from
          the Buzzsprout JSON API (podcast-wiki.json / top-episodes.json)
          and have no Libsyn equivalent.
       3. data-order="asc" — this is a closed thirteen-part series meant
          to be heard front to back, so the list runs Introduction first
          rather than newest first.

     podcast-feed.js is already inside built/site.min.js, which
     default.hbs loads on every page, so this template does NOT add a
     second <script> tag for it. --}}

<main class="podcast-page podcast-page--roman">

  {{!-- This page runs upright. The house style italicises section
       headings, show names, host names and episode titles; here the
       display italic is spent on one phrase, "Light of Light" in the
       hero, and nothing else competes with it. Scoped to this template
       so Mere Fidelity and Christians Reading Classics keep the house
       treatment, and written as font-style rather than stripped <em>
       tags so the emphasis stays in the markup for screen readers and
       for anyone who wants the italics back. --}}
  <style>
    .podcast-page--roman em,
    .podcast-page--roman .podcast-host-initial { font-style: normal; }
    .podcast-page--roman .podcast-hero-headline .highlight em { font-style: italic; }
  </style>

  <section class="hero podcast-hero">
    <div class="container">
      <div class="podcast-hero-grid">
        <div class="podcast-hero-content">
          <p class="hero-kicker"><span class="dot"></span> Podcast</p>
          <h1 class="podcast-hero-headline">How the church came to say <span class="highlight"><em>Light of Light</em></span>.</h1>
          <p class="podcast-hero-sub"><em>Passages: Nicaea</em> traces the texts, the arguments, and the people behind the Nicene Creed, one chapter at a time. Joshua Heavin and Caleb Wait recorded the thirteen-part series in 2021 with guests including Khaled Anatolios, Fred Sanders, Scott Swain, and Amy Brown Hughes. The series is complete and best heard in order.</p>
          <div class="podcast-hero-ctas">
            <a href="https://podcasts.apple.com/us/podcast/passages-nicaea/id1555959543" class="btn btn-primary btn-lg" target="_blank" rel="noopener">Apple Podcasts</a>
            <a href="https://open.spotify.com/show/0FGBFgoNRInCc0QcLBj57x" class="btn btn-ghost btn-lg" target="_blank" rel="noopener">Spotify</a>
          </div>
        </div>
        <div class="podcast-hero-art" aria-hidden="true">
          <img src="{{asset "images/passages-nicaea.jpg"}}" alt="Passages: Nicaea" />
        </div>
      </div>
    </div>
  </section>

  <section class="podcast-body">
    <div class="container">
      <div class="podcast-grid">

        <div class="podcast-episodes">
          <div class="section-intro section-intro-left">
            <p class="eyebrow">Thirteen Chapters</p>
            <h2 class="section-heading"><em>The creed, clause by clause.</em></h2>
          </div>
          <div class="listen-grid podcast-episode-list"
               data-show="passages-nicaea"
               data-show-limit="13"
               data-order="asc"
               data-pn-apple="https://podcasts.apple.com/us/podcast/passages-nicaea/id1555959543"
               data-pn-spotify="https://open.spotify.com/show/0FGBFgoNRInCc0QcLBj57x">
            <p class="podcast-episodes-loading">Loading episodes&hellip;</p>
          </div>
        </div>

        <aside class="podcast-hosts">
          <div class="section-intro section-intro-left">
            <p class="eyebrow">The Hosts</p>
            <h2 class="section-heading"><em>Who you'll hear.</em></h2>
          </div>
          <ul class="podcast-host-list">
            {{#get "tags" filter="slug:author-joshua-heavin" limit="1"}}{{#foreach tags}}
              <li class="podcast-host"><a href="{{url}}" class="podcast-host-link"><div class="podcast-host-portrait" aria-hidden="true">{{#if feature_image}}<img src="{{img_url feature_image size="s"}}" alt="{{name}}" />{{else}}<span class="podcast-host-initial">{{name}}</span>{{/if}}</div><h3 class="podcast-host-name"><em>{{name}}</em></h3></a></li>
            {{/foreach}}{{/get}}
            {{#get "tags" filter="slug:author-caleb-wait" limit="1"}}{{#foreach tags}}
              <li class="podcast-host"><a href="{{url}}" class="podcast-host-link"><div class="podcast-host-portrait" aria-hidden="true">{{#if feature_image}}<img src="{{img_url feature_image size="s"}}" alt="{{name}}" />{{else}}<span class="podcast-host-initial">{{name}}</span>{{/if}}</div><h3 class="podcast-host-name"><em>{{name}}</em></h3></a></li>
            {{/foreach}}{{/get}}
          </ul>

          {{#get "posts" filter="tag:hash-podcast-transcript+tag:passages-nicaea" order="published_at desc" limit="all" include="authors"}}
            {{#if posts}}
              <section class="podcast-transcripts">
                <div class="section-intro section-intro-left">
                  <p class="eyebrow">Transcripts</p>
                  <h2 class="section-heading"><em>Read the conversation.</em></h2>
                </div>
                <div class="podcast-transcript-list">
                  {{#foreach posts}}
                    <a href="{{url}}" class="podcast-transcript-entry">
                      <h3 class="podcast-transcript-title"><em>{{title}}</em></h3>
                      <time class="podcast-transcript-date" datetime="{{date format="YYYY-MM-DD"}}">{{date format="MMMM D, YYYY"}}</time>
                    </a>
                  {{/foreach}}
                </div>
              </section>
            {{/if}}
          {{/get}}
        </aside>

      </div>
    </div>
  </section>

</main>

{{#if @custom.membership_api_base}}
    <script src="{{asset "js/institution-push.js"}}"></script>
{{/if}}
