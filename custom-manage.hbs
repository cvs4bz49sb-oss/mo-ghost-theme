{{!< default}}
{{!-- custom-manage: /manage/ page. Two modes:
     1) Signed-in member → tier-aware content. Paid / free members
        see the Portal billing flow; lifetime / gift / group members
        see a tier-specific message (there's nothing for them to
        manage in Portal — no recurring billing).
     2) Not signed in → email-capture form to request a magic link.

     Tier detection: Ghost's member labels are scanned client-side
     in a small inline script because Ghost's Handlebars helpers
     don't do substring matching on arrays. Each tier variant is
     rendered server-side and hidden by default; JS unhides one. --}}

<main class="membership membership-support page-simple">

  <div class="centered-main">
    <div class="container centered-inner narrow">

      {{#if @member}}
        {{!-- Pass labels as a data attribute so the inline script
             can pick the right variant. --}}
        <div class="manage-tier-wrap"
             data-member-status="{{@member.status}}"
             data-member-labels="{{#foreach @member.labels}}{{name}} {{/foreach}}">

          {{!-- Default (paid monthly/annual) — shown unless a
               tier-specific variant un-hides itself. --}}
          <div data-manage-tier="paid">
            <p class="eyebrow">Your Membership</p>
            <h1 class="page-hero-headline page-hero-headline--dark">Manage Your Membership</h1>
            <p class="page-hero-sub page-hero-sub--dark">
              Update your payment method, switch between monthly and annual, review billing history, or cancel — all through the secure Portal below.
            </p>
            <div class="button-row">
              <a href="#/portal/account" data-portal="account" class="btn btn-primary btn-inline">Open Billing Portal</a>
              <a href="/dashboard/" class="btn btn-dark btn-inline">Go to Dashboard</a>
            </div>

            <div class="manage-address-section">
              <h2 class="manage-section-heading"><em>Shipping Address</em></h2>
              <p class="manage-section-sub">The print journal goes out quarterly. Keep your address current so you don't miss the next issue.</p>
              <div class="dashboard-address"
                   data-dashboard-address
                   data-member-email="{{@member.email}}"
                   data-member-name="{{@member.name}}"
                   data-api-base="{{@custom.membership_api_base}}">
                <p class="dashboard-empty" data-address-placeholder>Loading your address&hellip;</p>

                <div class="dashboard-address-view" data-address-view hidden>
                  <p class="eyebrow dashboard-address-eyebrow">On file</p>
                  <p class="dashboard-address-display" data-address-display></p>
                  <button type="button" class="dashboard-inline-link" data-address-edit>Edit address &rarr;</button>
                </div>

                <div class="dashboard-address-empty" data-address-empty hidden>
                  <button type="button" class="dashboard-inline-link" data-address-edit>Add your address &rarr;</button>
                </div>

                <form class="dashboard-address-form" data-address-form hidden novalidate>
                  <div class="dashboard-form-group">
                    <p class="dashboard-form-legend"><em>Recipient</em></p>
                    <label class="dashboard-form-field">
                      <span class="dashboard-form-label">Full name on label</span>
                      <input type="text" name="name" autocomplete="name" required />
                    </label>
                    <label class="dashboard-form-field">
                      <span class="dashboard-form-label">Organization <span class="dashboard-form-hint">(optional)</span></span>
                      <input type="text" name="organization" autocomplete="organization" />
                    </label>
                    <label class="dashboard-form-field">
                      <span class="dashboard-form-label">Church <span class="dashboard-form-hint">(optional)</span></span>
                      <input type="text" name="church" />
                    </label>
                  </div>

                  <div class="dashboard-form-group">
                    <p class="dashboard-form-legend"><em>Address</em></p>
                    <label class="dashboard-form-field">
                      <span class="dashboard-form-label">Street</span>
                      <input type="text" name="line1" autocomplete="address-line1" required />
                    </label>
                    <label class="dashboard-form-field">
                      <span class="dashboard-form-label">Apartment, suite, or unit <span class="dashboard-form-hint">(optional)</span></span>
                      <input type="text" name="line2" autocomplete="address-line2" />
                    </label>
                    <div class="dashboard-form-row">
                      <label class="dashboard-form-field">
                        <span class="dashboard-form-label">City</span>
                        <input type="text" name="city" autocomplete="address-level2" required />
                      </label>
                      <label class="dashboard-form-field">
                        <span class="dashboard-form-label">State / Province</span>
                        <input type="text" name="state" autocomplete="address-level1" maxlength="100" />
                        <span class="dashboard-form-hint">State, county, or province (if applicable)</span>
                      </label>
                    </div>
                    <div class="dashboard-form-row">
                      <label class="dashboard-form-field">
                        <span class="dashboard-form-label">ZIP / Postal code</span>
                        <input type="text" name="postal_code" autocomplete="postal-code" required />
                      </label>
                      <label class="dashboard-form-field">
                        <span class="dashboard-form-label">Country</span>
                        <select name="country" required>
                          <option value="US">United States</option>
                          <option value="CA">Canada</option>
                          <option value="GB">United Kingdom</option>
                          <option disabled>──────────</option>
                          <option value="AF">Afghanistan</option>
