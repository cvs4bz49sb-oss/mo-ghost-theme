{{!< default}}
{{!-- /admin/copy/ — Social Copy Creator.
     Uses Claude via the mo-admin worker to generate platform-tailored
     social media copy from an article URL or pasted text. --}}

<main class="admin-page admin-workspace">

  {{#if @member}}

    {{> "admin-sidebar" active="copy"}}
    <div class="admin-main">
      <header class="admin-topbar">
        <h1 class="admin-topbar-title"><em>Social Copy</em></h1>
        <p class="admin-topbar-sub">Generate platform-tailored social media copy from any article.</p>
      </header>

      <section class="admin-body">
        <div class="container container-narrow">

          <div class="copy-creator"
               data-copy-creator
               data-worker-url="{{@custom.admin_worker_url}}"
               {{#if @custom.content_api_key}}data-content-api-key="{{@custom.content_api_key}}"{{/if}}
               data-site-url="{{@site.url}}">

            <div class="copy-form">
              <div class="dashboard-module">
                <div class="dashboard-form-group">
                  <p class="dashboard-form-legend"><em>Source</em></p>
                  <label class="dashboard-form-field">
                    <span class="dashboard-form-label">Article URL</span>
                    <input type="text" name="url" placeholder="Paste a Mere Orthodoxy article URL..." data-copy-url />
                    <span class="dashboard-form-hint">We'll pull the title, excerpt, and content for Claude.</span>
                  </label>
                  <label class="dashboard-form-field">
                    <span class="dashboard-form-label">Or paste text directly</span>
                    <textarea name="text" rows="5" placeholder="Paste article text or key points..." data-copy-text></textarea>
                  </label>
                </div>

                <div class="dashboard-form-group">
                  <p class="dashboard-form-legend"><em>Platforms</em></p>
                  <label class="dashboard-form-field asset-settings-field--checkbox">
                    <input type="checkbox" data-copy-platform="twitter" checked />
                    <span class="dashboard-form-label">X (Twitter)</span>
                  </label>
                  <label class="dashboard-form-field asset-settings-field--checkbox">
                    <input type="checkbox" data-copy-platform="instagram" checked />
                    <span class="dashboard-form-label">Instagram caption</span>
                  </label>
                  <label class="dashboard-form-field asset-settings-field--checkbox">
                    <input type="checkbox" data-copy-platform="facebook" checked />
                    <span class="dashboard-form-label">Facebook</span>
                  </label>
                  <label class="dashboard-form-field asset-settings-field--checkbox">
                    <input type="checkbox" data-copy-platform="linkedin" />
                    <span class="dashboard-form-label">LinkedIn</span>
                  </label>
                  <label class="dashboard-form-field asset-settings-field--checkbox">
                    <input type="checkbox" data-copy-platform="substack-notes" />
                    <span class="dashboard-form-label">Substack Notes</span>
                  </label>
                </div>

                <div class="dashboard-form-group">
                  <p class="dashboard-form-legend"><em>Tone</em></p>
                  <label class="dashboard-form-field">
                    <span class="dashboard-form-label">Voice</span>
                    <select data-copy-tone>
                      <option value="editorial">Editorial (default)</option>
                      <option value="conversational">Conversational</option>
                      <option value="provocative">Provocative / debate-starting</option>
                      <option value="devotional">Devotional / reflective</option>
                    </select>
                  </label>
                </div>

                <div class="dashboard-address-actions">
                  <button type="button" class="btn btn-pill btn-primary" data-copy-generate>Generate copy</button>
                </div>
                <p class="dashboard-form-success" data-copy-status hidden></p>
              </div>
            </div>

            <div class="copy-output" data-copy-output hidden>
              <div class="section-intro section-intro-left">
                <p class="eyebrow">Generated copy</p>
                <h2 class="section-heading"><em>Ready to post.</em></h2>
              </div>
              <div data-copy-results></div>
            </div>

          </div>

        </div>
      </section>

    </div>

  {{else}}
    {{> "admin-denied"}}
  {{/if}}

</main>

<script src="{{asset "js/admin-auth.js"}}"></script>
<script src="{{asset "js/admin-sidebar.js"}}"></script>
<script src="{{asset "js/admin-copy.js"}}"></script>
