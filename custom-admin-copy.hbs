{{!< default}}
{{#contentFor "moHead"}}
<title>Social Copy | MO Admin</title>
<meta name="robots" content="noindex, nofollow" />
<meta name="description" content="Internal Mere Orthodoxy staff tool." />
<meta property="og:title" content="Social Copy | MO Admin" />
<meta property="og:description" content="Internal Mere Orthodoxy staff tool." />
<meta name="twitter:title" content="Social Copy | MO Admin" />
<meta name="twitter:description" content="Internal Mere Orthodoxy staff tool." />
{{/contentFor}}
{{!-- /admin/copy/ — Social Copy Creator.
     Uses Claude via the mo-admin worker to generate platform-tailored
     social media copy from an article URL or pasted text. --}}

<main class="admin-page admin-workspace">

  {{#if @member}}

    {{> "admin-sidebar" active="copy"}}
    <div class="admin-main">
      <header class="admin-topbar">
        <h1 class="admin-topbar-title"><em>Social Copy</em></h1>
        <p class="admin-topbar-sub">Generate platform-tailored social media copy from any article.</p>
      </header>

      <section class="admin-body">
        <div class="container container-narrow">

          <div class="copy-creator"
               data-copy-creator
               data-worker-url="{{@custom.admin_worker_url}}"
               {{#if @custom.content_api_key}}data-content-api-key="{{@custom.content_api_key}}"{{/if}}
               data-site-url="{{@site.url}}">

            {{!-- Source --}}
            <div class="copy-section">
              <label class="copy-field">
                <span class="copy-field-label">Article URL</span>
                <div class="copy-url-row">
                  <input type="text" class="copy-input" placeholder="Paste any Mere Orthodoxy article URL..." data-copy-url />
                </div>
              </label>
              <div class="copy-divider-or"><span>or paste text directly</span></div>
              <label class="copy-field">
                <textarea class="copy-textarea" rows="4" placeholder="Paste article text or key points..." data-copy-text></textarea>
              </label>
            </div>

            {{!-- Platforms --}}
            <div class="copy-section">
              <span class="copy-field-label">Platforms</span>
              <div class="copy-platform-pills" data-copy-platforms>
                <button type="button" class="copy-pill is-active" data-copy-platform="twitter">X / Twitter</button>
                <button type="button" class="copy-pill is-active" data-copy-platform="instagram">Instagram</button>
                <button type="button" class="copy-pill is-active" data-copy-platform="facebook">Facebook</button>
                <button type="button" class="copy-pill" data-copy-platform="linkedin">LinkedIn</button>
                <button type="button" class="copy-pill" data-copy-platform="substack-notes">Substack Notes</button>
              </div>
            </div>

            {{!-- Tone + Generate --}}
            <div class="copy-section copy-section-row">
              <label class="copy-field copy-field-tone">
                <span class="copy-field-label">Voice</span>
                <select class="copy-select" data-copy-tone>
                  <option value="editorial">Editorial (default)</option>
                  <option value="conversational">Conversational</option>
                  <option value="provocative">Provocative / debate-starting</option>
                  <option value="devotional">Devotional / reflective</option>
                </select>
              </label>
              <div class="copy-generate-wrap">
                <button type="button" class="btn btn-primary" data-copy-generate>Generate copy</button>
              </div>
            </div>

            <p class="copy-status" data-copy-status hidden></p>

            {{!-- Results --}}
            <div class="copy-output" data-copy-output hidden>
              <div class="copy-output-divider"></div>
              <div data-copy-results></div>
            </div>

          </div>

        </div>
      </section>

    </div>

  {{else}}
    {{> "admin-denied"}}
  {{/if}}

</main>

<script src="{{asset "js/admin-auth.js"}}"></script>
<script src="{{asset "js/admin-sidebar.js"}}"></script>
<script src="{{asset "js/admin-copy.js"}}"></script>
