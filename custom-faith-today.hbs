{{!< default}}
{{#contentFor "moHead"}}
<title>Today's Reading | The Faith Received</title>
<meta name="description" content="A daily passage from the creeds, confessions, and classic works of The Faith Received." />
<meta property="og:title" content="Today's Reading | The Faith Received" />
<meta property="og:description" content="A daily passage from the creeds, confessions, and classic works of The Faith Received." />
<meta name="twitter:title" content="Today's Reading | The Faith Received" />
<meta name="twitter:description" content="A daily passage from the creeds, confessions, and classic works of The Faith Received." />
{{/contentFor}}
{{!-- /the-faith-received/today/ — Today's reading. A single passage
     deterministically picked from the library by day-of-year. Plan
     entries are pre-built into assets/data/faith-received/today.json
     so the same date returns the same reading for every visitor.
     Body markup lives in _today-body.hbs so the home Today tab and
     this routed page render identical content. --}}

<main class="faith-received faith-feature">

  <section class="hero faith-feature-hero">
    <div class="container">
      <p class="hero-kicker"><span class="dot"></span> The Faith Received &middot; Today's Reading</p>
      <h1 class="hero-headline faith-hero-headline">
        <em>Today's Reading</em>
      </h1>
      <p class="hero-sub" data-faith-today-date>Loading&hellip;</p>
    </div>
  </section>


  <section class="faith-feature-body faith-today-body">
    <div class="container container-narrow">
      {{> "faith-received/_today-body"}}
    </div>
  </section>

</main>

<script src="{{asset "js/faith-received.js"}}"></script>

<script src="{{asset "js/faith-gate.js"}}"></script>
