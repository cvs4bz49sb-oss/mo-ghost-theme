{{!< default}}
{{!-- /podcasts/christians-reading-classics/ — routed via routes.yaml. --}}

<main class="podcast-page">

  <section class="hero podcast-hero">
    <div class="container">
      <div class="podcast-hero-grid">
        <div class="podcast-hero-content">
          <p class="hero-kicker"><span class="dot"></span> Podcast</p>
          <h1 class="podcast-hero-headline">Reading old books <span class="highlight"><em>for the new world</em></span>.</h1>
          <p class="podcast-hero-sub"><em>Christians Reading Classics</em> is a slow walk through the great books of the Christian and classical tradition, one volume at a time &mdash; re-introducing classic works that have inspired generations.</p>
          <div class="podcast-hero-ctas">
            <a href="https://podcasts.apple.com/us/podcast/christians-reading-classics/id1832749498" class="btn btn-primary btn-lg" target="_blank" rel="noopener">Apple Podcasts</a>
            <a href="https://open.spotify.com/show/3h8zciESjSYUajDB9XJ9ni" class="btn btn-ghost btn-lg" target="_blank" rel="noopener">Spotify</a>
          </div>
        </div>
        <div class="podcast-hero-art" aria-hidden="true">
          <img src="{{asset "images/christians-reading-classics.jpg"}}" alt="Christians Reading Classics" />
        </div>
      </div>
    </div>
  </section>

  <section class="podcast-body">
    <div class="container">
      <div class="podcast-grid">

        <div class="podcast-episodes">
          <div class="section-intro section-intro-left">
            <p class="eyebrow" data-wiki-eyebrow>Latest Episodes</p>
            <h2 class="section-heading" data-wiki-heading><em>Listen now.</em></h2>
          </div>
          <div class="wiki-lens" role="group" aria-label="Browse episodes by" hidden>
            <button type="button" data-lens="latest" aria-pressed="true">Latest</button>
            <button type="button" data-lens="topics" aria-pressed="false">By Topic</button>
            <button type="button" data-lens="guests" aria-pressed="false">By Guest</button>
          </div>
          <div class="wiki-catview" data-wiki-catview hidden></div>
          <div class="listen-grid podcast-episode-list"
               data-show="christians-reading-classics"
               data-show-limit="8"
               data-wiki="{{asset "data/podcast-wiki.json"}}"
               data-mf-apple="https://podcasts.apple.com/us/podcast/mere-fidelity/id885758537"
               data-mf-spotify="https://open.spotify.com/show/2MO8K1HMGp9Y0PTZ7c07Tz"
               data-crc-apple="https://podcasts.apple.com/us/podcast/christians-reading-classics/id1832749498"
               data-crc-spotify="https://open.spotify.com/show/3h8zciESjSYUajDB9XJ9ni">
            <p class="podcast-episodes-loading">Loading episodes&hellip;</p>
          </div>
        </div>

        <aside class="podcast-hosts">
          <div class="section-intro section-intro-left">
            <p class="eyebrow">The Host</p>
            <h2 class="section-heading"><em>Who you'll hear.</em></h2>
          </div>
          <ul class="podcast-host-list podcast-host-list--single">
            {{#get "tags" filter="slug:author-nadya-williams" limit="1"}}{{#foreach tags}}
              <li class="podcast-host"><a href="{{url}}" class="podcast-host-link"><div class="podcast-host-portrait" aria-hidden="true">{{#if feature_image}}<img src="{{img_url feature_image size="s"}}" alt="{{name}}" />{{else}}<span class="podcast-host-initial">{{name}}</span>{{/if}}</div><h3 class="podcast-host-name"><em>{{name}}</em></h3></a></li>
            {{/foreach}}{{/get}}
          </ul>

          <section class="podcast-most-listened" data-most-listened data-show="christians-reading-classics" hidden>
            <div class="section-intro section-intro-left">
              <p class="eyebrow">Most Listened</p>
              <h2 class="section-heading"><em>Listener favorites.</em></h2>
            </div>
            <ol class="podcast-most-listened-list" data-most-listened-list></ol>
          </section>

          {{#get "posts" filter="tag:hash-podcast-transcript+tag:christians-reading-classics" order="published_at desc" limit="all" include="authors"}}
            {{#if posts}}
              <section class="podcast-transcripts">
                <div class="section-intro section-intro-left">
                  <p class="eyebrow">Transcripts</p>
                  <h2 class="section-heading"><em>Read the conversation.</em></h2>
                </div>
                <div class="podcast-transcript-list">
                  {{#foreach posts}}
                    <a href="{{url}}" class="podcast-transcript-entry">
                      <h3 class="podcast-transcript-title"><em>{{title}}</em></h3>
                      <time class="podcast-transcript-date" datetime="{{date format="YYYY-MM-DD"}}">{{date format="MMMM D, YYYY"}}</time>
                    </a>
                  {{/foreach}}
                </div>
              </section>
            {{/if}}
          {{/get}}
        </aside>

      </div>
    </div>
  </section>

</main>

<script src="{{asset "js/podcast-feed.js"}}"></script>
{{#if @custom.membership_api_base}}
    <script src="{{asset "js/institution-push.js"}}"></script>
{{/if}}
