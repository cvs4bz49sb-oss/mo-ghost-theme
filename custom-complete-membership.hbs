            <button type="button" class="welcome-back" data-welcome-back hidden>Back</button>
            <button type="button" class="btn btn-primary welcome-next" data-welcome-next>Next</button>
            <a class="welcome-skip" href="/dashboard/" data-welcome-skip aria-label="Skip survey"><span class="welcome-lfull" aria-hidden="true">Skip survey</span><span class="welcome-labbr" aria-hidden="true">Skip</span></a>
          </span>
        </div>
      </div>

    </form>
  </div>
</main>

{{else}}
  <main class="membership membership-support">
    <section class="form-section">
      <div class="container">
        <div class="empty-state">
          <p class="eyebrow">Sign in needed</p>
          <h2><em>Please sign in</em> before completing your membership.</h2>
          <p>This page only works when you're signed in as a member. Check your inbox for the Mere Orthodoxy magic-link email, or <a href="#/portal/signin">sign in here</a>.</p>
        </div>
      </div>
    </section>
  </main>
{{/if}}
{{/match}}

