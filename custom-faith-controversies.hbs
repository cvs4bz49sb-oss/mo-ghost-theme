.tfr-tool .across-links{margin:0;font-size:.8rem}
.tfr-tool .next{display:grid;grid-template-columns:1fr 1fr;gap:1rem 2rem;margin:1.8rem 0 0;padding-top:.9rem;border-top:1px solid var(--border)}
