.tfr-tool .ap-who .run{display:inline-flex;align-items:baseline}
.tfr-tool .ap-who .run .dot{margin-right:.35rem}
.tfr-tool .ap-who b{font-weight:600;color:var(--fg);margin-right:.3rem}
