{{!< default}}

{{!-- HERO: most recent post as the featured card --}}
<section class="hero">
    <div class="container">
        <div class="hero-grid">
            <div class="hero-content">
                <p class="hero-kicker"><span class="dot"></span> A Reader-Supported Publication</p>
                <h1 class="hero-headline">
                    <span class="highlight">Christian Renewal</span><br />
                    <span class="hero-headline-tail"><em>for the Common Good.</em></span>
                </h1>
                <p class="hero-sub">Long-form essays, patient podcasts, and a quarterly print journal on theology, culture, and spiritual formation.</p>
                <div class="hero-ctas">
                    {{#match @member.status "paid"}}
                        <a href="/dashboard/" class="btn btn-primary btn-lg">Your Dashboard</a>
                    {{else}}{{#match @member.status "comped"}}
                        <a href="/dashboard/" class="btn btn-primary btn-lg">Your Dashboard</a>
                    {{else}}{{#if @member}}
                        {{!-- Free Subscriber: already on the list, so a single upgrade button. --}}
                        <a href="#join" class="btn btn-primary btn-lg">Become a Member</a>
                    {{else}}
                        {{!-- Anonymous visitor — primary CTA is now Membership. --}}
                        <a href="#join" class="btn btn-primary btn-lg">Become a Member</a>
                        <a href="#digest" class="btn btn-ghost btn-lg">Never Miss An Essay</a>
                    {{/if}}{{/match}}{{/match}}
                </div>
            </div>

            <div class="hero-visual">
                {{#get "posts" filter="tag:-hash-event" limit="1" include="authors,tags"}}
                    {{#foreach posts}}
                        <a href="{{url}}" class="hero-feature" style="text-decoration:none; color:inherit;">
                            <div class="hero-feature-img" aria-hidden="true">
                                <div class="hero-feature-img-inner"{{#if feature_image}} style="background-image: url({{img_url feature_image size="l"}});"{{/if}}></div>
                            </div>
                            <p class="eyebrow eyebrow--circled">
                                <span class="eyebrow-text">Latest</span>
                                <span class="eyebrow-circle" aria-hidden="true">
                                    <svg viewBox="0 0 240 80" preserveAspectRatio="none" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                                        <path d="M 22 50 C 16 22 78 12 122 14 C 178 16 226 28 222 46 C 218 66 154 76 106 72 C 54 68 14 60 26 42 C 34 28 64 24 92 24" />
                                    </svg>
                                </span>
                            </p>
                            <h3>{{title}}</h3>
                            <p class="byline">By <span class="byline-inline byline-inline--contributors" data-byline>{{#foreach tags}}<em class="byline-author byline-author--candidate" data-tag-slug="{{slug}}">{{name}}</em>{{/foreach}}</span><span class="byline-inline byline-inline--fallback">{{#primary_author}}<em>{{name}}</em>{{/primary_author}}</span> &middot; <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="MMMM D, YYYY"}}</time> &middot; {{reading_time minute="1 min read" minutes="% min read"}}</p>
                            {{#if custom_excerpt}}
                                <p class="excerpt">{{custom_excerpt}}</p>
                            {{else}}
                                <p class="excerpt">{{excerpt words="28"}}</p>
                            {{/if}}
                            <span class="read-link">Read the essay &rarr;</span>
                        </a>
                    {{/foreach}}
                {{/get}}
            </div>
        </div>
    </div>
</section>

{{> "topic-rail"}}

{{!-- TODAY: feature + most-read sidebar --}}
<section class="today">
    <div class="container">
        <div class="today-default">
            <div class="today-grid">
                <div class="today-main">
                    <div class="sidebar-heading">
                        <p class="eyebrow">Latest</p>
                        <h3><em>What's new</em></h3>
                    </div>
                    {{#get "posts" filter="tag:-hash-event" limit="2" include="authors,tags"}}
                        {{#foreach posts from="2" limit="1"}}
                            <a href="{{url}}" class="feature-entry">
                                <div class="feature-plate">
                                    <div class="feature-plate-inner"{{#if feature_image}} style="background-image: url({{img_url feature_image size="l"}});"{{/if}}></div>
                                </div>
                                <div class="feature-body">
                                    {{!-- Topic eyebrow: first non-author tag, selected via CSS
                                         attribute filter. See .entry-topic--candidates for the same
                                         pattern used in This Week. --}}
                                    <p class="feature-topic feature-topic--candidates" data-topic>
                                        {{#foreach tags visibility="public"}}<span class="feature-topic-tag" data-tag-slug="{{slug}}">{{name}}</span>{{/foreach}}
                                    </p>
                                    <h3 class="feature-title">{{title}}</h3>
                                    {{#if custom_excerpt}}
                                        <p class="feature-excerpt">{{custom_excerpt}}</p>
                                    {{else}}
                                        <p class="feature-excerpt">{{excerpt words="40"}}</p>
                                    {{/if}}
                                    <div class="feature-meta">
                                        <p class="feature-byline byline-inline--contributors" data-byline><span class="byline-prefix">By </span>{{#foreach tags}}<em class="byline-author byline-author--candidate" data-tag-slug="{{slug}}">{{name}}</em>{{/foreach}}</p>
                                        <p class="feature-byline byline-inline--fallback">{{#primary_author}}By <em>{{name}}</em>{{/primary_author}}</p>
                                        <p class="feature-date">{{date format="MMMM D"}} &middot; {{reading_time minute="1 min read" minutes="% min read"}}</p>
                                    </div>
                                </div>
                            </a>
                        {{/foreach}}
                    {{/get}}
                </div>

                <div class="today-sidebar">
                    <div class="sidebar-heading">
                        <p class="eyebrow">Must Reads</p>
                        <h3><em>This Month</em></h3>
                    </div>
                    {{!--
                        For now this list is populated from posts marked
                        `featured: true` in Ghost. In a future iteration we
                        will replace this {{#get}} call with a fetch from a
                        small Cloudflare Worker that queries Plausible for
                        top-read posts over the last 30 days and returns a
                        list of post slugs. Until that endpoint exists, the
                        "Most Read" label accurately reflects editorial
                        selection (featured) rather than analytics.
                    --}}
                    <ol class="read-list">
                        {{#get "posts" filter="featured:true+tag:-hash-event" limit="5" include="authors,tags"}}
                            {{#foreach posts}}
                                <li>
                                    <a href="{{url}}">
                                        {{!-- Cover-image plate, same chrome as .entry-plate
                                             in This Week (white backing, card border, sepia
                                             tint inside). Replaces the upper-roman counter
                                             that used to sit on the left edge. --}}
                                        <div class="read-plate" aria-hidden="true">
                                            <div class="read-plate-inner"{{#if feature_image}} style="background-image: url({{img_url feature_image size="s"}});"{{/if}}></div>
                                        </div>
                                        <div class="read-text">
                                            {{!-- Topic eyebrow: first non-author tag. --}}
                                            <p class="card-topic card-topic--candidates" data-topic>
                                                {{#foreach tags visibility="public"}}<span class="card-topic-tag" data-tag-slug="{{slug}}">{{name}}</span>{{/foreach}}
                                            </p>
                                            <h4 class="card-title"><em>{{title}}</em></h4>
                                            {{#if custom_excerpt}}
                                                <p class="card-excerpt">{{custom_excerpt}}</p>
                                            {{else}}
                                                <p class="card-excerpt">{{excerpt words="22"}}</p>
                                            {{/if}}
                                            <p class="card-byline">By <span class="byline-inline byline-inline--contributors" data-byline>{{#foreach tags}}<span class="author byline-author byline-author--candidate" data-tag-slug="{{slug}}">{{name}}</span>{{/foreach}}</span><span class="byline-inline byline-inline--fallback">{{#primary_author}}<span class="author">{{name}}</span>{{/primary_author}}</span> &middot; {{reading_time minute="1 min read" minutes="% min read"}}</p>
                                        </div>
                                    </a>
                                </li>
                            {{/foreach}}
                        {{/get}}
                    </ol>
                </div>
            </div>
        </div>

        <div class="today-tag" hidden></div>
    </div>
</section>

{{!-- WEEKLY DIGEST — state-aware.
     * paid / comped             → nothing (member already in)
     * free Subscriber           → simple Membership CTA scrolling to #join
     * signed-out visitor        → original digest signup --}}
{{#match @member.status "paid"}}{{else}}
{{#match @member.status "comped"}}{{else}}
{{#if @member}}
    {{!-- Free Subscriber upgrade pitch — styled inline in the
         same light container the digest CTA uses, so this block
         sits in rhythm with the rest of the homepage. --}}
    <section class="digest-section home-upgrade-section" id="digest" aria-label="Become a Member">
        <div class="container">
            <div class="digest-cta home-upgrade-cta">
                <div class="digest-copy">
                    <p class="eyebrow">For Subscribers</p>
                    <h3>Want More Mere Orthodoxy?</h3>
                    <p>You're on our free list. Members get everything below — plus our full print journal mailed to your door, four times a year.</p>
                </div>
                <div class="home-upgrade-body">
                    <ul class="home-upgrade-list">
                        <li>The quarterly print journal, mailed to your door</li>
                        <li>Private Discord community of serious readers</li>
                        <li>Ebook and events library</li>
                        <li>Monthly Mailbag from Jake Meador</li>
                        <li>Audio on every essay</li>
                        <li>Bookmarks</li>
                        <li>Church calendar site themes</li>
                        <li>Member Dashboard</li>
                    </ul>
                    <a href="#join" class="btn btn-primary btn-lg home-upgrade-btn">Become a Member</a>
                </div>
            </div>
        </div>
    </section>
{{else}}
    {{!-- Anonymous visitor — original digest signup. --}}
    {{> "digest-cta"}}
{{/if}}
{{/match}}
{{/match}}

{{!-- THIS WEEK: posts 3-8 --}}
<section class="this-week">
    <div class="container">
        <div class="section-intro">
            <p class="eyebrow">This Week</p>
            <h2 class="section-heading"><em>The wider conversation.</em></h2>
        </div>

        <div class="flourish">{{> "flourish-mark"}}</div>

        <div class="week-grid">
            {{#get "posts" filter="tag:-hash-event" limit="8" include="authors,tags"}}
                {{#foreach posts from="3" limit="6"}}
                    {{> "post-entry"}}
                {{/foreach}}
            {{/get}}
        </div>

        <div class="week-more">
            <a href="/archive/" class="week-more-link">Read more essays <span aria-hidden="true">&rarr;</span></a>
        </div>
    </div>
</section>

{{!-- PODCASTS: only rendered if a feed worker URL is configured --}}
{{#if @custom.podcast_feed_url}}
<section class="listen">
    <div class="container">
        <div class="section-intro">
            <p class="eyebrow">Listen</p>
            <h2 class="section-heading"><em>Patient conversations.</em></h2>
        </div>

        {{!-- The listen-grid is populated client-side by
             assets/js/podcast-feed.js, which merges both feeds from
             the Cloudflare Worker and renders the 4 most recent
             episodes across shows. The two static cards below are
             the fallback when the worker is unreachable. Per-show
             Apple/Spotify URLs come in via data-* attributes so the
             renderer can build the platform links without
             hardcoding. --}}
        <div class="listen-grid listen-grid--podcasts"
             data-mf-apple="https://podcasts.apple.com/us/podcast/mere-fidelity/id885758537"
             data-mf-spotify="https://open.spotify.com/show/2MO8K1HMGp9Y0PTZ7c07Tz"
             data-crc-apple="https://podcasts.apple.com/us/podcast/christians-reading-classics/id1832749498"
             data-crc-spotify="https://open.spotify.com/show/3h8zciESjSYUajDB9XJ9ni">
            <a href="#" class="pod-entry" data-show="mere-fidelity">
                <p class="pod-topic">Mere Fidelity</p>
                <h3 class="pod-title">Weekly conversations</h3>
                <p class="pod-excerpt">A weekly conversation on theology, culture, and the church.</p>
                <span class="pod-listen-link">Listen &rarr;</span>
            </a>
            <a href="#" class="pod-entry" data-show="christians-reading-classics">
                <p class="pod-topic">Christians Reading Classics</p>
                <h3 class="pod-title">A slow walk</h3>
                <p class="pod-excerpt">A slow walk through the great books of the Christian and classical tradition, one volume at a time.</p>
                <span class="pod-listen-link">Listen &rarr;</span>
            </a>
        </div>
    </div>
</section>
{{/if}}

{{!-- JOURNAL BAND --}}
<section class="journal-band" id="journal">
    <div class="container">
        <div class="journal-grid">
            <div class="journal-art" aria-hidden="true">
                <img src="{{asset "images/journal-hero.jpg"}}" alt="" class="journal-art-photo" />
            </div>
            <div class="journal-copy">
                <p class="eyebrow">The Print Journal</p>
                <h2><em>Ink and paper,<br />four times a year.</em></h2>
                <p>
                    A quarterly print journal of serious Protestant thought. Long essays, poetry, and criticism you will want to keep on the shelf. Mailed to members.
                </p>
                {{!-- Journal Status tracker. Current stage is set by
                     @custom.journal_status_stage (Drafting | In Production |
                     Arriving) in Ghost admin -> Design -> Customize. Ian
                     promotes the stage manually; when "Arriving" wraps,
                     he bumps the issue label in @custom.journal_status_issue
                     and sets the stage back to "Drafting" for the next cycle. --}}
                <h3 class="journal-status-section"><em>Journal Status</em></h3>
                <p class="journal-status-heading">Next Issue <span class="journal-status-sep" aria-hidden="true">|</span> <em data-journal-issue>&hellip;</em></p>
                {{!-- Lifecycle triptych: drafted page → bound book →
                     sealed letter. Currentcolor on every stroke/fill so
                     the .is-active class can flip the whole glyph from
                     muted outline to primary-orange + drop-shadow glow
                     via screen.css. --}}
                <ol class="journal-status" aria-label="Current journal status">
                    <li class="journal-status-step">
                        <span class="journal-status-mark" data-journal-stage="Drafting" aria-hidden="true">
                            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                {{!-- Quill: feather body as a leaf shape from the
                                     upper-right tip down to the base, with a center
                                     spine, a short nib continuation, and an ink stroke
                                     on the page beneath. --}}
                                <path d="M40 8 Q46 18 36 26 Q24 30 16 34 Q20 22 28 14 Q34 10 40 8 Z"/>
                                <path d="M38 10 L18 32" stroke-width="1"/>
                                <path d="M16 34 L12 38"/>
                                <line x1="12" y1="42" x2="32" y2="42"/>
                            </svg>
                        </span>
                        <span class="journal-status-label">Drafting</span>
                    </li>
                    <li class="journal-status-step">
                        <span class="journal-status-mark" data-journal-stage="In Production" aria-hidden="true">
                            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="12" y="8" width="24" height="32" rx="1"/>
                                <line x1="12" y1="16" x2="36" y2="16"/>
                                <line x1="12" y1="32" x2="36" y2="32"/>
                                <line x1="20" y1="24" x2="28" y2="24"/>
                            </svg>
                        </span>
                        <span class="journal-status-label">In Production</span>
                    </li>
                    <li class="journal-status-step">
                        <span class="journal-status-mark" data-journal-stage="Arriving" aria-hidden="true">
                            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="8" y="12" width="32" height="24" rx="1"/>
                                <path d="M8 12 L24 24 L40 12"/>
                                <circle cx="24" cy="30" r="3.5" fill="currentColor" stroke="none"/>
                            </svg>
                        </span>
                        <span class="journal-status-label">Arriving</span>
                    </li>
                </ol>
                <div class="journal-ctas">
                    {{#match @member.status "paid"}}
                        <a href="/give/" class="btn btn-primary btn-lg">Gift The Journal</a>
                    {{else}}{{#match @member.status "comped"}}
                        <a href="/give/" class="btn btn-primary btn-lg">Gift The Journal</a>
                    {{else}}{{#if @member}}
                        <a href="#join" class="btn btn-primary btn-lg">Get The Journal</a>
                    {{else}}
                        {{!-- Anonymous — primary CTA is the membership signup. --}}
                        <a href="#join" class="btn btn-primary btn-lg">Get The Journal</a>
                    {{/if}}{{/match}}{{/match}}
                </div>
            </div>
        </div>
    </div>
</section>

{{!--
    Readers / testimonials section. Currently static. In a future iteration
    these could be pulled from posts tagged `#testimonial` (internal tag) via
    a {{#get "posts" filter="tag:hash-testimonial"}} call and rendered here.
--}}
<section class="readers">
    <div class="container">
        <div class="section-intro">
            <p class="eyebrow">Readers</p>
            <h2 class="section-heading"><em>From our readers.</em></h2>
        </div>

        <blockquote class="reader-feature">
            Mere Orthodoxy is (for me) a counterpoint to social media, a place of depth and critical thought.
        </blockquote>

        <div class="readers-grid">
            <blockquote class="reader-quote">
                <p>The articles and podcasts have made the Protestant tradition more accessible to me, and helped me establish boundaries during this confusing and tumultuous era.</p>
            </blockquote>
            <blockquote class="reader-quote">
                <p>Thank you for offering thoughtful, reasonable and decent commentary. It is a boon to my sanity at this stage of my life.</p>
            </blockquote>
            <blockquote class="reader-quote">
                <p>I'm very grateful for the work of Mere Orthodoxy. It has been a genuine companion on my spiritual journey.</p>
            </blockquote>
        </div>
    </div>
</section>

{{!-- Full membership page content at the bottom of the homepage —
     shares partials/membership-body.hbs with /membership/. Wrapped in
     a div instead of <main> so it doesn't conflict with any main
     element used elsewhere on the page. --}}
<div class="membership homepage-membership" id="join">
  {{> "membership-body"}}
</div>
