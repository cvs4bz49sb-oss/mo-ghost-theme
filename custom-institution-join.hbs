{{!< default}}
{{#contentFor "moHead"}}
<title>Join Your Institution | Mere Orthodoxy</title>
<meta name="robots" content="noindex, nofollow" />
<meta name="description" content="Claim your Mere Orthodoxy access through your seminary, college, or organization." />
<meta property="og:title" content="Join Your Institution" />
<meta property="og:description" content="Claim your Mere Orthodoxy access through your seminary, college, or organization." />
<meta name="twitter:title" content="Join Your Institution" />
<meta name="twitter:description" content="Claim your Mere Orthodoxy access through your seminary, college, or organization." />
{{/contentFor}}
{{!-- /join/?i=<slug> — public institution signup landing page.
     Loads institution info via the membership API, validates the code,
     and signs the member up as a comped paid member. --}}

<main class="membership membership-support" data-institution-join data-api-base="{{@custom.membership_api_base}}">

  {{!-- Loading state --}}
  <section class="page-hero" data-join-loading>
    <div class="container">
      <p class="eyebrow">Organizational Access</p>
      <h1 class="page-hero-headline"><em>Loading...</em></h1>
    </div>
  </section>

  {{!-- Error state (institution not found, expired, etc.) --}}
  <section class="page-hero" data-join-error hidden>
    <div class="container">
      <p class="eyebrow">Organizational Access</p>
      <h1 class="page-hero-headline"><em>Not available</em></h1>
      <p class="page-hero-sub" data-join-error-msg>This organization link is not valid or has expired.</p>
    </div>
  </section>

  {{!-- Main content (shown after institution loads) --}}
  <div data-join-content hidden>
    <section class="page-hero">
      <div class="container">
        <p class="eyebrow">Organizational Access</p>
        <h1 class="page-hero-headline"><em data-join-name></em></h1>
        <p class="page-hero-sub" data-join-description></p>
      </div>
    </section>

    <section class="form-section">
      <div class="container">
        <div data-join-logo-wrap hidden style="text-align:center;margin-bottom:32px;">
          <img data-join-logo alt="" style="max-height:80px;max-width:280px;" />
        </div>

        <form class="stacked-form" data-join-form novalidate>
          <p class="form-intro">Enter your details and the access code provided by your organization.</p>

          <fieldset class="form-group">
            <legend class="form-legend">Your information</legend>
            <div class="form-row">
              <label class="form-field">
                <span class="form-label">First name</span>
                <input type="text" name="first_name" autocomplete="given-name" required />
              </label>
              <label class="form-field">
                <span class="form-label">Last name</span>
                <input type="text" name="last_name" autocomplete="family-name" required />
              </label>
            </div>
            <label class="form-field">
              <span class="form-label">Email</span>
              <input type="email" name="email" autocomplete="email" required />
            </label>
          </fieldset>

          {{!-- Not `required`: an organization can also admit anyone at an
               allowlisted email domain, in which case the code is optional.
               institution-join.js relaxes the hint when the API reports
               has_domains, and the worker is the real arbiter either way. --}}
          <fieldset class="form-group">
            <legend class="form-legend">Access code</legend>
            <label class="form-field">
              <span class="form-label">Code</span>
              <input type="text" name="code" autocomplete="off" placeholder="e.g. ABCD1234" style="font-family:monospace;font-size:1.1em;letter-spacing:2px;text-transform:uppercase;" />
              <span class="form-hint" data-join-code-hint>Provided by your organization's administrator.</span>
            </label>
          </fieldset>

          <p class="form-seats" data-join-seats hidden></p>

          <button type="submit" class="btn btn-pill btn-primary btn-wide" data-join-submit>
            <span class="btn-label">Sign up</span>
            <span class="btn-spinner" aria-hidden="true"></span>
          </button>
          <p class="btn-error" data-join-form-error role="alert"></p>
        </form>

        {{!-- Two outcomes. The membership is live in both, but the reader
             is only signed in once they open the emailed link, so the
             copy must not promise a session we have not given them. --}}
        <div data-join-success hidden>
          <div class="form-success">
            <h2>Check your email.</h2>
            <p data-join-emailed hidden>Your membership is active. We sent a sign-in link to the address you entered. Open it and you will land on your dashboard with full access to everything.</p>
            <p data-join-manual hidden>Your membership is active. Sign in with the address you entered and we will email you a one-click link.</p>
            <p class="form-hint" style="margin-top:12px;">The link can take a minute to arrive. If it does not, check your spam folder, or write to <a href="mailto:institutions@mereorthodoxy.com">institutions@mereorthodoxy.com</a>.</p>
            <a href="/" class="btn btn-pill btn-primary" style="margin-top:16px;">Back to the site</a>
          </div>
        </div>
      </div>
    </section>
  </div>

  <script src="{{asset "js/institution-join.js"}}"></script>
</main>
