{{!< default}}
{{!-- /dashboard/journals/ — paid-only journal archive. Gating mirrors
     the ebooks page: paid/comped/preview see the body partial;
     anyone else sees an upgrade prompt. --}}

<main class="dashboard">

  {{#unless @member}}
    <section class="hero dashboard-hero">
      <div class="container">
        <p class="hero-kicker"><span class="dot"></span> Member Dashboard</p>
        <h1 class="hero-headline">Sign in to open the <span class="highlight"><em>journal archive</em></span>.</h1>
        <p class="dashboard-actions">
          <a href="#/portal/signin" class="btn btn-primary" data-portal="signin">Sign in</a>
          <a href="/membership/" class="btn btn-ghost">Become a Member</a>
        </p>
      </div>
    </section>
  {{else}}

    {{#match @member.status "paid"}}{{> "dashboard-journals-body"}}{{else}}
    {{#match @member.status "comped"}}{{> "dashboard-journals-body"}}{{else}}
      <section class="hero dashboard-hero">
        <div class="container">
          <p class="hero-kicker"><span class="dot"></span> Member Dashboard</p>
          <h1 class="hero-headline">The journal archive is a <span class="highlight"><em>member feature</em></span>.</h1>
          <p>Become a Member to read every past issue of the Mere Orthodoxy print journal online — plus ebooks, event replays, the full archive, and audio on every essay.</p>
          <p class="dashboard-actions"><a href="/membership/" class="btn btn-primary">Become a Member</a></p>
        </div>
      </section>
    {{/match}}
    {{/match}}

  {{/unless}}

</main>
