{{!< default}}
{{#contentFor "moHead"}}
<title>Give a Lifetime Membership | Mere Orthodoxy</title>
<meta name="description" content="Give someone permanent access to Mere Orthodoxy, the quarterly print journal, and a copy of Jake Meador's In Search Of The Common Good. One payment of $995." />
<meta property="og:title" content="Give a Lifetime Membership" />
<meta property="og:description" content="Give someone permanent access to Mere Orthodoxy, the quarterly print journal, and a copy of Jake Meador's In Search Of The Common Good. One payment of $995." />
<meta property="og:image" content="{{asset "images/mo-share-card.jpg"}}" />
<meta name="twitter:title" content="Give a Lifetime Membership" />
<meta name="twitter:description" content="Give someone permanent access to Mere Orthodoxy, the quarterly print journal, and a copy of Jake Meador's In Search Of The Common Good. One payment of $995." />
<meta name="twitter:image" content="{{asset "images/mo-share-card.jpg"}}" />
{{/contentFor}}
{{!-- custom-gift-lifetime: the ONE gift product Ghost Portal cannot
     sell. Portal has no one-time or perpetual purchase, so this keeps
     the custom mo-membership checkout:
     POST /api/create-gift-checkout → Stripe Checkout (mode: payment)
     → webhook provisions a Ghost member with the lifetime labels.

     Everything from one month to a year now runs on Ghost's native
     gift subscriptions from /give/. This page is deliberately the only
     remaining caller of /api/create-gift-checkout, and it always sends
     tier "lifetime" (hidden input below). The worker no longer accepts
     "annual" from this endpoint.

     Route /give/lifetime/ is in routes.yaml but routes.yaml is
     excluded from the deploy zip, so it must be uploaded by hand in
     Ghost admin (Settings → Labs → Routes) or this page 404s. --}}

<main class="membership membership-support">

  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Give a Lifetime Membership</p>
      <h1 class="page-hero-headline">A membership that <em>does not end</em>.</h1>
      <p class="page-hero-sub">One payment of $995. Your recipient gets permanent access, the quarterly print journal for as long as we print it, and a copy of Jake Meador's <em>In Search Of The Common Good</em>. <a href="/give/">Shorter gifts start at $10</a>.</p>
    </div>
  </section>

  <section class="form-section">
    <div class="container">
      <form id="gift-form" class="stacked-form" novalidate>
        {{!-- Pinned, not chosen. gift.js serializes the whole form, so
             the worker reads its tier from here. --}}
        <input type="hidden" name="tier" value="lifetime" />

        <fieldset class="form-group">
          <legend class="form-legend">1. Your details</legend>
          <div class="form-row">
            <label class="form-field">
              <span class="form-label">Your name</span>
              <input type="text" name="purchaser_name" autocomplete="name" required />
            </label>
            <label class="form-field">
              <span class="form-label">Your email</span>
              <input type="email" name="purchaser_email" autocomplete="email" required />
            </label>
          </div>
        </fieldset>

        <fieldset class="form-group">
          <legend class="form-legend">2. Recipient</legend>
          <div class="form-row">
            <label class="form-field">
              <span class="form-label">Recipient name</span>
              <input type="text" name="recipient_name" required />
            </label>
            <label class="form-field">
              <span class="form-label">Recipient email</span>
              <input type="email" name="recipient_email" required />
            </label>
          </div>
          <label class="form-field">
            <span class="form-label">Personal message <span class="form-hint">(optional, 500 characters max)</span></span>
            <textarea name="message" maxlength="500" rows="4" placeholder="A line or two that goes in the gift email."></textarea>
          </label>
          <label class="form-field">
            <span class="form-label">Deliver on</span>
            {{!-- min/max are set by gift.js from LOCAL date parts. Not
                 a Handlebars literal (Ghost caches the page and it goes
                 stale overnight) and not toISOString() (UTC, which
                 blocks same-day gifts for US visitors after 6pm). --}}
            <input type="date" name="deliver_at" data-gift-deliver-at />
            <span class="form-hint">Leave blank to send immediately. Lifetime gifts are set up as soon as they are delivered, so there is nothing for your recipient to claim.</span>
          </label>
        </fieldset>

        {{!-- Recipient shipping address. Optional. If the purchaser
             doesn't know it, the recipient can add it from /manage/
             after the gift lands. The print journal is mailed to
             whatever's on file quarterly. --}}
        <fieldset class="form-group">
          <legend class="form-legend">3. Where to mail the print journal <span class="form-hint">(optional)</span></legend>
          <p class="form-intro">Mere Orthodoxy members receive the quarterly print journal. If you know your recipient's address, drop it in here. Otherwise leave it blank and we will ask them.</p>
          <label class="form-field">
            <span class="form-label">Street</span>
            <input type="text" name="recipient_line1" autocomplete="address-line1" />
          </label>
          <label class="form-field">
            <span class="form-label">Apartment, suite, or unit <span class="form-hint">(optional)</span></span>
            <input type="text" name="recipient_line2" autocomplete="address-line2" />
          </label>
          <div class="form-row">
            <label class="form-field">
              <span class="form-label">City</span>
              <input type="text" name="recipient_city" autocomplete="address-level2" />
            </label>
            <label class="form-field">
              <span class="form-label">State / Province</span>
              <input type="text" name="recipient_state" autocomplete="address-level1" maxlength="3" />
            </label>
          </div>
          <div class="form-row">
            <label class="form-field">
              <span class="form-label">ZIP / Postal code</span>
              <input type="text" name="recipient_postal_code" autocomplete="postal-code" />
