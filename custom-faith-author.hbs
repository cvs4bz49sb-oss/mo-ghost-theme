{{!-- /the-faith-received/author/?a=<folded-name>

     One page per author, rendered at read time by faith-author.js.
     There are well over fourteen thousand names across the seven
     collections and they change whenever the source republishes, so
     generating a template each is not the shape of this problem.

     Built on the room hero so an author reads as a place in the
     library rather than as a search result. --}}

<main class="faith-received faith-author-page">

  <section class="bhero bhero--tool bhero--author">
    <div class="bhero-inner container">
      <p class="bhero-kicker">The Faith Received &middot; Author</p>
      <h1 data-faith-author-name>Loading&hellip;</h1>
    </div>
  </section>

  <section class="bband faith-author-body">
    <div class="container" data-faith-author>
      <p class="faith-author-empty">Loading&hellip;</p>
    </div>
  </section>

</main>

