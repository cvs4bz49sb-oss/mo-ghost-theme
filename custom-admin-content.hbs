{{!< default}}
{{#contentFor "moHead"}}
<title>Content Calendar | MO Admin</title>
<meta name="robots" content="noindex, nofollow" />
<meta name="description" content="Internal Mere Orthodoxy staff tool." />
<meta property="og:title" content="Content Calendar | MO Admin" />
<meta property="og:description" content="Internal Mere Orthodoxy staff tool." />
<meta name="twitter:title" content="Content Calendar | MO Admin" />
<meta name="twitter:description" content="Internal Mere Orthodoxy staff tool." />
{{/contentFor}}
{{!-- /admin/content/ — Content Calendar. Weekly editorial calendar
     showing what's scheduled across all projects. Internal sidebar
     lists projects and podcasts; main area shows a day-by-day week
     view with filters. Data stored in localStorage with optional
     Asana import. --}}

<main class="admin-page admin-workspace">

  {{#if @member}}

    {{> "admin-sidebar" active="content"}}
    <div class="admin-main">
      <header class="admin-topbar">
        <h1 class="admin-topbar-title"><em>Content Calendar</em></h1>
        <p class="admin-topbar-sub">What's happening across the publication, week by week. <span class="cc-sync cc-sync--idle" data-cc-sync>Saved</span></p>
      </header>

      <section class="admin-body" style="padding:0;">
        <div class="cc-layout" data-cc-root>

          {{!-- Internal sidebar --}}
          <aside class="cc-sidebar">
            <div class="cc-sidebar-inner">

              <div class="cc-sidebar-section">
                <div class="cc-sidebar-section-head">
                  <span class="cc-sidebar-section-label">Projects</span>
                  <button type="button" class="cc-sidebar-action" data-cc-add-project title="Add project">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                  </button>
                </div>

                <div data-cc-group="operations">
                  <button type="button" class="cc-sidebar-group-toggle" data-cc-toggle-group="operations">
                    <svg class="cc-sidebar-caret" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
                    <span class="cc-sidebar-group-label">Operations</span>
                    <span class="cc-sidebar-group-count" data-cc-count="operations"></span>
                  </button>
                  <ul class="cc-sidebar-list" data-cc-list="operations"></ul>
                </div>

                <div data-cc-group="podcasts">
                  <button type="button" class="cc-sidebar-group-toggle" data-cc-toggle-group="podcasts">
                    <svg class="cc-sidebar-caret" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
                    <span class="cc-sidebar-group-label">Podcasts</span>
                    <span class="cc-sidebar-group-count" data-cc-count="podcasts"></span>
                  </button>
                  <ul class="cc-sidebar-list" data-cc-list="podcasts"></ul>
                </div>
              </div>

              <div class="cc-sidebar-foot">
                <button type="button" class="cc-sidebar-foot-btn" data-cc-sync-podcasts>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"></polyline><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path></svg>
                  Sync Podcasts
                </button>
                <button type="button" class="cc-sidebar-foot-btn" data-cc-import-asana>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
                  Import from Asana
                </button>
                <button type="button" class="cc-sidebar-foot-btn" data-cc-categories>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
                  Categories
                </button>
                <button type="button" class="cc-sidebar-foot-btn" data-cc-settings>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                  Settings
                </button>
              </div>

            </div>
          </aside>

          {{!-- Calendar main — head + filters + grid are rendered by admin-content.js --}}
          <div class="cc-main">
            <div class="cc-main-head" data-cc-main-head></div>

            <div class="cc-filters">
              <div class="cc-filter" data-cc-filter="project">
                <button type="button" class="cc-filter-btn">Project <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg></button>
                <div class="cc-filter-dropdown"></div>
              </div>
              <div class="cc-filter" data-cc-filter="type">
                <button type="button" class="cc-filter-btn">Content Type <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg></button>
                <div class="cc-filter-dropdown"></div>
              </div>
              <div class="cc-filter" data-cc-filter="person">
                <button type="button" class="cc-filter-btn">Person <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg></button>
                <div class="cc-filter-dropdown"></div>
              </div>
              <div class="cc-filter" data-cc-filter="status">
                <button type="button" class="cc-filter-btn">Status <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg></button>
                <div class="cc-filter-dropdown"></div>
              </div>
            </div>

            <div class="cc-days" data-cc-days></div>

          </div>

        </div>
      </section>

    </div>

  {{else}}
    {{> "admin-denied"}}
  {{/if}}

</main>

<script src="{{asset "js/admin-sidebar.js"}}"></script>
<script src="{{asset "js/admin-mentions.js"}}"></script>
<script src="{{asset "js/admin-content.js"}}"></script>
