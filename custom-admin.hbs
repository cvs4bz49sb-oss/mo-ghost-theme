{{!< default}}
{{!-- /admin/ — admin dashboard shell. Page skeleton renders for any
     signed-in member; the mo-admin worker gates by Ghost staff
     membership when stats are fetched. --}}

<main class="admin-page admin-workspace">

  {{#if @member}}
    {{> "admin-landing"}}
  {{else}}
    {{> "admin-denied"}}
  {{/if}}

</main>

<script src="{{asset "js/admin-sidebar.js"}}"></script>
