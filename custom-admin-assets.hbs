{{!< default}}
{{#contentFor "moHead"}}
<title>Social Assets | MO Admin</title>
<meta name="robots" content="noindex, nofollow" />
<meta name="description" content="Internal Mere Orthodoxy staff tool." />
<meta property="og:title" content="Social Assets | MO Admin" />
<meta property="og:description" content="Internal Mere Orthodoxy staff tool." />
<meta name="twitter:title" content="Social Assets | MO Admin" />
<meta name="twitter:description" content="Internal Mere Orthodoxy staff tool." />
{{/contentFor}}
{{!-- /admin/assets/ — Social media asset creator.
     Layer-based canvas editor for Instagram carousels (1080x1350,
     up to 12 panels) and stories (1080x1920). Every element on the
     canvas is a layer that can be dragged, resized, reordered, and
     deleted. Text layers carry inline bold/italic/underline markup.
     Templates are presets that seed layers, not fixed renderers.
     Pull article content from Ghost Content API via URL. --}}

<main class="admin-page admin-workspace">

  {{#if @member}}

    {{> "admin-sidebar" active="assets"}}
    <div class="admin-main">
      <header class="admin-topbar">
        <h1 class="admin-topbar-title"><em>Social Assets</em></h1>
        <p class="admin-topbar-sub">Create branded carousel and story images for Instagram.</p>
      </header>

      <section class="admin-body">
        <div class="container">

          <div class="asset-creator"
               data-asset-creator
               {{#if @custom.content_api_key}}data-content-api-key="{{@custom.content_api_key}}"{{/if}}
               data-site-url="{{@site.url}}">

            {{!-- Size + article pull toolbar --}}
            <div class="asset-toolbar">
              <div class="asset-toolbar-modes" data-asset-modes>
                <button type="button" class="asset-mode-btn is-active" data-asset-mode="carousel">Carousel <span class="asset-mode-dim">IG &middot; 1080&times;1350</span></button>
                <button type="button" class="asset-mode-btn" data-asset-mode="square">Square <span class="asset-mode-dim">IG &middot; 1080&times;1080</span></button>
                <button type="button" class="asset-mode-btn" data-asset-mode="story">Story <span class="asset-mode-dim">IG &middot; 1080&times;1920</span></button>
                <button type="button" class="asset-mode-btn" data-asset-mode="x">X <span class="asset-mode-dim">1600&times;900</span></button>
                <button type="button" class="asset-mode-btn" data-asset-mode="linkedin">LinkedIn <span class="asset-mode-dim">1200&times;627</span></button>
                <button type="button" class="asset-mode-btn" data-asset-mode="facebook">Facebook <span class="asset-mode-dim">1200&times;630</span></button>
              </div>
              <div class="asset-toolbar-pull">
                <input type="text" class="asset-url-input" data-asset-url placeholder="Paste article URL to pull title, author, and image..." />
                <button type="button" class="btn btn-primary btn-sm" data-asset-pull>Pull</button>
              </div>
            </div>

            <div class="asset-workspace">

              {{!-- Left rail: canvas settings, layer list, inspector --}}
              <aside class="asset-settings">

                <div class="asset-settings-group">
                  <p class="asset-settings-label">Template</p>
                  <div class="asset-template-grid" data-asset-templates>
                    <button type="button" class="asset-template-btn is-active" data-template="title-card" title="Title card">Title</button>
                    <button type="button" class="asset-template-btn" data-template="quote-card" title="Quote card">Quote</button>
                    <button type="button" class="asset-template-btn" data-template="image-card" title="Image + text">Image</button>
                    <button type="button" class="asset-template-btn" data-template="text-card" title="Body text">Text</button>
                    <button type="button" class="asset-template-btn" data-template="cta-card" title="Call to action">CTA</button>
                    <button type="button" class="asset-template-btn" data-template="blank" title="Blank canvas">Blank</button>
                  </div>
                  <p class="asset-hint">Templates lay out fresh layers. Everything after that is yours to move.</p>
                </div>

                <div class="asset-settings-group">
                  <p class="asset-settings-label">Background</p>
                  <div class="asset-color-swatches" data-asset-bg-swatches>
                    <button type="button" class="asset-swatch is-active" data-bg="#1d1b18" style="background:#1d1b18" title="Dark"></button>
                    <button type="button" class="asset-swatch" data-bg="#f1e0c9" style="background:#f1e0c9" title="Warm"></button>
                    <button type="button" class="asset-swatch" data-bg="#f6f3f2" style="background:#f6f3f2" title="Light"></button>
                    <button type="button" class="asset-swatch" data-bg="#ee7d51" style="background:#ee7d51" title="Orange"></button>
                    <button type="button" class="asset-swatch" data-bg="#2d2927" style="background:#2d2927" title="Charcoal"></button>
                    <button type="button" class="asset-swatch" data-bg="#c1593c" style="background:#c1593c" title="Rust"></button>
                  </div>
                  <label class="asset-settings-field">
                    <span class="asset-settings-field-label">Custom</span>
                    <input type="color" data-asset-bg-custom value="#1d1b18" />
                  </label>
                </div>

                {{!-- Layer stack --}}
                <div class="asset-settings-group">
                  <div class="asset-settings-head">
                    <p class="asset-settings-label">Layers</p>
                    <button type="button" class="asset-mini-btn" data-asset-arrange title="Pull everything inside the safe area and re-stack with even spacing">Auto-space</button>
                  </div>
                  <div class="asset-add-row">
                    <button type="button" class="asset-add-btn" data-asset-add="text">+ Text</button>
                    <button type="button" class="asset-add-btn" data-asset-add="image">+ Image</button>
                    <button type="button" class="asset-add-btn" data-asset-add="rule">+ Rule</button>
                    <button type="button" class="asset-add-btn" data-asset-add="box">+ Box</button>
                    <button type="button" class="asset-add-btn" data-asset-add="scrim">+ Scrim</button>
                  </div>
                  <input type="file" accept="image/*" data-asset-layer-file hidden />
                  <ul class="asset-layer-list" data-asset-layer-list></ul>
                  <p class="asset-hint">Drag on the canvas to move. Handles resize. Delete key removes.</p>
                </div>

                {{!-- Inspector for the selected layer --}}
                <div class="asset-settings-group asset-inspector" data-asset-inspector hidden>
                  <div class="asset-settings-head">
                    <p class="asset-settings-label" data-asset-insp-title>Layer</p>
                    <button type="button" class="asset-mini-btn" data-asset-duplicate title="Duplicate layer">Duplicate</button>
                  </div>

                  {{!-- Text content + formatting --}}
                  <div class="asset-insp-block" data-for="text">
                    <div class="asset-format-bar">
                      <button type="button" class="asset-fmt-btn" data-asset-fmt="bold" title="Bold (Cmd+B)"><strong>B</strong></button>
                      <button type="button" class="asset-fmt-btn" data-asset-fmt="italic" title="Italic (Cmd+I)"><em>I</em></button>
                      <button type="button" class="asset-fmt-btn" data-asset-fmt="underline" title="Underline (Cmd+U)"><u>U</u></button>
                      <span class="asset-format-sep"></span>
                      <button type="button" class="asset-fmt-btn asset-fmt-toggle" data-asset-style="bold" title="Bold whole layer">B<span class="asset-fmt-dim">all</span></button>
                      <button type="button" class="asset-fmt-btn asset-fmt-toggle" data-asset-style="italic" title="Italic whole layer">I<span class="asset-fmt-dim">all</span></button>
                      <button type="button" class="asset-fmt-btn asset-fmt-toggle" data-asset-style="caps" title="All caps">AA</button>
                    </div>
                    <textarea class="asset-layer-text" data-asset-layer-text rows="4" placeholder="Layer text..."></textarea>
                    <p class="asset-hint">Wrap words in <code>**bold**</code>, <code>*italic*</code>, or <code>__underline__</code>. Enter makes a new line.</p>

                    <label class="asset-settings-field">
                      <span class="asset-settings-field-label">Typeface</span>
                      <select data-asset-prop="font">
                        <option value="display">Display italic (IM Fell)</option>
                        <option value="body">Body (Source Serif)</option>
                      </select>
                    </label>

                    <div class="asset-align-row" data-asset-align>
                      <span class="asset-settings-field-label">Align</span>
                      <div class="asset-align-btns">
                        <button type="button" class="asset-mini-btn" data-align="left">Left</button>
                        <button type="button" class="asset-mini-btn" data-align="center">Center</button>
                        <button type="button" class="asset-mini-btn" data-align="right">Right</button>
                      </div>
                    </div>

                    <label class="asset-settings-field">
                      <span class="asset-settings-field-label">Size <span class="asset-settings-field-value" data-val="size"></span></span>
                      <input type="range" data-asset-prop="size" min="10" max="220" step="1" />
                    </label>
                    <label class="asset-settings-field">
                      <span class="asset-settings-field-label">Line spacing <span class="asset-settings-field-value" data-val="lineHeight"></span></span>
                      <input type="range" data-asset-prop="lineHeight" min="0.8" max="2.6" step="0.02" />
                    </label>
                    <label class="asset-settings-field">
                      <span class="asset-settings-field-label">Letter spacing <span class="asset-settings-field-value" data-val="tracking"></span></span>
                      <input type="range" data-asset-prop="tracking" min="-4" max="24" step="0.5" />
                    </label>
                  </div>

                  {{!-- Rule --}}
                  <div class="asset-insp-block" data-for="rule">
                    <label class="asset-settings-field">
                      <span class="asset-settings-field-label">Thickness <span class="asset-settings-field-value" data-val="thickness"></span></span>
                      <input type="range" data-asset-prop="thickness" min="1" max="24" step="1" />
                    </label>
                  </div>

                  {{!-- Box / scrim --}}
                  <div class="asset-insp-block" data-for="box scrim">
                    <label class="asset-settings-field">
                      <span class="asset-settings-field-label">Corner radius <span class="asset-settings-field-value" data-val="radius"></span></span>
                      <input type="range" data-asset-prop="radius" min="0" max="200" step="1" />
                    </label>
                  </div>
                  <div class="asset-insp-block" data-for="scrim">
                    <label class="asset-settings-field">
                      <span class="asset-settings-field-label">Fade direction</span>
                      <select data-asset-prop="direction">
                        <option value="up">Dark at bottom</option>
                        <option value="down">Dark at top</option>
                      </select>
                    </label>
                  </div>

                  {{!-- Image --}}
                  <div class="asset-insp-block" data-for="image">
                    <div class="asset-image-controls">
                      <button type="button" class="btn btn-ghost btn-sm" data-asset-image-replace>Replace image</button>
                    </div>
                    <label class="asset-settings-field">
                      <span class="asset-settings-field-label">Corner radius <span class="asset-settings-field-value" data-val="radius"></span></span>
                      <input type="range" data-asset-prop="radius" min="0" max="200" step="1" />
                    </label>
                    <label class="asset-settings-field">
                      <span class="asset-settings-field-label">Fill zoom <span class="asset-settings-field-value" data-val="zoom"></span></span>
                      <input type="range" data-asset-prop="zoom" min="1" max="3" step="0.02" />
                    </label>
                    <div class="asset-nudge-row">
                      <span class="asset-settings-field-label">Nudge crop</span>
                      <div class="asset-align-btns">
                        <button type="button" class="asset-mini-btn" data-crop="up">&uarr;</button>
                        <button type="button" class="asset-mini-btn" data-crop="down">&darr;</button>
                        <button type="button" class="asset-mini-btn" data-crop="left">&larr;</button>
                        <button type="button" class="asset-mini-btn" data-crop="right">&rarr;</button>
                        <button type="button" class="asset-mini-btn" data-crop="reset">Reset</button>
                      </div>
                    </div>
                  </div>

                  {{!-- Shared: colour, opacity, geometry --}}
                  <div class="asset-insp-block" data-for="text rule box scrim">
                    <p class="asset-settings-label">Colour</p>
                    <div class="asset-color-swatches" data-asset-layer-swatches>
                      <button type="button" class="asset-swatch" data-color="#ffffff" style="background:#ffffff" title="White"></button>
                      <button type="button" class="asset-swatch" data-color="#1d1b18" style="background:#1d1b18" title="Dark"></button>
                      <button type="button" class="asset-swatch" data-color="#ee7d51" style="background:#ee7d51" title="Orange"></button>
                      <button type="button" class="asset-swatch" data-color="#f1e0c9" style="background:#f1e0c9" title="Warm"></button>
                      <button type="button" class="asset-swatch" data-color="#c1593c" style="background:#c1593c" title="Rust"></button>
                    </div>
                    <label class="asset-settings-field">
                      <span class="asset-settings-field-label">Custom</span>
                      <input type="color" data-asset-prop="color" />
                    </label>
                  </div>

                  <div class="asset-insp-block" data-for="text image rule box scrim">
                    <label class="asset-settings-field">
                      <span class="asset-settings-field-label">Opacity <span class="asset-settings-field-value" data-val="opacity"></span></span>
                      <input type="range" data-asset-prop="opacity" min="0" max="100" step="1" />
                    </label>
                    <div class="asset-xy-grid">
                      <label class="asset-settings-field">
                        <span class="asset-settings-field-label">X</span>
                        <input type="number" data-asset-prop="x" step="1" />
                      </label>
                      <label class="asset-settings-field">
                        <span class="asset-settings-field-label">Y</span>
                        <input type="number" data-asset-prop="y" step="1" />
                      </label>
                      <label class="asset-settings-field">
                        <span class="asset-settings-field-label">Width</span>
                        <input type="number" data-asset-prop="w" step="1" />
                      </label>
                      <label class="asset-settings-field" data-for="image box scrim">
                        <span class="asset-settings-field-label">Height</span>
                        <input type="number" data-asset-prop="h" step="1" />
                      </label>
                    </div>
                    <div class="asset-align-btns asset-align-btns--wrap">
                      <button type="button" class="asset-mini-btn" data-asset-center="h" title="Centre horizontally on the canvas">Centre &harr;</button>
                      <button type="button" class="asset-mini-btn" data-asset-center="v" title="Centre vertically on the canvas">Centre &updownarrow;</button>
                      <button type="button" class="asset-mini-btn" data-asset-fullbleed title="Fill the whole canvas">Full bleed</button>
                    </div>
                  </div>

                  <div class="asset-insp-actions">
                    <button type="button" class="btn btn-danger btn-sm" data-asset-delete-layer>Delete layer</button>
                  </div>
                </div>

              </aside>

              {{!-- Canvas preview --}}
              <div class="asset-preview">
                <div class="asset-canvas-wrap" data-asset-canvas-wrap>
                  <canvas data-asset-canvas width="1080" height="1350" tabindex="0"></canvas>
                </div>

                {{!-- Carousel panel navigation --}}
                <div class="asset-panels" data-asset-panels>
                  <div class="asset-panels-strip" data-asset-panel-strip>
                    <button type="button" class="asset-panel-thumb is-active" data-panel-idx="0">1</button>
                  </div>
                  <button type="button" class="asset-panel-add" data-asset-panel-add title="Add panel">+</button>
                  <button type="button" class="asset-panel-remove" data-asset-panel-remove title="Remove current panel">&minus;</button>
                </div>

                <div class="asset-actions">
                  <button type="button" class="btn btn-primary" data-asset-export>Download this panel</button>
                  <button type="button" class="btn btn-dark" data-asset-export-all>Download all panels</button>
                </div>

                <p class="asset-safe-warn" data-asset-safe-warn role="status" aria-live="polite" hidden></p>
                <p class="asset-status" data-asset-status role="status" aria-live="polite" hidden></p>
              </div>

            </div>

          </div>

        </div>
      </section>

    </div>

  {{else}}
    {{> "admin-denied"}}
  {{/if}}

</main>

<script src="{{asset "js/admin-auth.js"}}"></script>
<script src="{{asset "js/admin-sidebar.js"}}"></script>
<script src="{{asset "js/admin-assets.js"}}"></script>
