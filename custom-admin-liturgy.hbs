{{!< default}}
{{!-- /admin/liturgy/ — Daily Liturgy manager. Calendar of days backed by the
     mo-kit content store (proxied through mo-admin). Edit a day's content,
     preview the rendered email, schedule/unschedule, and send yourself a
     test. Auth: MOAuth.fetch (Ghost staff JWT); server gates by staff. --}}

<main class="admin-page admin-workspace">

  {{#if @member}}

    {{> "admin-sidebar" active="liturgy"}}
    <div class="admin-main">
      <header class="admin-topbar">
        <h1 class="admin-topbar-title"><em>Daily Liturgy</em></h1>
        <p class="admin-topbar-sub">Write, schedule, and preview the daily devotional. <span class="lit-sync" data-lit-sync>Ready</span></p>
      </header>

      <section class="admin-body lit-app" data-lit-app data-worker-url="{{@custom.admin_worker_url}}">

        <div class="lit-toolbar">
          <div class="lit-monthnav">
            <button type="button" class="lit-navbtn" data-lit-prev aria-label="Previous month">‹</button>
            <span class="lit-month-label" data-lit-month-label>—</span>
            <button type="button" class="lit-navbtn" data-lit-next aria-label="Next month">›</button>
          </div>
          <div class="lit-toolbar-right">
            <div class="lit-legend">
              <span><i class="lit-dot lit-dot--ready"></i>Ready</span>
              <span><i class="lit-dot lit-dot--draft"></i>Draft</span>
              <span><i class="lit-dot lit-dot--scheduled"></i>Scheduled</span>
              <span><i class="lit-dot lit-dot--sent"></i>Sent</span>
            </div>
            <button type="button" class="btn btn-primary btn-sm" data-lit-generate>Generate &amp; Schedule Week</button>
            <button type="button" class="btn btn-outline btn-sm" data-lit-schedule-month>Schedule all drafts</button>
          </div>
        </div>

        <div class="lit-layout">

          <div class="lit-list-wrap">
            <div class="lit-list" data-lit-list>
              <p class="lit-empty">Loading…</p>
            </div>
          </div>

          <p class="lit-editor-hint" data-lit-hint>Select a day to write its liturgy, preview the email, and schedule it.</p>

          <div class="lit-editor" data-lit-editor hidden>
            <div class="lit-editor-head">
              <div>
                <p class="lit-editor-date" data-lit-editor-date></p>
                <span class="lit-badge" data-lit-editor-state></span>
                <span class="lit-editor-save" data-lit-save role="status" aria-live="polite"></span>
              </div>
              <button type="button" class="lit-close" data-lit-close aria-label="Close editor">×</button>
            </div>

            <label class="lit-field">
              <span class="lit-field-label">Subject line</span>
              <input type="text" data-lit-subject placeholder="The Feast of the Transfiguration" />
            </label>
            <label class="lit-field">
              <span class="lit-field-label">Inbox preview</span>
              <input type="text" data-lit-preview placeholder="A short order of morning prayer." />
            </label>
            <label class="lit-field">
              <span class="lit-field-label">Body <em>(Markdown — ### for section labels, &gt; for Scripture)</em></span>
              <textarea data-lit-body rows="14" spellcheck="true" placeholder="### Call to Worship&#10;…"></textarea>
            </label>

            <div class="lit-actions">
              <button type="button" class="btn btn-primary btn-sm" data-lit-schedule>Schedule</button>
              <button type="button" class="btn btn-outline btn-sm" data-lit-unschedule hidden>Unschedule</button>
              <button type="button" class="btn btn-ghost btn-sm" data-lit-test>Send me a test</button>
              <span class="lit-action-status" data-lit-action-status role="status" aria-live="polite"></span>
            </div>

            <div class="lit-preview">
              <p class="lit-preview-label">Preview <em>— how the email renders</em></p>
              <iframe class="lit-preview-frame" data-lit-frame title="Email preview" sandbox="allow-same-origin"></iframe>
            </div>
          </div>

        </div>
      </section>
    </div>

  {{else}}
    {{> "admin-denied"}}
  {{/if}}

</main>

<style>
  .lit-app { padding: 0; }
  .lit-sync { font-size: 12px; color: var(--color-muted, #6b6660); margin-left: 6px; }
  .lit-sync.is-saving { color: var(--color-primary, #ee7d51); }
  .lit-sync.is-error { color: #c0392b; }

  .lit-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding: 14px 20px; border-bottom: 1px solid var(--color-rule, #d9c6a7); flex-wrap: wrap; }
  .lit-monthnav { display: flex; align-items: center; gap: 10px; }
  .lit-navbtn { width: 38px; height: 38px; border: 1px solid var(--color-rule, #d9c6a7);
    background: var(--color-white, #fff); border-radius: 8px; cursor: pointer; font-size: 18px;
    line-height: 1; color: var(--color-dark, #2d2927); }
  .lit-navbtn:hover { border-color: var(--color-primary, #ee7d51); }
  .lit-month-label { font-family: var(--font-display, Georgia, serif); font-style: italic;
    font-size: 20px; min-width: 170px; text-align: center; color: var(--color-dark, #2d2927); }
  .lit-toolbar-right { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; }
  .lit-legend { display: flex; gap: 14px; font-size: 12px; color: var(--color-muted, #6b6660); }
  .lit-legend span { display: inline-flex; align-items: center; gap: 5px; }
  .lit-dot { width: 9px; height: 9px; border-radius: 50%; display: inline-block; }
  .lit-dot--ready { background: #8a8f98; }
  .lit-dot--draft { background: #d9a441; }
  .lit-dot--scheduled { background: #4a9460; }
  .lit-dot--sent { background: #b9b4ab; }
  .btn-sm { padding: 7px 14px; font-size: 12px; letter-spacing: 0.04em; }

  .lit-layout { display: grid; grid-template-columns: minmax(280px, 360px) 1fr; gap: 0; min-height: 60vh; }
  .lit-list-wrap { border-right: 1px solid var(--color-rule, #d9c6a7); overflow-y: auto; max-height: 78vh; }
  .lit-list { display: flex; flex-direction: column; }
  .lit-empty { padding: 24px 20px; color: var(--color-muted, #6b6660); font-size: 14px; }

  .lit-row { display: flex; align-items: center; gap: 12px; padding: 12px 18px; cursor: pointer;
    border-bottom: 1px solid rgba(217,198,167,0.45); text-align: left; background: none; border-left: 3px solid transparent; }
  .lit-row:hover { background: rgba(238,125,81,0.06); }
  .lit-row.is-active { background: rgba(238,125,81,0.10); border-left-color: var(--color-primary, #ee7d51); }
  .lit-row-date { display: flex; flex-direction: column; min-width: 44px; }
  .lit-row-dow { font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-muted, #6b6660); }
  .lit-row-day { font-family: var(--font-display, Georgia, serif); font-size: 22px; font-style: italic; line-height: 1; color: var(--color-dark, #2d2927); }
  .lit-row-main { flex: 1; min-width: 0; }
  .lit-row-subject { font-size: 14px; color: var(--color-dark, #2d2927); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .lit-row-subject.is-empty { color: #b9b4ab; font-style: italic; }
  .lit-row-state { font-size: 11px; margin-top: 2px; }
  .lit-badge { display: inline-block; padding: 2px 9px; border-radius: 999px; font-size: 11px; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.04em; }
  .lit-badge--empty { background: #f0ece4; color: #9a948a; }
  .lit-badge--ready { background: #eceef1; color: #586069; }
  .lit-badge--draft { background: #f7ecd2; color: #9a7320; }
  .lit-badge--scheduled { background: #dff0e4; color: #2f6b44; }
  .lit-badge--sent { background: #efece7; color: #8a8479; }

  .lit-editor-hint { padding: 40px 26px; color: var(--color-muted, #6b6660); font-size: 14px;
    font-style: italic; max-width: 380px; }
  .lit-editor { padding: 22px 26px; overflow-y: auto; max-height: 78vh; }
  .lit-editor-head { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 18px; }
  .lit-editor-date { font-family: var(--font-display, Georgia, serif); font-style: italic; font-size: 22px;
    margin: 0 0 6px; color: var(--color-dark, #2d2927); }
  .lit-editor-save { display: inline-block; margin-left: 8px; font-size: 12px; color: var(--color-muted, #6b6660); }
  .lit-editor-save.is-saving { color: var(--color-primary, #ee7d51); }
  .lit-editor-save.is-error { color: #c0392b; }
  .lit-close { background: none; border: none; font-size: 26px; line-height: 1; color: var(--color-muted, #6b6660); cursor: pointer; }
  .lit-field { display: block; margin-bottom: 14px; }
  .lit-field-label { display: block; font-size: 12px; font-weight: 600; letter-spacing: 0.04em;
    text-transform: uppercase; color: var(--color-muted, #6b6660); margin-bottom: 5px; }
  .lit-field-label em { text-transform: none; letter-spacing: 0; font-weight: 400; font-size: 11px; }
  .lit-field input, .lit-field textarea { width: 100%; padding: 9px 11px; border: 1px solid var(--color-rule, #d9c6a7);
    border-radius: 8px; font-size: 14px; font-family: var(--font-body, Georgia, serif); color: var(--color-dark, #2d2927);
    background: var(--color-white, #fff); box-sizing: border-box; }
  .lit-field textarea { font-family: ui-monospace, "SF Mono", Menlo, monospace; font-size: 13px; line-height: 1.55; resize: vertical; }
  .lit-field input:focus, .lit-field textarea:focus { outline: none; border-color: var(--color-primary, #ee7d51); }

  .lit-actions { display: flex; align-items: center; gap: 10px; margin: 6px 0 18px; flex-wrap: wrap; }
  .lit-action-status { font-size: 12px; color: var(--color-muted, #6b6660); }
  .lit-action-status.is-error { color: #c0392b; }
  .lit-action-status.is-ok { color: #2f6b44; }

  .lit-preview-label { font-size: 12px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase;
    color: var(--color-muted, #6b6660); margin: 0 0 8px; }
  .lit-preview-label em { text-transform: none; letter-spacing: 0; font-weight: 400; }
  .lit-preview-frame { width: 100%; height: 440px; border: 1px solid var(--color-rule, #d9c6a7);
    border-radius: 10px; background: #f6f3f2; }

  @media (max-width: 820px) {
    .lit-layout { grid-template-columns: 1fr; }
    .lit-list-wrap { border-right: none; border-bottom: 1px solid var(--color-rule, #d9c6a7); max-height: 46vh; }
    .lit-editor { max-height: none; }
    .lit-preview-frame { height: 340px; }
    .lit-navbtn { width: 40px; height: 40px; }
  }
</style>

<script src="{{asset "js/admin-auth.js"}}"></script>
<script src="{{asset "js/admin-sidebar.js"}}"></script>
<script src="{{asset "js/admin-liturgy.js"}}"></script>
