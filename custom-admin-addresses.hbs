{{!< default}}
{{!-- /admin/members/addresses/ — shipping addresses for print-journal
     fulfillment. Admin-gated: the page shell renders for any signed-in
     member, but the worker rejects non-admin emails with 403 and the
     JS surfaces a denied state. --}}

<main class="admin-page admin-workspace">
  {{#if @member}}
    {{> "admin-sidebar" active="members"}}
    <div class="admin-main">
      <header class="admin-topbar">
        <h1 class="admin-topbar-title"><em>Shipping Addresses</em></h1>
        <p class="admin-topbar-sub">Every saved address from members, gift recipients, and group purchases.</p>
      </header>

    <section class="admin-body">
      <div class="container">
        <div class="admin-members-layout">
          <aside class="admin-members-sidebar">
            {{> "admin-members-subnav" active="addresses"}}
          </aside>
          <div class="admin-members-main">
            <div class="admin-table-host"
                 data-admin-table
                 data-title="Addresses"
                 data-endpoint="/api/admin/addresses"
                 data-collection="addresses"
                 data-api-base="{{@custom.membership_api_base}}"
                 data-member-email="{{@member.email}}"
                 data-columns="name,organization,church,line1,line2,city,state,postal_code,country,age_range,gender,church_role,denomination,source,updated_at"
                 data-column-labels="Name,Organization,Church,Street,Apt,City,State,ZIP,Country,Age,Gender,Church Role,Denomination,Source,Updated">
              <div class="admin-table-toolbar">
                <p class="admin-table-count" data-count-label>Loading&hellip;</p>
                <a href="#" class="btn btn-primary btn-sm" data-download-csv hidden>Download CSV</a>
              </div>
              <p class="admin-table-status" data-status></p>
              <div class="admin-table-wrap">
                <table class="admin-table" data-table hidden>
                  <thead><tr data-thead></tr></thead>
                  <tbody data-tbody></tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    </div>
  {{else}}
    {{> "admin-denied"}}
  {{/if}}
</main>

<script src="{{asset "js/admin-auth.js"}}"></script>
<script src="{{asset "js/admin-sidebar.js"}}"></script>
<script src="{{asset "js/admin-table.js"}}"></script>
