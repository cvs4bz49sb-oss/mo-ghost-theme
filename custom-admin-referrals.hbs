{{!< default}}
{{#contentFor "moHead"}}
<title>Referral Program | MO Admin</title>
<meta name="robots" content="noindex, nofollow" />
<meta name="description" content="Internal Mere Orthodoxy staff tool." />
<meta property="og:title" content="Referral Program | MO Admin" />
<meta property="og:description" content="Internal Mere Orthodoxy staff tool." />
<meta name="twitter:title" content="Referral Program | MO Admin" />
<meta name="twitter:description" content="Internal Mere Orthodoxy staff tool." />
{{/contentFor}}
{{!-- /admin/members/referrals/ — referral program tracker. --}}

<main class="admin-page admin-workspace">
  {{#if @member}}
    {{> "admin-sidebar" active="referrals"}}
    <div class="admin-main">
      <header class="admin-topbar">
        <h1 class="admin-topbar-title"><em>Referral Program</em></h1>
        <p class="admin-topbar-sub">Track referrals, rewards, and top referrers.</p>
      </header>

    <section class="admin-body">
      <div class="container">
        <div class="admin-members-layout">
          <aside class="admin-members-sidebar">
            {{> "admin-members-subnav" active="referrals"}}
          </aside>
          <div class="admin-members-main"
               data-admin-referrals
               data-api-base="{{@custom.membership_api_base}}"
               data-member-email="{{@member.email}}">

            {{!-- Summary stats --}}
            <div class="admin-stats ref-stats" data-ref-stats>
              <div class="admin-stat-card">
                <span class="admin-stat-label">Pending</span>
                <span class="admin-stat-value" data-stat="pending">&hellip;</span>
              </div>
              <div class="admin-stat-card">
                <span class="admin-stat-label">Vesting</span>
                <span class="admin-stat-value" data-stat="converted">&hellip;</span>
              </div>
              <div class="admin-stat-card">
                <span class="admin-stat-label">Confirmed</span>
                <span class="admin-stat-value" data-stat="rewarded">&hellip;</span>
              </div>
              <div class="admin-stat-card">
                <span class="admin-stat-label">Voided</span>
                <span class="admin-stat-value" data-stat="void">&hellip;</span>
              </div>
            </div>

            {{!-- Grants summary --}}
            <div class="ref-grants-summary" data-ref-grants>
              <h3 class="section-heading">Rewards Granted</h3>
              <p class="admin-table-status" data-grants-status>Loading&hellip;</p>
            </div>

            {{!-- Needs review --}}
            <div class="ref-review" data-ref-review hidden>
              <h3 class="section-heading ref-review-heading">Needs Review</h3>
              <p class="ref-review-desc">Grants stuck mid-flight. Check Stripe to confirm whether the credit applied before retrying.</p>
              <div class="admin-table-wrap">
                <table class="admin-table" data-review-table>
                  <thead><tr>
                    <th>Referrer</th><th>Kind</th><th>Amount</th><th>Detail</th><th>Created</th>
                  </tr></thead>
                  <tbody data-review-tbody></tbody>
                </table>
              </div>
            </div>

            {{!-- Top referrers --}}
            <div class="ref-leaderboard" data-ref-leaderboard>
              <h3 class="section-heading">Top Referrers</h3>
              <p class="admin-table-status" data-leaderboard-status>Loading&hellip;</p>
              <div class="admin-table-wrap">
                <table class="admin-table" data-leaderboard-table hidden>
                  <thead><tr>
                    <th>Referrer</th><th>Code</th><th>Confirmed</th><th>Vesting</th><th>Pending</th><th>Voided</th><th>Credits</th>
                  </tr></thead>
                  <tbody data-leaderboard-tbody></tbody>
                </table>
              </div>
            </div>

            {{!-- Recent referrals --}}
            <div class="ref-recent" data-ref-recent>
              <h3 class="section-heading">Recent Referrals</h3>
              <p class="admin-table-status" data-recent-status>Loading&hellip;</p>
              <div class="admin-table-wrap">
                <table class="admin-table" data-recent-table hidden>
                  <thead><tr>
                    <th>Referrer</th><th>Referred</th><th>Status</th><th>Created</th><th>Converted</th><th>Confirmed</th>
                  </tr></thead>
                  <tbody data-recent-tbody></tbody>
                </table>
              </div>
            </div>

          </div>
        </div>
      </div>
    </section>

    </div>
  {{else}}
    {{> "admin-denied"}}
  {{/if}}
</main>

<style>
  .ref-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 16px;
    margin-bottom: 48px;
  }
  .ref-grants-summary { margin-bottom: 48px; }
  .ref-grants-summary .section-heading { margin-bottom: 16px; }
  .ref-grants-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 12px;
  }
  .ref-grant-card {
    background: var(--bg-muted, #f7f7f7);
    border-radius: 8px;
    padding: 16px;
  }
  .ref-grant-card strong { display: block; font-size: 24px; margin-bottom: 4px; }
  .ref-grant-card .ref-grant-label { font-size: 13px; color: var(--text-secondary, #666); }
  .ref-review { margin-bottom: 48px; }
  .ref-review-heading { color: var(--color-warning, #c2410c); margin-bottom: 8px; }
  .ref-review-desc { font-size: 13px; color: var(--text-secondary, #666); margin-bottom: 16px; }
  .ref-leaderboard { margin-bottom: 48px; }
  .ref-leaderboard .section-heading { margin-bottom: 16px; }
  .ref-recent { margin-bottom: 48px; }
  .ref-recent .section-heading { margin-bottom: 16px; }
  .ref-status-badge {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 500;
    text-transform: capitalize;
  }
  .ref-status-badge--pending { background: #fef3c7; color: #92400e; }
  .ref-status-badge--converted { background: #dbeafe; color: #1e40af; }
  .ref-status-badge--rewarded { background: #d1fae5; color: #065f46; }
  .ref-status-badge--void { background: #fee2e2; color: #991b1b; }
</style>

<script src="{{asset "js/admin-auth.js"}}"></script>
<script src="{{asset "js/admin-sidebar.js"}}"></script>
<script src="{{asset "js/admin-referrals.js"}}"></script>
