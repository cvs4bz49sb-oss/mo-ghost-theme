{{!< default}}
{{#contentFor "moHead"}}
<title>All works &mdash; The Faith Received</title>
<meta name="description" content="Every work in The Faith Received in one table of contents, filtered by century, tradition or collection." />
<meta name="tfr-room-collection" content="all" />
{{/contentFor}}
{{!-- /the-faith-received/century/ — every collection at once, cut by date.

     The same library the collections use, over all five at once.
     Pick a century from the rail and the table of contents below it
     narrows to what the church wrote then, by author. --}}

<main class="faith-received faith-room">

  <section class="bhero bhero--tool">
    <div class="bhero-inner container">
      <p class="bhero-kicker"><a href="/the-faith-received/">The Faith Received</a> <span aria-hidden="true">&middot;</span> <a href="/the-faith-received/all-works/">All works</a></p>
      <h1 class="bhero-title">Every work in the library</h1>
      <p class="bhero-lede">Seven collections in one table of contents, oldest first. Narrow it by century, tradition or denomination &mdash; the English divines by party &mdash; or search an author or a title.</p>
    </div>
  </section>

  <section class="bband faith-room-body">
    <div class="container">
      {{!-- The two ways in, above the table of contents: where the reader
            left off, and the shelves. Both are links into the room below,
            and both remove themselves when they have nothing to show, so a
            first-time visitor sees the shelves and the contents alone. --}}
      <div class="faith-room-openers" data-faith-openers></div>
      <div data-faith-room data-fr-bookmark-rows></div>
    </div>
  </section>

{{> "faith-received/_beta-band"}}
</main>
{{!-- Sitewide membership CTA. Same partial and same gate as the rest
     of the site: hidden for paid and comped members, shown to free
     subscribers and anonymous visitors. --}}
{{> "faith-received/_library-cta"}}



<script src="{{asset "js/faith-corpora.js"}}"></script>
<script src="{{asset "js/faith-century.js"}}"></script>
<script src="{{asset "js/faith-room.js"}}"></script>
{{!-- Continue reading and the shelves. Loads the same seven catalogues the
     room does, and MOCorpora caches by id, so this costs no second fetch. --}}
<script src="{{asset "js/faith-room-openers.js"}}"></script>
{{!-- Bookmark a work from its row. The store first: it is the same
     mo-kit bookmark the reader's Save button and the Bookmark button at
     the foot of a section write, so a work saved here and a section
     saved inside it are one record, not two. --}}
<script src="{{asset "js/lib/faith-work-bookmarks.js"}}"></script>
<script src="{{asset "js/faith-work-bookmark-rows.js"}}"></script>
