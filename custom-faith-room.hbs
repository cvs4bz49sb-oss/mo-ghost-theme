{{!< default}}
{{#contentFor "moHead"}}
<title>Reading room &mdash; The Faith Received</title>
<meta name="description" content="The full table of contents for a collection in The Faith Received: every author, every work, in one place." />
<meta property="og:title" content="Reading room — The Faith Received" />
<meta name="twitter:title" content="Reading room — The Faith Received" />
{{/contentFor}}
{{!-- /the-faith-received/room/ — a collection's whole table of contents.

     One route serves all eight collections; which one is read from
     ?collection= by faith-library-browse.js, the same module that used
     to drive the Library tab. It groups by author, pages, and draws the
     A-Z rail. This template supplies the section it binds to and the
     band language around it.

     Landing here without ?collection= shows the eight collections to
     choose from, which is the module's own top level. --}}

<main class="faith-received faith-room">

  <section class="bhero bhero--tool">
    <div class="bhero-inner container">
      <p class="bhero-kicker">The Faith Received &middot; Reading room</p>
      <h1>The whole table of contents.</h1>
      <p class="bhero-sub">Every author in the collection, with their works beneath their name. Jump by letter, or search for a name or a title.</p>
    </div>
  </section>

  <section class="bband faith-room-body" data-faith-section="library">
    <div class="container">
      <div class="faith-card-grid"></div>
    </div>
  </section>

</main>

<meta name="tfr-library-base" content="https://0ss8v4l06kodnhp0.public.blob.vercel-storage.com" />
<script src="{{asset "js/faith-corpora.js"}}"></script>
<script src="{{asset "js/faith-library-browse.js"}}"></script>
<script src="{{asset "js/faith-resolve.js"}}"></script>
<script src="{{asset "js/faith-gate.js"}}"></script>
