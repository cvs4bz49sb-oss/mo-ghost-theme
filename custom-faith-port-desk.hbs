{{!-- /the-faith-received/desk/ — the writing desk, ported.

     THE CORPUS SITE'S /desk INSIDE THIS SITE: an editor beside your
     research, the rail's four tabs over your notebook, highlights,
     reading history and Ask conversations, each insertable with its
     citation. desk.in02.js is the engine; desk-workflow.js and
     personal-research.js are its satellites. Extends `default`.

     THIS ROUTE USED TO REDIRECT into /research/#desk, Ian's own rebuild
     of the same idea, kept alive for the ?doc=<id> links that address a
     particular paper. This page reads ?doc= itself — it is where that
     convention came from — so those links keep opening the same paper.
     custom-faith-desk.hbs, the redirect, is left in place beside this.

     THE PAGE'S OWN HEADER IS KEPT WHOLE. It is not site chrome: it holds
     the documents toggle, the title field, the word count, the theme
     button and the research-rail toggle. Only the brand link went. The
     corpus page laid itself out as a flex column on <body>; here the
     column is .faith-port-desk-page, sized to the screen under our
     masthead, the same move the ported reader makes with
     .faith-port-read-page. Ask inserts go to the ask-dev worker's
     /v1/ask, the route the site's own Ask already uses. --}}
<script src="{{asset "js/page/faith-port-surface-boot.js"}}&amp;frv=c6ea6e388eea3f2a" data-body-class="desk-page"></script>
<div class="faith-port-desk-page">
<header>
  <button class="hbtn" id="docsTog" aria-label="Your documents"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M5 5h14M5 12h14M5 19h14"/></svg></button>
  <input id="dTitle" aria-label="Paper title" placeholder="Untitled paper" autocomplete="off" spellcheck="true">
  <span id="wc"></span>
  <button class="hbtn" id="deskTheme" aria-label="Change reading theme" title="Change reading theme"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M12 4a8 8 0 0 1 0 16Z" fill="currentColor"/></svg></button>
  <button class="hbtn" id="railTog" aria-label="Insert from your research"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><path d="M4 4h16v16H4zM14 4v16M7 8h4M7 12h4"/></svg></button>
</header>
<nav class="desk-workspace-bar" aria-label="Desk workspace"><div class="desk-modes"><button id="deskWriteMode" aria-pressed="true">Write</button><button id="deskResearchMode" aria-pressed="false">Research</button></div><label id="deskPaperContext" hidden>Paper<select id="deskPaper" aria-label="Current paper"></select></label><label class="desk-notebook-context">Notebook<select id="paperNotebook" aria-label="Notebook for this paper"></select></label><details class="desk-new-notebook"><summary>New notebook</summary><form id="newNotebookForm"><label>Notebook name<input id="newNotebookName" required autocomplete="off" placeholder="e.g. Grace and freedom"></label><button type="submit">Create notebook</button></form></details><span id="deskContextStatus" role="status"></span></nav>
<main id="deskMain">
  <aside id="docs"><a class="fr-home-link desk-panel-home" data-fr-home href="/the-faith-received/all-works/?collection=all" aria-label="Back to library"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m14 6-6 6 6 6"/></svg>Library</a>
    <div class="desk-rail-head"><span class="ds-h">Your documents</span><button class="hbtn desk-rail-close" id="closeDocuments" aria-label="Close documents">×</button></div>
    <button id="newDoc">＋ New document</button>
    <div id="docList"></div>
    <div class="desk-export"><div class="ds-h">Export this document</div><button class="hbtn" id="exMd" title="Download this document as Markdown">Download Markdown</button><button class="hbtn" id="exPr">Print or save PDF</button></div>
  </aside>
  <section id="edwrap">
    <div id="toolbar">
      <button data-c="formatBlock" data-v="h2" title="Section heading">H2</button>
      <button data-c="formatBlock" data-v="h3" title="Subheading">H3</button>
      <button data-c="bold" title="Bold"><b>B</b></button>
      <button data-c="italic" title="Italic"><i>I</i></button>
      <button data-c="formatBlock" data-v="blockquote" title="Block quotation">❝</button>
      <button data-c="insertUnorderedList" title="Bulleted list">•</button>
      <button data-c="removeFormat" title="Clear formatting">⌫</button>
    </div>
    <div id="ed" contenteditable="true" spellcheck="true" role="textbox" aria-multiline="true" aria-label="Document text"></div><div id="deskSaveState" role="status" aria-live="polite">Saved in this browser</div>
  </section>
  <aside id="rail"><a class="fr-home-link desk-panel-home" data-fr-home href="/the-faith-received/all-works/?collection=all" aria-label="Back to library"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m14 6-6 6 6 6"/></svg>Library</a>
    <div class="desk-rail-head"><span class="ds-h">Your research</span><button class="hbtn desk-rail-close" id="closeResearch" aria-label="Close research">×</button></div>
    <div class="desk-research-links"><a href="/the-faith-received/pins/">Manage notebooks</a><a href="/the-faith-received/search/">Find sources</a></div>
    <button type="button" class="desk-personal-entry" id="deskPersonalOpen">Explore this notebook</button>
    <div class="rl-tabs" role="group" aria-label="Saved research">
      <button data-t="notes" class="on" aria-pressed="true">Notebook</button>
      <button data-t="highlights" aria-pressed="false">Highlights</button>
      <button data-t="history" aria-pressed="false">History</button><button data-t="chats" aria-pressed="false">Ask</button>
    </div>
    <label class="desk-collection-label" for="deskCollection">Show notes from</label><select id="deskCollection" aria-label="Choose a notebook"><option value="all">All notebooks</option></select>
    <label class="desk-rail-search">Search research<input id="railSearch" type="search" placeholder="Find a passage, note, or work"></label><details id="deskNoteForm"><summary>Add a working note</summary><textarea id="deskNoteText" placeholder="Write a thought for this notebook"></textarea><button id="deskSaveNote" type="button">Save note</button></details><section id="deskSourcePreview" hidden><div><span>Source beside your draft</span><button id="deskSourceClose" type="button">Close source</button></div><iframe title="Source beside your draft"></iframe></section><div id="railBody"></div><button id="railMore" type="button" hidden>Show more items</button>
  </aside>
</main><section id="deskPersonal" hidden><div class="desk-personal-top"><button type="button" id="deskPersonalBack" hidden>Back to writing</button><a href="/the-faith-received/pins/">Manage notebooks</a></div><div id="deskPersonalHost"></div></section><button id="deskScrim" hidden aria-label="Close side panel"></button>
<script src="{{asset "js/port/desk.in02.js"}}&amp;frv=1494a7160b50afbc"></script>
</div>

{{else}}
<main class="faith-received"><section class="bhero bhero--tool"><div class="bhero-inner container"><h1>Desk</h1></div></section>
<script src="{{asset "js/page/faith-tfr-rail.js"}}" defer></script>
{{> "faith-received/_beta-gate"}}</main>
{{/if}}
