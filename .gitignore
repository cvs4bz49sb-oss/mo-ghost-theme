# Faith Received: source JSON regenerated locally from the heidelberg
# repo via scripts/import-faith-received.mjs. Generated partials in
# partials/faith-received/ ARE committed (those are what Ghost serves).
data/faith-received/

# Ebook build intermediates: scripts/build-ebook-pdfs.mjs writes
# print-ready HTML here while rendering. The final .pdf/.epub
# outputs in assets/files/ebooks/ ARE committed; the intermediates
# are throwaway.
scripts/.ebook-build/

# Polanus Syntagma source PDF + extracted text. The JSON output goes
# to data/faith-received/ (also gitignored); the partial under
# partials/faith-received/polanus-syntagma.hbs IS committed.
scripts/polanus-source/

# Claude Code skills folder (not part of the theme)
.claude/

# PostHog wizard report (not part of the theme)
posthog-setup-report.md

assets/js/.wrangler/
