{{!< default}}
{{#contentFor "moHead"}}
<title>Chosen for You | Mere Orthodoxy</title>
<meta name="robots" content="noindex, nofollow" />
<meta name="description" content="Essays and episodes picked for you by your seminary, college, or organization." />
<meta property="og:title" content="Chosen for You" />
<meta property="og:description" content="Essays and episodes picked for you by your seminary, college, or organization." />
<meta name="twitter:title" content="Chosen for You" />
<meta name="twitter:description" content="Essays and episodes picked for you by your seminary, college, or organization." />
{{/contentFor}}
{{!-- /dashboard/institution/ — full institution curated content page.

     2026-08-19: this page was stuck on "Loading curated content..."
     forever. Everything on it — the fetch, the render, and both
     gating redirects — lived in inline <script> blocks, and
     default.hbs sets `script-src 'self'` with NO 'unsafe-inline'.
     The browser blocked all three. It was the only template in the
     theme still carrying inline JS.

     The fetch/render now lives in assets/js/page/dashboard-institution.js.
     The redirects are gone entirely, replaced by rendered sign-in and
     upgrade panels matching custom-dashboard-bookmarks.hbs and the
     other /dashboard/* pages. That is both CSP-safe and better: a
     signed-out visitor sees where they are instead of being bounced.

     Do NOT put script logic back in this file. --}}

<main class="dashboard-page">

  {{#unless @member}}
    {{!-- Not signed in. --}}
    <section class="hero dashboard-hero">
      <div class="container">
        <p class="hero-kicker"><span class="dot"></span> Member Dashboard</p>
        <h1 class="hero-headline">See what your organization <span class="highlight"><em>picked for you</em></span>.</h1>
        <p class="hero-sub">Essays and episodes picked by your organization's administrator.</p>
        <p class="dashboard-actions">
          <a href="#/portal/signin" class="btn btn-primary" data-portal="signin">Sign in</a>
          <a href="/membership/" class="btn btn-ghost">Become a Member</a>
        </p>
      </div>
    </section>
  {{else}}
  {{#match @member.status "!=" "free"}}

    <section class="hero dashboard-hero">
      <div class="container">
        <p class="hero-kicker"><span class="dot"></span> Member Dashboard</p>
        <h1 class="hero-headline"><em>Chosen</em> <span class="highlight"><em>for You</em></span></h1>
        <p class="hero-sub">Essays and episodes picked by your organization's administrator.</p>
      </div>
    </section>

    <section class="dashboard-body">
      <div class="container">
        <p class="admin-back-link"><a href="/dashboard/"><span aria-hidden="true">&larr;</span> Back to dashboard</a></p>
        <div data-dashboard-institution-full></div>
        <p class="dashboard-empty" data-institution-loading>Loading curated content...</p>
      </div>
    </section>

  {{else}}
    {{!-- Free subscriber. --}}
    <section class="hero dashboard-hero">
      <div class="container">
        <p class="hero-kicker"><span class="dot"></span> Member Dashboard</p>
        <h1 class="hero-headline">This is a <span class="highlight"><em>member feature</em></span>.</h1>
        <p class="hero-sub">Organizational memberships give every person on your roster full access.</p>
        <p class="dashboard-actions">
          <a href="/membership/" class="btn btn-primary">Become a Member</a>
          <a href="/institutions/" class="btn btn-ghost">Organizational membership</a>
        </p>
      </div>
    </section>
  {{/match}}
  {{/unless}}

</main>

{{!-- admin-auth.js ships inside boot.min.js in <head>, so window.MOAuth and
     window.MOSafeHref are both defined before this page script runs. This
     template used to re-load assets/js/admin-auth.js here; that re-ran the
     IIFE after {{{body}}} render and re-read <meta name="mo-trusted-hosts">
     from a DOM that page content had already touched, defeating the
     read-once-in-head guarantee the allowlist depends on. Removed
     2026-08-19. Page scripts execute BEFORE site.min.js, so nothing here
     may reach for a site-bundle global. --}}
<script src="{{asset "js/page/dashboard-institution.js"}}"></script>
