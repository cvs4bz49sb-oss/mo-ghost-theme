{{!-- Password gate for The Faith Received. Include at the TOP of every
     TFR template (right after {{!< default}}) so the overlay is in the
     DOM before any content paints. The inline script removes it
     instantly when sessionStorage already has the key, so authenticated
     visitors never see a flicker. --}}
<style>.faith-gate-hide{display:none!important}</style>
<script>if(sessionStorage.getItem('tfr-access')==='1')document.documentElement.classList.add('faith-gate-pass')</script>
<div class="faith-gate" id="faithGate">
  <div class="faith-gate-card">
    <p class="faith-gate-lead">Something remarkable is in the works,<br>but it&rsquo;s not yet ready.</p>
    <p class="faith-gate-sub">Only enter if you are working on building it.</p>
    <form class="faith-gate-form" id="faithGateForm">
      <input type="password" class="faith-gate-input" id="faithGateInput" placeholder="Password" autocomplete="off" />
      <button type="submit" class="faith-gate-btn">Enter</button>
    </form>
    <p class="faith-gate-error" id="faithGateError" hidden>Wrong password.</p>
  </div>
</div>
<script>
(function(){
  if(sessionStorage.getItem('tfr-access')==='1'){
    document.getElementById('faithGate').classList.add('faith-gate-hide');
    return;
  }
  document.body.style.overflow='hidden';
  var input=document.getElementById('faithGateInput');
  input.focus();
  document.getElementById('faithGateForm').addEventListener('submit',function(e){
    e.preventDefault();
    if(input.value==='credo'){
      sessionStorage.setItem('tfr-access','1');
      document.getElementById('faithGate').classList.add('faith-gate-hide');
      document.body.style.overflow='';
    }else{
      document.getElementById('faithGateError').hidden=false;
      input.value='';input.focus();
      var g=document.getElementById('faithGate');
      g.classList.add('faith-gate--shake');
      setTimeout(function(){g.classList.remove('faith-gate--shake')},400);
    }
  });
})();
</script>
