{{!-- Dashboard body for full-access members (paid, comped, or staff
     preview). Editorial two-column layout: <details> modules on
     the left, identity rail on the right. --}}

<section class="hero dashboard-hero">
  <div class="container">
    <p class="hero-kicker"><span class="dot"></span> Member Dashboard</p>
    <h1 class="hero-headline">
      <span data-greeting>Good morning</span>, <span class="highlight"><em>{{#if @member.name}}{{@member.name}}{{else}}friend{{/if}}</em></span>.
    </h1>
    <p class="hero-sub">Your home inside Mere Orthodoxy. Bookmarks, reading history, and membership settings — all in one place.</p>
    {{!-- Liturgical week chip. Click to reveal the Sunday Collect
         from the 1979 BCP, prayed daily through the week. --}}
    <details class="hero-liturgical-week" data-liturgical-week hidden>
      <summary class="hero-liturgical-week-summary">
        <span data-liturgical-week-label></span>
        <span class="hero-liturgical-week-chev" aria-hidden="true">▾</span>
      </summary>
      <div class="hero-liturgical-collect">
        <p class="hero-liturgical-collect-label">The Collect</p>
        <div class="hero-liturgical-collect-body" data-liturgical-collect-body></div>
        <p class="hero-liturgical-collect-source"><em>The Book of Common Prayer (1979)</em></p>
      </div>
    </details>
  </div>
</section>

<section class="dashboard-body">
  <div class="container">
    <div class="dashboard-grid">

      <div class="dashboard-main">

        <div class="engagement-module" data-engagement-module hidden>
          <div class="engagement-accent"></div>
          <details open>
            <summary>
              <h2 class="dashboard-module-title engagement-title"><em data-engagement-title></em></h2>
              <span class="dashboard-module-chev" aria-hidden="true"></span>
            </summary>
            <div class="engagement-body">
              <p class="engagement-text" data-engagement-body></p>
              <div data-engagement-content></div>
            </div>
          </details>
        </div>

        {{!-- Institution curated content — dynamic modules injected by JS.
             Hidden if the member doesn't belong to an institution. --}}
        <div data-dashboard-institutions></div>

        {{!-- What arrived today: Daily Liturgy, the day's essays, and the
             two shows. Horizontal rail, collapsible, above the cards. --}}
        {{> "dashboard-new"}}

        {{!-- Saved-content categories as click-through cards (was: <details>
             accordions with inline previews). Each links to its existing full
             page (/dashboard/bookmarks|commonplace|history/), which renders the
             same server-stored data via the same dashboard.js — so this is a
             navigation change only; nothing about the data changes. Counts are
             filled read-only by dashboard.js (hydrateCardCounts). --}}
        <div class="dash-cards">
          <a class="dash-card" href="/dashboard/bookmarks/">
            <span class="dash-card-kind">Saved</span>
            <h2 class="dash-card-title"><em>Bookmarks</em></h2>
            <p class="dash-card-meta">Articles you've saved to read later.</p>
            <span class="dash-card-foot"><span class="dash-card-count" data-card-count="bookmarks"></span><span class="dash-card-open">Open &rarr;</span></span>
          </a>
          <a class="dash-card" href="/dashboard/commonplace/">
            <span class="dash-card-kind">Collected</span>
            <h2 class="dash-card-title"><em>Commonplace Book</em></h2>
            <p class="dash-card-meta">Passages and quotations you've kept.</p>
            <span class="dash-card-foot"><span class="dash-card-count" data-card-count="commonplace"></span><span class="dash-card-open">Open &rarr;</span></span>
          </a>
          <a class="dash-card" href="/dashboard/history/">
            <span class="dash-card-kind">Read</span>
            <h2 class="dash-card-title"><em>Reading History</em></h2>
            <p class="dash-card-meta">Everything you've read, most recent first.</p>
            <span class="dash-card-foot"><span class="dash-card-count" data-card-count="history"></span><span class="dash-card-open">Open &rarr;</span></span>
          </a>
          {{!-- Works saved from the library. Kept in the same mo-kit
               bookmark store as articles, under "tfr:" ids, and resolved
               against the catalogues by faith-saved.js. --}}
          <a class="dash-card" href="/dashboard/faith-received/">
            <span class="dash-card-kind">Saved</span>
            <h2 class="dash-card-title"><em>The Faith Received</em></h2>
            <p class="dash-card-meta">Works you've saved from the library.</p>
            <span class="dash-card-foot"><span class="dash-card-count" data-card-count="faith-received"></span><span class="dash-card-open">Open &rarr;</span></span>
          </a>

          {{!-- Institution card — revealed by dashboard.js (hydrateInstitutions)
               only when the member belongs to an institution with curated
               content. Click-through to the existing full page. --}}
          <a class="dash-card" href="/dashboard/institution/" data-institution-card hidden>
            <span class="dash-card-kind">Organizational Membership</span>
            {{!-- The title is the organization's own name, filled by
                 dashboard.js. The server default is a placeholder for the
                 moment before the fetch lands, and for the case where it
                 fails. --}}
            <h2 class="dash-card-title"><em data-institution-card-name>Your organization</em></h2>
            <p class="dash-card-meta">Essays and episodes picked for you.</p>
            <span class="dash-card-foot"><span class="dash-card-count" data-institution-card-count></span><span class="dash-card-open">Open &rarr;</span></span>
          </a>

          {{!-- Refer a Friend — an action card (no standalone page; it carries
               the copy-link). referral.js reveals it for eligible members and
               fills the link + stats. Same data hooks as the old widget. --}}
          <div class="dash-card dash-card--action" data-mo-referral-widget hidden>
            <span class="dash-card-kind">Invite</span>
            <h2 class="dash-card-title"><em>Refer a Friend</em></h2>
            <p class="dash-card-meta" data-referral-blurb>Share Mere Orthodoxy with someone who would value it. When a friend becomes a paying member, you earn a reward and they get 20% off their first year.</p>
            <div class="referral-link-row">
              <input type="text" class="referral-link-input" data-referral-link readonly aria-label="Your referral link" />
              <button type="button" class="btn btn-primary referral-copy-btn" data-referral-copy aria-live="polite">Copy</button>
            </div>
            <div class="referral-stats">
              <div class="referral-stat"><span class="referral-stat-num" data-referral-joined>0</span><span class="referral-stat-label">Friends joined</span></div>
              <div class="referral-stat"><span class="referral-stat-num" data-referral-reward-num>0</span><span class="referral-stat-label" data-referral-reward-label>Rewards earned</span></div>
              <div class="referral-stat" data-referral-progress-stat hidden><span class="referral-stat-num" data-referral-progress>0 of 5</span><span class="referral-stat-label">To next reward</span></div>
            </div>
          </div>
        </div>


      </div>

      <aside class="dashboard-rail" aria-label="Membership">

        <div class="dashboard-rail-item" data-institution-admin-link hidden>
          <p class="eyebrow">Institution Admin</p>
          <p class="dashboard-rail-tier"><em data-institution-admin-name>Your Institution</em></p>
          <p class="dashboard-rail-meta">Manage members, view signups, and curate content for your institution.</p>
          <a href="/institution-manage/" class="dashboard-rail-link">Open Institution Dashboard &rarr;</a>
        </div>
        <div class="dashboard-rail-sep" data-institution-admin-sep aria-hidden="true" hidden></div>

        <div class="migration-banner" data-migration-banner hidden>
          <div class="migration-banner-inner" data-migration-banner-inner>
            <p class="migration-banner-text" data-migration-banner-text></p>
            <a class="btn btn-primary migration-banner-btn" data-migration-banner-btn href="/migrate/" hidden>Migrate Your Membership</a>
          </div>
        </div>

        {{!-- Student renewal banner — shown by dashboard.js in the last
             month before a student membership expires (one-time annual,
             no auto-renew). Reuses the migration-banner styling. --}}
        <div class="migration-banner" data-renewal-banner hidden>
          <div class="migration-banner-inner migration-banner--action" data-renewal-banner-inner>
            <p class="migration-banner-text" data-renewal-banner-text></p>
            <a class="btn btn-primary migration-banner-btn" data-renewal-banner-btn href="/student/">Renew Membership</a>
          </div>
        </div>

        <details class="reading-tracker" open data-reading-tracker>
          <summary>
            <p class="eyebrow">Reading Habit</p>
            <span class="dashboard-module-chev" aria-hidden="true"></span>
          </summary>
          <div class="reading-tracker-body">
            <div class="reading-tracker-row">
              <span class="reading-tracker-label">Daily Reading</span>
              <span class="reading-tracker-dots" data-reading-dots aria-label="Reading streak this week">
                <span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="dot"></span>
              </span>
            </div>
            <div class="reading-tracker-row">
              <span class="reading-tracker-label">Total Essays Read</span>
              <span class="reading-tracker-count" data-reading-count>—</span>
            </div>
          </div>
        </details>

        <div class="dashboard-rail-sep" aria-hidden="true"></div>

        <div class="dashboard-rail-item">
          <p class="eyebrow">Online Community</p>
          <p class="dashboard-rail-tier"><em>Society of St. Anne's</em></p>
          <p class="dashboard-rail-meta">Chat with fellow Mere Orthodoxy readers and contributors on the Society of St. Anne's Discord Server.</p>
          <a href="https://discord.gg/U6WN8pzvtv" class="dashboard-rail-link" target="_blank" rel="noopener">Join the Conversation &rarr;</a>
        </div>

        <div class="dashboard-rail-sep" aria-hidden="true"></div>

        <div class="dashboard-rail-item">
          <p class="eyebrow">Journal Archive</p>
          <p class="dashboard-rail-tier"><em>Digital Editions</em></p>
          <p class="dashboard-rail-meta">Read every past issue of the print journal online.</p>
          <a href="/dashboard/journals/" class="dashboard-rail-link">Open journal archive &rarr;</a>
        </div>

        <div class="dashboard-rail-sep" aria-hidden="true"></div>

        <div class="dashboard-rail-item">
          <p class="eyebrow">Ebooks</p>
          <p class="dashboard-rail-tier"><em>Reading Library</em></p>
          <p class="dashboard-rail-meta">Every Mere Orthodoxy ebook, online or PDF.</p>
          <a href="/dashboard/ebooks/" class="dashboard-rail-link">Open ebook library &rarr;</a>
        </div>

        <div class="dashboard-rail-sep" aria-hidden="true"></div>

        <div class="dashboard-rail-item">
          <p class="eyebrow">Events</p>
          <p class="dashboard-rail-tier"><em>Event Library</em></p>
          <p class="dashboard-rail-meta">Watch every past online event on demand.</p>
          <a href="/dashboard/replays/" class="dashboard-rail-link">Open event library &rarr;</a>
        </div>

        <div class="dashboard-rail-sep" aria-hidden="true"></div>

        <div class="dashboard-rail-item">
          <p class="eyebrow">Daily Office</p>
          <p class="dashboard-rail-tier"><em>Morning &amp; Evening Prayer</em></p>
          <p class="dashboard-rail-meta">Pray the Daily Office from the 1928 Book of Common Prayer.</p>
          <a href="/dashboard/prayer/" class="dashboard-rail-link">Open Daily Office &rarr;</a>
        </div>

        <div class="dashboard-rail-sep" aria-hidden="true"></div>

        <div class="dashboard-rail-item">
          <p class="eyebrow">Site Theme</p>
          <p class="dashboard-rail-meta" style="margin-bottom:8px">Follow the church year with seasonal header colors.</p>
          <label class="dashboard-rail-select">
            <select data-liturgical-select>
              <option value="off">Standard</option>
              <option value="auto">Liturgical Calendar (auto)</option>
              <option value="advent">Advent</option>
              <option value="christmas">Christmas</option>
              <option value="epiphany">Epiphany</option>
              <option value="lent">Lent</option>
              <option value="easter">Easter</option>
              <option value="pentecost">Pentecost</option>
              <option value="ordinary">Ordinary Time</option>
            </select>
          </label>
          <div class="liturgical-preview" data-liturgical-preview hidden>
            <span class="liturgical-preview-swatch" data-liturgical-swatch></span>
            <span class="liturgical-preview-label" data-liturgical-label></span>
          </div>
        </div>

        <div class="dashboard-rail-sep" aria-hidden="true"></div>

        <div class="dashboard-rail-item">
          <p class="eyebrow">Your Membership</p>
          <p class="dashboard-rail-tier"><em>{{#match @member.status "paid"}}Paid Member{{/match}}{{#match @member.status "comped"}}Complimentary{{/match}}{{#match @member.status "free"}}Free Subscriber{{/match}}</em></p>
          <p class="dashboard-rail-meta">Change your membership type and update your shipping address for the print Journal.</p>
          <a href="/manage/" class="dashboard-rail-link">Manage Membership &rarr;</a>
        </div>

      </aside>

    </div>
  </div>
</section>
