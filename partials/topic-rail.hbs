{{!-- Topic rail used on the homepage and /archive/. The visible pills
     are hardcoded to an editorially-curated list — not every tag in
     Ghost. Order matches the editorial priority: Recent (home) →
     Church → Culture → Formation → Family → Theology → Technology →
     Book Reviews. Add or reorder here when the editorial taxonomy
     changes. --}}
<nav class="topics" aria-label="Topics">
    <div class="container topics-inner" data-topics-inner>
        <span class="topics-label">Read by</span>
        <a href="{{@site.url}}" class="topic-pill is-active" data-tag="recent">Recent</a>
        <a href="/tag/church/" class="topic-pill" data-tag="church">Church</a>
        <a href="/tag/culture/" class="topic-pill" data-tag="culture">Culture</a>
        <a href="/tag/formation/" class="topic-pill" data-tag="formation">Formation</a>
        <a href="/tag/family/" class="topic-pill" data-tag="family">Family</a>
        <a href="/tag/theology/" class="topic-pill" data-tag="theology">Theology</a>
        <a href="/tag/technology/" class="topic-pill" data-tag="technology">Technology</a>
        <a href="/tag/book-reviews/" class="topic-pill" data-tag="book-reviews">Book Reviews</a>
    </div>
    {{!-- Scroll-progress thumb. Sits on top of the rail's bottom hairline,
         the same 1px height in brand orange, sized to the visible-portion
         ratio and offset by scroll position. Auto-hides if the rail isn't
         actually scrollable (e.g. on desktop where every pill fits). --}}
    <div class="topics-progress" data-topics-progress hidden></div>
</nav>
<script>
(function () {
  var inner = document.querySelector('[data-topics-inner]');
  var thumb = document.querySelector('[data-topics-progress]');
  if (!inner || !thumb) return;
  function update() {
    var scrollable = inner.scrollWidth - inner.clientWidth;
    if (scrollable <= 1) { thumb.hidden = true; return; }
    thumb.hidden = false;
    var visibleRatio = inner.clientWidth / inner.scrollWidth;
    var progressRatio = inner.scrollLeft / scrollable;
    var thumbWidthPct = visibleRatio * 100;
    var thumbLeftPct = progressRatio * (100 - thumbWidthPct);
    thumb.style.width = thumbWidthPct + '%';
    thumb.style.left = thumbLeftPct + '%';
  }
  inner.addEventListener('scroll', update, { passive: true });
  window.addEventListener('resize', update);
  update();
})();
</script>
