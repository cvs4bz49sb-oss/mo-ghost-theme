        <a href="/tag/family/" class="topic-pill" data-tag="family">Family</a>
        <a href="/tag/theology/" class="topic-pill" data-tag="theology">Theology</a>
        <a href="/tag/technology/" class="topic-pill" data-tag="technology">Technology</a>
        <a href="/tag/book-reviews/" class="topic-pill" data-tag="book-reviews">Book Reviews</a>
    </div>
    {{!-- Scroll-progress thumb. Sits on top of the rail's bottom hairline,
         the same 1px height in brand orange, sized to the visible-portion
         ratio and offset by scroll position. Auto-hides if the rail isn't
