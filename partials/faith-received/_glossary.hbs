{{!-- Glossary body. Two ways in: type a term above (fetches the one
     bucket that term falls in), or pick a letter below (fetches every
     bucket starting with that letter and lists the terms it holds).
     Both are wired up by assets/js/faith-glossary.js; this markup is
     just the mounts. --}}
<div class="faith-glossary" data-faith-glossary>

  <nav class="faith-glossary-az" data-faith-glossary-az aria-label="Browse by letter">
    <button type="button" class="faith-glossary-letter" data-faith-glossary-letter="#">#</button>
    <button type="button" class="faith-glossary-letter" data-faith-glossary-letter="a">A</button>
    <button type="button" class="faith-glossary-letter" data-faith-glossary-letter="b">B</button>
    <button type="button" class="faith-glossary-letter" data-faith-glossary-letter="c">C</button>
    <button type="button" class="faith-glossary-letter" data-faith-glossary-letter="d">D</button>
    <button type="button" class="faith-glossary-letter" data-faith-glossary-letter="e">E</button>
    <button type="button" class="faith-glossary-letter" data-faith-glossary-letter="f">F</button>
    <button type="button" class="faith-glossary-letter" data-faith-glossary-letter="g">G</button>
    <button type="button" class="faith-glossary-letter" data-faith-glossary-letter="h">H</button>
    <button type="button" class="faith-glossary-letter" data-faith-glossary-letter="i">I</button>
    <button type="button" class="faith-glossary-letter" data-faith-glossary-letter="j">J</button>
    <button type="button" class="faith-glossary-letter" data-faith-glossary-letter="k">K</button>
    <button type="button" class="faith-glossary-letter" data-faith-glossary-letter="l">L</button>
    <button type="button" class="faith-glossary-letter" data-faith-glossary-letter="m">M</button>
    <button type="button" class="faith-glossary-letter" data-faith-glossary-letter="n">N</button>
    <button type="button" class="faith-glossary-letter" data-faith-glossary-letter="o">O</button>
    <button type="button" class="faith-glossary-letter" data-faith-glossary-letter="p">P</button>
    <button type="button" class="faith-glossary-letter" data-faith-glossary-letter="q">Q</button>
    <button type="button" class="faith-glossary-letter" data-faith-glossary-letter="r">R</button>
    <button type="button" class="faith-glossary-letter" data-faith-glossary-letter="s">S</button>
