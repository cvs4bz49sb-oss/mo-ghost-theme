  {{> "faith-received/_nav"}}
    
  <section class="faith-intro">
    <div class="container container-narrow">
      <details class="faith-intro-disclosure" data-faith-intro>
        <summary class="faith-intro-summary">
          <span class="faith-intro-summary-label" data-faith-intro-label>Read introduction</span>
          <span class="faith-intro-summary-chev" aria-hidden="true"></span>
        </summary>
        <div class="faith-intro-body">
          <p class="faith-intro-prose hero-excerpt-dropcap">At the Council of Chalcedon in 451, the Church faced its second great Christological crisis: not whether the Son was fully God, but how he could be both fully God and fully human in one person. The Chalcedonian Definition gives the answer in four adverbs - without confusion, without change, without division, without separation. Christ is one and the same, made known in two natures. This is the language Christianity has used ever since to confess the Incarnation.</p>
        </div>
      </details>
    </div>
  </section>
    
    <div class="article-body faith-doc-body">
      <div class="container container-narrow faith-doc-inner">
        
  <div class="faith-reading-controls" data-faith-controls>
