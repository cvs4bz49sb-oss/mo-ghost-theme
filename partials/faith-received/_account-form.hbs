<div class="digest-form tfr-account-form" data-inline-signup data-source="{{#if source}}{{source}}{{else}}tfr-beta{{/if}}" data-account-signup>
  <div class="digest-field">
    <label for="{{prefix}}-first">First Name</label>
    <input id="{{prefix}}-first" type="text" autocomplete="given-name" placeholder="First" data-signup-first required />
  </div>
  <div class="digest-field">
    <label for="{{prefix}}-last">Last Name</label>
    <input id="{{prefix}}-last" type="text" autocomplete="family-name" placeholder="Last" data-signup-last required />
  </div>
  <div class="digest-field">
    <label for="{{prefix}}-email">Email</label>
    <input id="{{prefix}}-email" type="email" autocomplete="email" placeholder="you@example.com" data-signup-email required />
  </div>
  <button type="button" class="digest-submit" data-signup-submit>Create free account</button>
  <p class="digest-status" data-signup-status role="status" aria-live="polite"></p>
</div>
