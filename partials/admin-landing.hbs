            <p class="ws-landing-card-desc">Journal status, subscriber gate, and operational values.</p>
          </a>
        </div>
      </div>

      <div class="ws-landing-section">
        <p class="ws-landing-section-title">Editorial</p>
        <div class="ws-landing-grid">
          <a href="/admin/coverage/" class="ws-landing-card">
            <svg class="ws-landing-card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <h2 class="ws-landing-card-title">Coverage Scan</h2>
            <p class="ws-landing-card-desc">Daily radar across peer publications. Headlines, gaps, contested topics, pitches.</p>
          </a>
          <a href="/admin/editorial/" class="ws-landing-card">
            <svg class="ws-landing-card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
