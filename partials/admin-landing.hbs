            <p class="ws-landing-card-desc">Generate platform-tailored social media copy from any article.</p>
          </a>
          <a href="/admin/extract/" class="ws-landing-card">
            <svg class="ws-landing-card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
