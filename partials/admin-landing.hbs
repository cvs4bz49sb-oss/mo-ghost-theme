            <p class="ws-landing-card-desc">Submissions inbox and workflow board from approved through published.</p>
          </a>
          <a href="/digest-gen/" class="ws-landing-card">
            <svg class="ws-landing-card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            <h2 class="ws-landing-card-title">Weekly Digest</h2>
            <p class="ws-landing-card-desc">Compose, preview, and export the weekly digest email for Kit.</p>
          </a>
        </div>
      </div>

      <div class="ws-landing-section">
        <p class="ws-landing-section-title">Marketing</p>
        <div class="ws-landing-grid">
          <a href="/admin/social/" class="ws-landing-card">
