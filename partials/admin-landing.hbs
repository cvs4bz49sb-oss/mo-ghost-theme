            <h2 class="ws-landing-card-title">Slide-ins</h2>
            <p class="ws-landing-card-desc">Targeted CTAs by page, audience, and frequency.</p>
          </a>
          <a href="/admin/engagement/" class="ws-landing-card">
            <svg class="ws-landing-card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
            <h2 class="ws-landing-card-title">Engagement</h2>
            <p class="ws-landing-card-desc">Member dashboard module: polls, announcements, prompts.</p>
          </a>
