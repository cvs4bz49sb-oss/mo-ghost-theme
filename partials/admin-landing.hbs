            <h2 class="ws-landing-card-title">Social Dashboard</h2>
            <p class="ws-landing-card-desc">Scheduled posts, errors, and daily automation status.</p>
          </a>
          <a href="/admin/assets/" class="ws-landing-card">
            <svg class="ws-landing-card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
            <h2 class="ws-landing-card-title">Social Assets</h2>
            <p class="ws-landing-card-desc">Create branded carousel and story images for Instagram.</p>
          </a>
          <a href="/admin/quote/" class="ws-landing-card">
            <svg class="ws-landing-card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
            <h2 class="ws-landing-card-title">Quote Graphic</h2>
            <p class="ws-landing-card-desc">Turn any pull quote into a shareable branded image.</p>
          </a>
          <a href="/admin/copy/" class="ws-landing-card">
            <svg class="ws-landing-card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
