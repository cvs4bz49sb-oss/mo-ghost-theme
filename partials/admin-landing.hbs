{{!-- /admin/ landing: workspace-style overview with department cards. --}}

{{> "admin-sidebar" active="overview"}}

<div class="admin-main">
  <header class="admin-topbar">
    <h1 class="admin-topbar-title"><em>Operations</em></h1>
    <p class="admin-topbar-sub">Every tool for running the publication, in one place.</p>
  </header>

  <section class="admin-body">
    <div class="container">

      <div class="ws-landing-section">
        <p class="ws-landing-section-title">Executive</p>
        <div class="ws-landing-grid">
          <a href="/admin/members/" class="ws-landing-card">
            <svg class="ws-landing-card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
