{{!-- Organizational membership purchase.
     Shared by custom-institutions.hbs (/organizations/) and
     custom-institution-checkout.hbs (the older /institutions/checkout/
     route) so the two can never drift apart.

     No inquiry form. Buyers pay here directly; anyone who needs an
     invoice or a purchase order is told to email rather than being sent
     through a separate lead-capture flow.

     Groups (under 10 seats) stay a separate product at /groups/. The
     seat boundary is stated in both directions so nobody lands on the
     wrong one. --}}

<section class="page-hero">
  <div class="container">
    <p class="eyebrow">Churches, Seminaries &amp; Organizations</p>
    <h1 class="page-hero-headline"><em>Bring Mere&nbsp;Orthodoxy</em> to your whole community.</h1>
    <p class="page-hero-sub">One membership for everyone at your organization. Churches, seminaries, colleges, denominations, and research centers.</p>
  </div>
</section>

<section class="form-section">
  <div class="container">

    <div class="pricing-table">
      <div class="pricing-tier">
        <p class="pricing-tier-label">Annual organizational membership</p>
        <p class="pricing-tier-price"><span class="price-amount">$2,500</span><span class="price-interval">/yr</span></p>
        <p class="pricing-tier-detail">As many people as you like. The price does not change with your headcount.</p>
      </div>
    </div>

    <div class="institutional-overview">
      <div class="institutional-point">
        <h3>Access by email domain</h3>
        <p>Anyone with an email address at your organization's domain gets a full membership. No seat assignments, no proxy server, no IP ranges to maintain.</p>
      </div>
      <div class="institutional-point">
        <h3>Everything we publish</h3>
        <p>The full archive, the ebook library, audio essays, and the members' forum, for everyone you cover.</p>
      </div>
      <div class="institutional-point">
        <h3>One year, no auto-renewal</h3>
        <p>Your membership runs a year from purchase. We will reach out before it ends. Nothing is charged automatically.</p>
      </div>
    </div>

    <form id="institution-checkout-form" class="stacked-form" novalidate>
      <p class="form-intro">Payment runs on Stripe. Your join link and access code arrive by email as soon as it clears.</p>

      <fieldset class="form-group">
        <legend class="form-legend">Your organization</legend>
        <div class="form-row">
          <label class="form-field">
            <span class="form-label">Organization name</span>
            <input type="text" name="org_name" autocomplete="organization" required />
          </label>
          <label class="form-field">
            <span class="form-label">Type</span>
            <select name="org_type" required>
              <option value="">Select one</option>
              <option value="other">Church</option>
              <option value="seminary">Seminary</option>
              <option value="college">Christian college or university</option>
              <option value="denomination">Denomination</option>
              <option value="research_center">Research center or institute</option>
            </select>
          </label>
        </div>
        <label class="form-field">
          <span class="form-label">Email domains</span>
          <input type="text" name="email_domain" placeholder="yourchurch.org" required />
          <span class="form-hint">The domain your people use for email. Separate several with commas. Anyone with an address at these domains can join.</span>
        </label>
        <label class="form-field">
          <span class="form-label">Approximate headcount</span>
          <input type="number" name="headcount" min="1" step="1" required />
          <span class="form-hint">For our records only. It does not change the price.</span>
        </label>
      </fieldset>

      <fieldset class="form-group">
        <legend class="form-legend">You</legend>
        <div class="form-row">
          <label class="form-field">
            <span class="form-label">Your name</span>
            <input type="text" name="contact_name" autocomplete="name" required />
          </label>
          <label class="form-field">
            <span class="form-label">Your email</span>
            <input type="email" name="contact_email" autocomplete="email" required />
          </label>
        </div>
        <label class="form-field">
          <span class="form-label">Your role</span>
          <input type="text" name="contact_role" placeholder="Pastor, librarian, dean, academic affairs, etc." required />
        </label>
        <label class="form-field">
          <span class="form-label">Notes <span class="form-hint">(optional)</span></span>
          <textarea name="notes" rows="3" placeholder="Anything we should know."></textarea>
        </label>
      </fieldset>

      <button type="submit" class="btn btn-pill btn-primary btn-wide" id="institution-checkout-submit">
        <span class="btn-label">Continue to payment</span>
        <span class="btn-spinner" aria-hidden="true"></span>
      </button>
      <p class="btn-tagline">$2,500 for one year. A single charge, not a recurring subscription.</p>
      <p class="btn-error" id="institution-checkout-error" role="alert"></p>

      <p class="form-intro">
        Covering ten people or fewer? A <a href="/groups/">group membership</a> is priced per
        seat and will cost you less.
      </p>
      <p class="form-intro">
        Need an invoice or a purchase order instead? Email
        <a href="mailto:ian@mereorthodoxy.com">ian@mereorthodoxy.com</a> and we will set it up.
      </p>

      <p class="form-intro">
        Already purchased? <a href="/institutions/guide/">Read the setup guide</a> to get your
        people signed up.
      </p>
    </form>
  </div>
</section>

<script src="{{asset "js/institution-checkout.js"}}"></script>
