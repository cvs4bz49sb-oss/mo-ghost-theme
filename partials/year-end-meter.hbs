{{!-- The year-end giving meter, used by the /year-end/ hero
     ({{> "year-end-meter"}}) and the site-wide bottom bar
     ({{> "year-end-meter" bar=true}},
     partials/year-end-bar.hbs).

     LIVE (Ian, 2026-11-17). assets/js/page/eoy-meter-v2.js fills these from
     mo-admin GET /eoy/meter: every online payment since Nov 13 plus the
     offline amount staff keep on /admin/slide-ins/. To add checks, stock
     or donor-advised fund gifts, change that offline amount there, not
     this file.

     The figures below are only what shows before the script runs, or if
     it cannot reach the worker. Keep them roughly current. --}}
{{#if bar}}
<div class="eoy-bar-meter" data-eoy-meter>
  <div class="eoy-bar-track" role="progressbar" aria-label="Year-end giving" aria-valuemin="0" aria-valuemax="100" aria-valuenow="20" aria-valuetext="$25,000 of $125,000 raised" data-eoy-track><span class="eoy-bar-fill" style="width: 20%" data-eoy-fill></span></div>
  <p class="eoy-bar-figures"><b data-eoy-raised>$26,813</b> of our $125,000 year-end goal</p>
</div>
{{else}}
<div class="eoy-meter" data-eoy-meter>
  <p class="eoy-meter-figures">
    <span class="eoy-meter-raised" data-eoy-raised>$25,000</span>
    <span class="eoy-meter-goal">raised of $125,000</span>
  </p>
  <div class="eoy-meter-track" role="progressbar" aria-label="Year-end giving" aria-valuemin="0" aria-valuemax="100" aria-valuenow="20" aria-valuetext="$25,000 of $125,000 raised" data-eoy-track>
    <span class="eoy-meter-fill" style="width: 20%" data-eoy-fill></span>
  </div>
  <p class="eoy-meter-meta">
    <span class="eoy-meter-left" data-eoy-left>$100,000 to go</span>
    <span class="eoy-meter-asof" data-eoy-asof>Updated live</span>
  </p>
</div>
{{/if}}
