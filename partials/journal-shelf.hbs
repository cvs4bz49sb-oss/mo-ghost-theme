{{!-- Past journal issues as a shelf of covers. Shared by
     partials/journals-list.hbs (/dashboard/journals/, members) and
     custom-journal.hbs (/journal/, public).

     public=true (the /journal/ landing page):
       - adds Issue 010, which the dashboard shows as its lead issue
         instead, so it would otherwise be missing from /journal/;
       - drops the PDF links. Downloads stay off the public sales
         page. The PDFs are public theme assets and are not access-
         controlled. Hiding the links is presentation, not a gate.

     When a new issue is digitized and becomes the dashboard lead, move
     the old lead into this list for everyone and delete the
     "if public" block. --}}
  <ol class="lib-shelf lib-shelf--journals">
    {{#if public}}
    <li class="lib-shelf-item">
      <a class="lib-item" href="/journal-archive/issue-10/">
        <img class="lib-cover-img" src="{{asset "images/journal-issue-010-cover.jpg"}}" alt="" width="772" height="1000" loading="lazy">
        <span class="lib-item-title">Issue 010</span>
        <span class="lib-item-meta">Summer 2026</span>
        <span class="lib-item-desc">On attention, dignity, and the work of seeing a person. Essays by Brian Auten, Annie Crawford, Agnes R. Howard, Joshua Heavin and more.</span>
      </a>
    </li>
    {{/if}}
    <li class="lib-shelf-item">
      <a class="lib-item" href="/journal-archive/issue-09/">
        <img class="lib-cover-img" src="{{asset "images/journal-issue-009-cover.jpg"}}" alt="" width="773" height="1000" loading="lazy">
        <span class="lib-item-title">Issue 009</span>
        <span class="lib-item-meta">Winter 2026</span>
        <span class="lib-item-desc">On home, culture, and faithfulness. Essays by Michael Toscano, Kirsten Sanders, Elizabeth Lasch-Quinn, Daniel K. Williams and more.</span>
      </a>
      {{#unless public}}<a class="lib-item-pdf" href="{{asset "journals/Journal-Issue09.pdf"}}" download>PDF</a>{{/unless}}
