      </div>
    </section>

    <section class="mm-panel" data-mm-panel="support" aria-label="Support">
      <div class="mm-grid mm-grid--two">
        <div>
          <p class="mm-col-title">Join</p>
          <ul class="mm-links">
            <li><a href="/membership/">Membership<span class="mm-note">For individual readers</span></a></li>
            <li><a href="/groups/">Group memberships<span class="mm-note">For a staff, cohort or reading group</span></a></li>
            <li><a href="/student/">Student discount<span class="mm-note">For undergraduate and graduate students</span></a></li>
            <li><a href="/institutions/">Churches and institutions<span class="mm-note">Seats for your staff or congregation</span></a></li>
          </ul>
          <p class="mm-col-title mm-col-title--next">Give</p>
          <ul class="mm-links">
            <li><a href="https://secure.anedot.com/institute-for-christianity-and-common-life/donate">Donate</a></li>
          </ul>
        </div>
        <div class="mm-feature">
          <a href="/membership/" tabindex="-1" aria-hidden="true"><div class="mm-plate"><img src="{{asset "images/nav/membership-hero.jpg"}}" alt="" loading="lazy"></div></a>
          <p class="mm-feature-title">Become a member</p>
          <p>Get the print journal and support the work of Mere Orthodoxy.</p>
          <a class="btn btn-solid" href="/membership/">See membership</a>
        </div>
      </div>
    </section>

    <section class="mm-panel" data-mm-panel="about" aria-label="About">
      <div class="mm-grid mm-grid--two">
        <div>
          <p class="mm-col-title">Mere Orthodoxy</p>
          <ul class="mm-links">
            <li><a href="/about/">About us</a></li>
            <li><a href="/contributors/">Contributors</a></li>
          </ul>
          <p class="mm-col-title mm-col-title--next">Get in touch</p>
          <ul class="mm-links">
            <li><a href="/contact/">Contact</a></li>
            <li><a href="/writers-meetings/">Write for us</a></li>
          </ul>
        </div>
        <div class="mm-feature">
          <a href="/about/" tabindex="-1" aria-hidden="true"><div class="mm-plate"><img src="{{asset "images/nav/about-hero.jpg"}}" alt="" loading="lazy"></div></a>
