              <a href="/groups/" tabindex="-1" aria-hidden="true"><div class="mm-plate"><img src="{{asset "images/nav/membership-hero.jpg"}}" alt="" loading="lazy"></div></a>
              <p class="mm-feature-title">Read together with your group</p>
