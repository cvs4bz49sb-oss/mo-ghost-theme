{{!--
    Full-width header menu (Ian, 2026-11-10). The desktop bar's buttons
    (default.hbs, [data-mm-trigger]) open these panels; under 1262px the
    bar hands over to the drawer, and assets/js/nav-mega.js rebuilds the
    drawer's list from these same panels so the two never drift.

    Read and Listen are filled by nav-mega.js the first time the menu is
    used: essays from the Content API (same filters as the homepage's
    Must Reads column), episodes from the podcast worker the podcast
    pages already read. Everything else is static.

    Column dividers, the white plate around pictures and the terracotta
    rule along the top are the house look. Do not add small heads over
    hairlines or a carousel with dots; those read as another site's menu.
--}}
<div class="mm-backdrop" data-mm-backdrop hidden></div>
<div class="mm" id="mm" data-mm role="region" aria-label="Menu" hidden>
  <div class="container">

    <section class="mm-panel" data-mm-panel="read" aria-label="Read">
      <div class="mm-grid mm-grid--read">
        <nav aria-label="Essays">
          <ul class="mm-index" data-mm-index>
            <li><a href="/archive/" data-mm-set="latest" aria-current="true">Latest</a></li>
            <li><a href="/archive/" data-mm-set="must">Must reads of the month</a></li>
            <li class="mm-index-sep" role="presentation"></li>
            <li><a href="/tag/theology/" data-mm-set="theology">Theology</a></li>
            <li><a href="/tag/church/" data-mm-set="church">Church</a></li>
            <li><a href="/tag/culture/" data-mm-set="culture">Culture</a></li>
            <li><a href="/tag/formation/" data-mm-set="formation">Formation</a></li>
            <li><a href="/tag/family/" data-mm-set="family">Family</a></li>
            <li><a href="/tag/technology/" data-mm-set="technology">Technology</a></li>
            <li><a href="/tag/book-reviews/" data-mm-set="book-reviews">Book Reviews</a></li>
          </ul>
        </nav>
        {{#if @member}}
        <div>
          <div class="mm-set-head"><p class="mm-col-title" data-mm-set-title>Latest</p><a class="mm-more" data-mm-set-more href="/archive/">All essays</a></div>
          <ul class="mm-rows" data-mm-rows></ul>
        </div>
        <div data-mm-lead></div>
        {{else}}
        {{!-- Signed out: the lead essay heads the middle column and the
             right column is the Weekly Digest sign-up (same inline signup
             as the homepage box). --}}
        <div>
          <div class="mm-set-head"><p class="mm-col-title" data-mm-set-title>Latest</p><a class="mm-more" data-mm-set-more href="/archive/">All essays</a></div>
          <div class="mm-lead-inline" data-mm-lead></div>
          <ul class="mm-rows" data-mm-rows></ul>
        </div>
        {{!-- Same card as the homepage Weekly Digest box (index.hbs
             .today-digest), sized for the column. --}}
        <div>
          <div class="today-digest mm-digest-card">
            <div class="today-digest-copy">
              <p class="eyebrow"><svg class="eyebrow-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1.5"/><path d="M3.5 6l8.5 7 8.5-7"/></svg>The Weekly Digest</p>
              <p class="mm-digest-title">Premier thought every Thursday.</p>
              <p>All of our recent essays and podcasts, delivered to you. Free.</p>
            </div>
            <div class="digest-form" data-inline-signup data-newsletter="weekly-digest" data-source="nav-weekly-digest">
              <div class="digest-field">
                <label for="nav-digest-first">First Name</label>
                <input id="nav-digest-first" type="text" autocomplete="given-name" placeholder="First" data-signup-first required />
              </div>
              <div class="digest-field">
                <label for="nav-digest-last">Last Name</label>
                <input id="nav-digest-last" type="text" autocomplete="family-name" placeholder="Last" data-signup-last required />
              </div>
              <div class="digest-field mm-digest-email">
                <label for="nav-digest-email">Email</label>
                <input id="nav-digest-email" type="email" autocomplete="email" placeholder="you@example.com" data-signup-email required />
              </div>
              <button type="button" class="digest-submit" data-signup-submit>Subscribe</button>
              <p class="digest-status" data-signup-status></p>
            </div>
            <p class="mm-signup-fine">Already subscribed? <button type="button" class="mm-link-btn" data-portal="signin">Sign in</button></p>
          </div>
        </div>
        {{/if}}
      </div>
    </section>

    <section class="mm-panel" data-mm-panel="listen" aria-label="Listen">
      <div class="mm-grid mm-grid--listen">
        <div>
          <p class="mm-col-title">Podcasts</p>
          <div class="mm-shows">
            <div class="mm-show" data-mm-show="mere-fidelity"><a class="mm-row" href="/podcasts/mere-fidelity/"><div class="mm-plate"><img src="{{asset "images/mere-fidelity.jpg"}}" alt="" loading="lazy" width="62" height="62"></div><div><div class="mm-row-title">Mere Fidelity</div><div class="mm-row-by">Conversations on theology and the church</div></div></a><ul class="mm-eps"></ul></div>
            <div class="mm-show" data-mm-show="christians-reading-classics"><a class="mm-row" href="/podcasts/christians-reading-classics/"><div class="mm-plate"><img src="{{asset "images/christians-reading-classics.jpg"}}" alt="" loading="lazy" width="62" height="62"></div><div><div class="mm-row-title">Christians Reading Classics</div><div class="mm-row-by">Reading the great books</div></div></a><ul class="mm-eps"></ul></div>
            <div class="mm-show" data-mm-show="passages-nicaea" data-mm-first><a class="mm-row" href="/podcasts/passages-nicaea/"><div class="mm-plate"><img src="{{asset "images/passages-nicaea.jpg"}}" alt="" loading="lazy" width="62" height="62"></div><div><div class="mm-row-title">Passages: Nicaea</div><div class="mm-row-by">The council and the creed</div></div></a><ul class="mm-eps"></ul></div>
            <div class="mm-show" data-mm-show="daily-liturgy"><a class="mm-row" href="/daily-liturgy/"><div class="mm-plate"><img src="{{asset "images/nav/daily-liturgy-cover.jpg"}}" alt="" loading="lazy" width="62" height="62"></div><div><div class="mm-row-title">The Daily Liturgy</div><div class="mm-row-by">Morning prayer read aloud each day</div></div></a><ul class="mm-eps"></ul></div>
          </div>
        </div>
        <div class="mm-feature">
          {{#if @member}}
            <div class="mm-card">
              <a href="/daily-liturgy/read/" tabindex="-1" aria-hidden="true"><div class="mm-plate mm-plate--logo mm-dl-framed"><img src="{{asset "images/daily-liturgy-logo.png"}}" alt="The Daily Liturgy" loading="lazy" class="mm-dl-logo"></div></a>
              <p class="mm-feature-title">The Daily Liturgy</p>
              <p>A short service of morning prayer read aloud. Listen or read along.</p>
              <a class="mm-more" href="/daily-liturgy/read/">Today's liturgy</a>
            </div>
          {{else}}
            {{!-- The site's own sign-up (assets/js/inline-signup.js): Ghost
                 emails a sign-in link that lands on the reader, signed in.
                 Newsletter:daily-liturgy starts the morning email via mo-kit. --}}
            <div class="today-digest mm-digest-card">
              <div class="today-digest-copy">
                <div class="mm-dl-framed mm-digest-logo-frame"><img class="mm-digest-logo" src="{{asset "images/daily-liturgy-logo.png"}}" alt="The Daily Liturgy" loading="lazy"></div>
                <p class="mm-digest-title">Morning prayer read aloud.</p>
                <p>Read today's liturgy free. Sign up and we'll email you a link to it.</p>
              </div>
              <div class="digest-form" data-inline-signup data-newsletter="daily-liturgy" data-source="nav-daily-liturgy" data-signup-redirect="/daily-liturgy/read/" data-signup-confirmation="Open it to read today's liturgy.">
                <div class="digest-field">
                  <label for="nav-dl-first">First Name</label>
                  <input id="nav-dl-first" type="text" autocomplete="given-name" placeholder="First" data-signup-first required />
                </div>
                <div class="digest-field">
                  <label for="nav-dl-last">Last Name</label>
                  <input id="nav-dl-last" type="text" autocomplete="family-name" placeholder="Last" data-signup-last required />
                </div>
                <div class="digest-field mm-digest-email">
                  <label for="nav-dl-email">Email</label>
                  <input id="nav-dl-email" type="email" autocomplete="email" placeholder="you@example.com" data-signup-email required />
                </div>
                <button type="button" class="digest-submit" data-signup-submit>Sign up free</button>
                <p class="digest-status" data-signup-status></p>
              </div>
              <p class="mm-signup-fine">Already subscribed? <button type="button" class="mm-link-btn" data-portal="signin">Sign in</button></p>
            </div>
          {{/if}}
        </div>
      </div>
    </section>

    <section class="mm-panel" data-mm-panel="journal" aria-label="Journal">
      <div class="mm-grid mm-grid--two">
        <div>
          <p class="mm-col-title">Get the journal</p>
          <ul class="mm-links">
            <li><a href="/membership/">Subscribe with membership</a></li>
            <li><a href="/institutions/">For churches and schools</a></li>
            <li><a href="/student/">Student rate</a></li>
          </ul>
          {{!-- Same stage and issue as the homepage tracker; site-settings.js
               fills both from the mo-admin settings. --}}
          <div class="mm-journal-status mm-card">
            <p class="mm-col-title">Journal status</p>
            <p class="mm-journal-next">Next issue: <span data-journal-issue>&hellip;</span></p>
            <ol class="journal-status" aria-label="Journal status">
              <li class="journal-status-step">
                  <span class="journal-status-mark" data-journal-stage="Drafting" aria-hidden="true">
                      <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M40 8 Q46 18 36 26 Q24 30 16 34 Q20 22 28 14 Q34 10 40 8 Z"/>
                          <path d="M38 10 L18 32" stroke-width="1"/>
                          <path d="M16 34 L12 38"/>
                          <line x1="12" y1="42" x2="32" y2="42"/>
                      </svg>
                  </span>
                  <span class="journal-status-label">Drafting</span>
              </li>
              <li class="journal-status-step">
                  <span class="journal-status-mark" data-journal-stage="In Production" aria-hidden="true">
                      <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                          <rect x="12" y="8" width="24" height="32" rx="1"/>
                          <line x1="12" y1="16" x2="36" y2="16"/>
                          <line x1="12" y1="32" x2="36" y2="32"/>
                          <line x1="20" y1="24" x2="28" y2="24"/>
                      </svg>
                  </span>
                  <span class="journal-status-label">In Production</span>
              </li>
              <li class="journal-status-step">
                  <span class="journal-status-mark" data-journal-stage="Arriving" aria-hidden="true">
                      <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                          <rect x="8" y="12" width="32" height="24" rx="1"/>
                          <path d="M8 12 L24 24 L40 12"/>
                          <circle cx="24" cy="30" r="3.5" fill="currentColor" stroke="none"/>
                      </svg>
                  </span>
                  <span class="journal-status-label">Arriving</span>
              </li>
            </ol>
          </div>
        </div>
        <div>
          <div class="mm-feature mm-card">
            <a href="/#journal" tabindex="-1" aria-hidden="true"><div class="mm-plate"><img src="{{asset "images/nav/journal-hero.jpg"}}" alt="" loading="lazy"></div></a>
            <p class="mm-feature-title">Mere Orthodoxy in print</p>
            <p>Long-form essays on theology, culture and politics. Members receive it in print.</p>
            {{#unless @member}}<a class="btn btn-solid" href="/membership/">Become a member</a>{{/unless}}
          </div>
        </div>
      </div>
    </section>

