            <div class="mm-plate"><img src="https://images-us.bookshop.org/ingram/9781535995672.jpg" alt="Orthodoxy" loading="lazy"></div>
            <div class="mm-plate"><img src="https://images-us.bookshop.org/ingram/9780830845545.jpg" alt="In Search of the Common Good" loading="lazy"></div>
            <div class="mm-plate"><img src="https://images-us.bookshop.org/ingram/9780310171072.jpg" alt="Christians Reading Classics" loading="lazy"></div>
            <div class="mm-plate"><img src="https://images-us.bookshop.org/ingram/9781514008560.jpg" alt="Walking Through Deconstruction" loading="lazy"></div>
