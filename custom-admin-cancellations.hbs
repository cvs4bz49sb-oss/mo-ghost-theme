{{!< default}}
{{#contentFor "moHead"}}
<title>Cancellations | MO Admin</title>
<meta name="robots" content="noindex, nofollow" />
<meta name="description" content="Internal Mere Orthodoxy staff tool." />
<meta property="og:title" content="Cancellations | MO Admin" />
<meta property="og:description" content="Internal Mere Orthodoxy staff tool." />
<meta name="twitter:title" content="Cancellations | MO Admin" />
<meta name="twitter:description" content="Internal Mere Orthodoxy staff tool." />
{{/contentFor}}
{{!-- /admin/members/cancellations/ — who left, when, and what they were
     doing first.

     Real churn only by default. A cancelled Stripe subscription is not
     always a lost member: the May-June 2026 spike was the billing
     migration closing old subscriptions, and a plan switch or duplicate
     cleanup cancels one subscription while the member keeps paying.

     Written by scripts/build-member-cancellations.mjs. This page reads.

     Data: mo-admin, GET /cancellations/summary, /cancellations/list,
     POST /cancellations/member. All JWT+staff on the "members" tool. --}}

<main class="admin-page admin-workspace">

  {{#if @member}}

    {{> "admin-sidebar" active="members"}}
    <div class="admin-main">
      <header class="admin-topbar">
        <h1 class="admin-topbar-title"><em>Cancellations</em></h1>
        <p class="admin-topbar-sub">Who left, how long they stayed, what they were doing beforehand, and why. Real churn only — billing migrations and plan changes are excluded.</p>
      </header>

      <section class="admin-body">
        <div class="container">
          <div class="admin-members-layout">
            <aside class="admin-members-sidebar">
              {{> "admin-members-subnav" active="cancellations"}}
            </aside>

            <div class="admin-members-main">
              <div class="jr-host" data-cancellations data-worker-url="{{@custom.admin_worker_url}}">

                <div class="admin-period" role="group" aria-label="Date range">
                  <button type="button" class="admin-period-option" data-cx-days="30">30 days</button>
                  <button type="button" class="admin-period-option is-active" data-cx-days="90">90 days</button>
                  <button type="button" class="admin-period-option" data-cx-days="365">1 year</button>
                </div>

                {{!-- Six tiles. .admin-stats is a six-column grid and a
                      seventh orphans onto its own row. Values stay short;
                      qualifications go in .jr-caveats. --}}
                <ul class="admin-stats" data-cx-stats>
                  <li class="admin-stat"><span class="admin-stat-label">Cancellations</span><span class="admin-stat-value" data-stat="members">&mdash;</span></li>
                  <li class="admin-stat"><span class="admin-stat-label">ARR lost</span><span class="admin-stat-value" data-stat="arr_lost">&mdash;</span></li>
                  <li class="admin-stat"><span class="admin-stat-label">Card failed</span><span class="admin-stat-value" data-stat="involuntary">&mdash;</span></li>
                  <li class="admin-stat"><span class="admin-stat-label">Told us why</span><span class="admin-stat-value" data-stat="gave_reason">&mdash;</span></li>
                  <li class="admin-stat"><span class="admin-stat-label">Never read anything</span><span class="admin-stat-value" data-stat="never_read">&mdash;</span></li>
                  <li class="admin-stat"><span class="admin-stat-label">Median tenure</span><span class="admin-stat-value" data-stat="tenure">&mdash;</span></li>
                </ul>

                <ul class="jr-caveats" data-cx-caveats hidden></ul>
                <p class="jr-excluded" data-cx-excluded hidden></p>
                <p class="admin-table-status" data-cx-status>Loading cancellations&hellip;</p>

                <div class="jr-split" data-cx-panels hidden>
                  <section class="jr-panel">
                    <h2 class="jr-panel-title">Why they said they left</h2>
                    <p class="jr-panel-sub">Their own words, captured by Ghost Portal at cancellation. Stripe's survey is switched off, so anyone not listed here left without giving a reason.</p>
                    <ul class="cx-reasons" data-cx-reasons></ul>
                  </section>

                  <section class="jr-panel">
                    <h2 class="jr-panel-title">How long they stayed</h2>
                    <p class="jr-panel-sub">Churn in the first month is an onboarding problem. Churn at renewal is a value problem. They get fixed in different places.</p>
                    <ul class="admin-ranked" data-cx-tenure></ul>
                  </section>
                </div>

                <section class="jr-section" data-cx-table-section hidden>
                  <h2 class="jr-panel-title">Everyone who left</h2>
                  <p class="jr-panel-sub">Most recent first. Open a row for the full story.</p>
                  <div class="admin-table-wrap">
                    <table class="admin-table">
                      <thead>
                        <tr>
                          <th scope="col" data-cx-sort="name">Member</th>
                          <th scope="col" data-cx-sort="canceled_at" data-cx-sort-default="desc">Cancelled</th>
                          <th scope="col" data-cx-sort="plan">Plan</th>
                          <th scope="col" data-cx-sort="tenure_days">Stayed</th>
                          <th scope="col" data-cx-sort="reads_lifetime">Reading</th>
                          <th scope="col" data-cx-sort="days_dark_before_cancel">Went quiet</th>
                          <th scope="col" data-cx-sort="annualized_value">ARR lost</th>
                          <th scope="col"><span class="visually-hidden">Actions</span></th>
                        </tr>
                      </thead>
                      <tbody data-cx-tbody></tbody>
                    </table>
                  </div>
                  <p class="admin-table-count" data-cx-count></p>
                </section>

                <p class="admin-empty" data-cx-empty hidden>
                  No cancellations recorded for this window. Run
                  <code>node website/workers/scripts/build-member-cancellations.mjs --days 90</code>
                  to populate it.
                </p>

              </div>
            </div>
          </div>
        </div>
      </section>
    </div>

    <div class="jr-drawer" data-cx-drawer hidden>
      <div class="jr-drawer-scrim" data-cx-drawer-close></div>
      <aside class="jr-drawer-panel" role="dialog" aria-modal="true" aria-labelledby="cx-drawer-title">
        <header class="jr-drawer-head">
          <div>
            <h2 class="jr-drawer-title" id="cx-drawer-title">Cancellation</h2>
            <p class="jr-drawer-sub" data-cx-drawer-sub></p>
          </div>
          <button type="button" class="btn btn-ghost btn-sm" data-cx-drawer-close>Close</button>
        </header>
        <div class="jr-drawer-body" data-cx-drawer-body></div>
      </aside>
    </div>

  {{else}}
    {{> "admin-denied"}}
  {{/if}}

</main>

<script src="{{asset "js/admin-auth.js"}}"></script>
<script src="{{asset "js/admin-sidebar.js"}}"></script>
<script src="{{asset "js/admin-cancellations.js"}}"></script>
