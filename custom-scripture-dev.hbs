{{!< default}}
{{!-- The TFR rail, first on the page and pinned under the masthead as on the reader (Ian, 2026-09-23). --}}
{{> "faith-received/_tfr-rail"}}
{{#contentFor "moHead"}}
<title>Scripture | The Faith Received | Mere Orthodoxy</title>
<meta name="description" content="Read any chapter of the Bible with the church&#39;s teachers beside it: every verse opens where the creeds, confessions and the library&#39;s authors cite it." />
<link rel="stylesheet" href="{{asset "css/scripture-dev.css"}}&amp;frv=24e72ba86df1e2cd" />
<link rel="stylesheet" href="{{asset "css/mo-articles-module.css"}}&amp;frv=2625886e3c465b55" />
{{!-- Dark or light, and the 50/50 .. Panel Only split, set on <html> before first paint (external: the CSP forbids inline script). --}}
<script src="{{asset "js/page/scripture-view-boot.js"}}&amp;frv=b619c4b13b360add"></script>
{{/contentFor}}
{{!-- /the-faith-received/scripture/ — the Scripture reader, rebuilt (Ian, 2026-09-22). The whole chapter is typeset as the old
     /bible/ page set it, every verse is a button, and a verse opens a
     sidebar of what the library says about it, with a link to that
     verse's Verse Desk at /the-faith-received/scripture/desk/?ref=<book>.<c>.<v>.

     Address: ?ref=john.3 or ?ref=john.3.16, &t=KJV for a translation.
     Text from mo-bible (bolls.life); citations from mo-tfr-verse.
     Scripts are external files: the site CSP forbids inline script. --}}

<main class="bible sd sd-reader" data-sd-reader>

{{!-- The same hero as the live Topics and Scripture Index pages
     (Ian, 2026-09-22: "they both need headers"). It carries the page's
     one h1; the chapter, verse or topic below is an h2. --}}
<section class="bhero bhero--tool">
  <div class="bhero-inner container">
    <p class="bhero-kicker"><a href="/the-faith-received/">The Faith Received</a> <span aria-hidden="true">&middot;</span> Scripture</p>
    <h1>Scripture</h1>
    <p class="bhero-sub">Read any chapter of the Bible with the church's teachers beside it. Select a verse to see where they cite it, or open its Verse Desk for everything at once.</p>
  </div>
</section>


  {{!-- The bar under the rail: where you are, and the way anywhere
       else. Sticky, so a reader deep in a chapter can still move.

       Ian, 2026-09-22: three tabs instead of one long book selector, so
       the Apocrypha is a division a reader can see rather than seven
       names buried at the bottom of a list of 73. The tabs choose the
       division; the Book select beside them is scoped to whichever
       division is showing. Tabs activate on click or Enter, not on
       arrow, because activating one loads a chapter. --}}
  <nav class="bible-controls sd-bar" aria-label="Passage and translation">
    <div class="container sd-canon">
      <div class="faith-view-toggle sd-canon-tabs" role="tablist" aria-label="Division of the Bible" data-sd-tabs>
        <button type="button" class="faith-view-toggle-tab is-active" role="tab" id="sd-tab-ot" data-sd-tab="ot" aria-selected="true" aria-controls="sd-book-panel">Old Testament</button>
        <button type="button" class="faith-view-toggle-tab" role="tab" id="sd-tab-nt" data-sd-tab="nt" aria-selected="false" aria-controls="sd-book-panel">New Testament</button>
        <button type="button" class="faith-view-toggle-tab" role="tab" id="sd-tab-ap" data-sd-tab="ap" aria-selected="false" aria-controls="sd-book-panel">Apocrypha</button>
      </div>
    </div>
    <div class="container bible-controls-inner sd-bar-inner">
      <div class="bible-control sd-book-panel" id="sd-book-panel" role="tabpanel" aria-labelledby="sd-tab-ot" data-sd-book-panel>
        <label class="bible-control-label" for="sd-book">Book</label>
        <select id="sd-book" data-sd-book></select>
      </div>
      <label class="bible-control bible-control--chapter">
        <span class="bible-control-label">Chapter</span>
        <select data-sd-chapter aria-label="Chapter"></select>
      </label>
      <label class="bible-control" data-sd-translation-control>
        <span class="bible-control-label">Translation</span>
        <select data-sd-translation aria-label="Translation"></select>
      </label>
      {{!-- The deuterocanon has one text and mo-bible cannot serve it,
           so on those books the picker is replaced by the name of the
           text actually on screen. A disabled dropdown would be a dead
           control that never says why. --}}
      <p class="bible-control sd-fixed-text" data-sd-fixed-text hidden>
        <span class="bible-control-label">Text</span>
        <span class="sd-fixed-text-name" data-sd-fixed-text-name></span>
      </p>
      <button type="button" class="sd-comm-toggle" data-sd-comm-toggle aria-expanded="false" aria-controls="sdCommPanel">Commentaries <span data-sd-comm-count></span></button>
      <div class="bible-controls-nav">
        <button type="button" class="bible-nav-btn" data-sd-prev aria-label="Previous chapter"><span aria-hidden="true">&larr;</span></button>
        <button type="button" class="bible-nav-btn" data-sd-next aria-label="Next chapter"><span aria-hidden="true">&rarr;</span></button>
      </div>
    </div>
  </nav>

  {{!-- Same .container as the bar above, so the filters, the count and
       the strip line up with Book/Chapter/Translation. --}}
  <section class="sd-comm-panel" id="sdCommPanel" data-sd-comm-panel hidden aria-label="Commentaries">
    <div class="container" data-sd-comm-host></div>
  </section>

  {{!-- The view bar (2026-10-19): how the width is split between the text and the panel (900px and up, with the rail on), and
       Dark mode. scripture-view-boot.js sets the saved choice on <html> before paint; scripture-view.js wires these. --}}
  <div class="container sd-viewbar" data-sd-viewbar>
    <div class="sd-viewbar-row">
      <div class="sd-layout-group" role="radiogroup" aria-label="Layout: how the width is split between the text and the panel" data-sd-layout-group>
        <div class="sd-seg">
          <button type="button" role="radio" aria-checked="true" tabindex="0" data-sd-layout-opt="50-50" aria-label="50/50, text 50 percent, panel 50 percent" title="50/50: text and panel equal"><svg class="sd-ico" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M12 5v14"/></svg></button>
          <button type="button" role="radio" aria-checked="false" tabindex="-1" data-sd-layout-opt="40-60" aria-label="40/60, text 40 percent, panel 60 percent" title="40/60: text 40%, panel 60%"><svg class="sd-ico" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M10.2 5v14"/></svg></button>
          <button type="button" role="radio" aria-checked="false" tabindex="-1" data-sd-layout-opt="60-40" aria-label="60/40, text 60 percent, panel 40 percent" title="60/40: text 60%, panel 40%"><svg class="sd-ico" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M13.8 5v14"/></svg></button>
          <button type="button" role="radio" aria-checked="false" tabindex="-1" data-sd-layout-opt="scripture" aria-label="Scripture only" title="Scripture only"><svg class="sd-ico" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M7 9.5h10M7 12.5h10M7 15.5h6"/></svg></button>
          <button type="button" role="radio" aria-checked="false" tabindex="-1" data-sd-layout-opt="panel" aria-label="Panel only" title="Panel only"><svg class="sd-ico" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M14.5 5v14"/><rect x="14.5" y="5" width="6.5" height="14" fill="currentColor" stroke="none"/></svg></button>
        </div>
      </div>
      <button type="button" class="sd-theme-btn" aria-pressed="false" aria-label="Dark mode" title="Dark mode" data-sd-theme-toggle><svg class="sd-ico" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path class="sd-ico-moon" d="M20 14.2A8 8 0 1 1 9.8 4a6.4 6.4 0 0 0 10.2 10.2z"/><g class="sd-ico-sun"><circle cx="12" cy="12" r="3.6"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6 7 7M17 17l1.4 1.4M18.4 5.6 17 7M7 17l-1.4 1.4"/></g></svg></button>
    </div>
    <p class="sd-view-hint" role="status" data-sd-view-hint hidden><span data-sd-view-hint-text>The panel is hidden.</span> <button type="button" data-sd-show-panel>Show panel</button></p>
  </div>

  <div class="container sd-layout" data-sd-layout>
    <article class="bible-chapter sd-text" data-sd-text>
      <p class="bible-status" role="status">Loading scripture&hellip;</p>
    </article>
    <aside class="sd-side" data-sd-side hidden aria-label="Verse"></aside>
  </div>

  <p class="container bible-attribution sd-attribution" data-sd-attribution></p>
</main>

<script src="{{asset "js/port/scripture-kinds.js"}}&amp;frv=45c55191e1820ff3"></script>
<script src="{{asset "js/page/scripture-source-groups.js"}}&amp;frv=18b4ac140cb9a1ae"></script>
<script src="{{asset "js/page/scripture-dev-core.js"}}&amp;frv=db01221e4f4b8ea6"></script>
<script src="{{asset "js/page/scripture-dev.js"}}&amp;frv=080120142cc46c58"></script>
{{!-- From Mere Orthodoxy: the essays that relate to this page (mo-articles-placements.js; draws nothing when there are none). --}}
<script src="{{asset "js/lib/mo-articles-dv.js"}}"></script>
<script src="{{asset "js/lib/mo-articles.js"}}"></script>
<script src="{{asset "js/lib/mo-articles-module.js"}}&amp;frv=d1ce20491cdef501"></script>
<script src="{{asset "js/page/mo-articles-placements.js"}}&amp;frv=39bd5ad790a1f7e6"></script>
{{!-- The passage's reception history and the commentaries with their own note on the verse (faith-port-scripture-notes.js, from v1/enrich and the chapter files). --}}
<link rel="stylesheet" href="{{asset "css/port/dev-notes.css"}}&amp;frv=cdbf83b06a8a370c"><script defer src="{{asset "js/page/faith-port-scripture-notes.js"}}&amp;frv=deeed471919ecb7b"></script>
<script src="{{asset "js/page/faith-tfr-rail.js"}}" defer></script>
<script defer src="{{asset "js/page/scripture-view.js"}}&amp;frv=633c328d4b412260"></script>
{{!-- The commentary beside the text (2026-10-18): a chosen commentary follows the reader verse by verse, and the Critici Sacri show
     every critic on the verse. On unless the page is opened with ?pane=0 (kept for the tab; ?pane=1 turns it back on). The rail is half the width and opens on
     the Commentary (tabs: Commentary, Citations, Reception); commentary-pages.js loads every kind of work and commentary-anchor.js finds where a commentary comments on the verse. --}}
<link rel="stylesheet" href="{{asset "css/commentary-pane.css"}}&amp;frv=ab7ad3377ad957cc">
<script defer src="{{asset "js/page/commentary-pages.js"}}&amp;frv=9c286408d1cfdaf8"></script>
<script defer src="{{asset "js/page/commentary-anchor.js"}}&amp;frv=3b78dedd54673e5b"></script>
<script defer src="{{asset "js/page/commentary-pane.js"}}&amp;frv=c1c2d42210d4a076"></script>
