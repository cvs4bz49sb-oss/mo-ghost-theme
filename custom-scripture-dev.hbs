{{!< default}}
{{!-- The TFR rail, first on the page and pinned under the masthead as on the reader (Ian, 2026-09-23). --}}
{{> "faith-received/_tfr-rail"}}
{{#contentFor "moHead"}}
<title>Scripture | The Faith Received | Mere Orthodoxy</title>
<meta name="description" content="Read any chapter of the Bible with the church&#39;s teachers beside it: every verse opens where the creeds, confessions and the library&#39;s authors cite it." />
<link rel="stylesheet" href="{{asset "css/scripture-dev.css"}}&amp;frv=adb123437a61e229" />
{{/contentFor}}
{{!-- /the-faith-received/scripture/ — the Scripture reader, rebuilt (Ian, 2026-09-22). The whole chapter is typeset as the old
     /bible/ page set it, every verse is a button, and a verse opens a
     sidebar of what the library says about it, with a link to that
     verse's Verse Desk at /the-faith-received/scripture/desk/?ref=<book>.<c>.<v>.

     Address: ?ref=john.3 or ?ref=john.3.16, &t=NIV for a translation.
     Text from mo-bible (bolls.life); citations from mo-tfr-verse.
     Scripts are external files: the site CSP forbids inline script. --}}

<main class="bible sd sd-reader" data-sd-reader>

{{!-- The same hero as the live Topics and Scripture Index pages
     (Ian, 2026-09-22: "they both need headers"). It carries the page's
     one h1; the chapter, verse or topic below is an h2. --}}
<section class="bhero bhero--tool">
  <div class="bhero-inner container">
    <p class="bhero-kicker"><a href="/the-faith-received/">The Faith Received</a> <span aria-hidden="true">&middot;</span> Scripture</p>
    <h1>Scripture</h1>
    <p class="bhero-sub">Read any chapter of the Bible with the church's teachers beside it. Select a verse to see where they cite it, or open its Verse Desk for everything at once.</p>
  </div>
</section>


  {{!-- The bar under the rail: where you are, and the way anywhere
       else. Sticky, so a reader deep in a chapter can still move.

       Ian, 2026-09-22: three tabs instead of one long book selector, so
       the Apocrypha is a division a reader can see rather than seven
       names buried at the bottom of a list of 73. The tabs choose the
       division; the Book select beside them is scoped to whichever
       division is showing. Tabs activate on click or Enter, not on
       arrow, because activating one loads a chapter. --}}
  <nav class="bible-controls sd-bar" aria-label="Passage and translation">
    <div class="container sd-canon">
      <div class="faith-view-toggle sd-canon-tabs" role="tablist" aria-label="Division of the Bible" data-sd-tabs>
        <button type="button" class="faith-view-toggle-tab is-active" role="tab" id="sd-tab-ot" data-sd-tab="ot" aria-selected="true" aria-controls="sd-book-panel">Old Testament</button>
        <button type="button" class="faith-view-toggle-tab" role="tab" id="sd-tab-nt" data-sd-tab="nt" aria-selected="false" aria-controls="sd-book-panel">New Testament</button>
        <button type="button" class="faith-view-toggle-tab" role="tab" id="sd-tab-ap" data-sd-tab="ap" aria-selected="false" aria-controls="sd-book-panel">Apocrypha</button>
      </div>
    </div>
    <div class="container bible-controls-inner sd-bar-inner">
      <div class="bible-control sd-book-panel" id="sd-book-panel" role="tabpanel" aria-labelledby="sd-tab-ot" data-sd-book-panel>
        <label class="bible-control-label" for="sd-book">Book</label>
        <select id="sd-book" data-sd-book></select>
      </div>
      <label class="bible-control bible-control--chapter">
        <span class="bible-control-label">Chapter</span>
        <select data-sd-chapter aria-label="Chapter"></select>
      </label>
      <label class="bible-control" data-sd-translation-control>
        <span class="bible-control-label">Translation</span>
        <select data-sd-translation aria-label="Translation"></select>
      </label>
      {{!-- The deuterocanon has one text and mo-bible cannot serve it,
           so on those books the picker is replaced by the name of the
           text actually on screen. A disabled dropdown would be a dead
           control that never says why. --}}
      <p class="bible-control sd-fixed-text" data-sd-fixed-text hidden>
        <span class="bible-control-label">Text</span>
        <span class="sd-fixed-text-name" data-sd-fixed-text-name></span>
      </p>
      <button type="button" class="sd-comm-toggle" data-sd-comm-toggle aria-expanded="false" aria-controls="sdCommPanel">Commentaries <span data-sd-comm-count></span></button>
      <div class="bible-controls-nav">
        <button type="button" class="bible-nav-btn" data-sd-prev aria-label="Previous chapter"><span aria-hidden="true">&larr;</span></button>
        <button type="button" class="bible-nav-btn" data-sd-next aria-label="Next chapter"><span aria-hidden="true">&rarr;</span></button>
      </div>
    </div>
  </nav>

  {{!-- Same .container as the bar above, so the filters, the count and
       the strip line up with Book/Chapter/Translation. --}}
  <section class="sd-comm-panel" id="sdCommPanel" data-sd-comm-panel hidden aria-label="Commentaries">
    <div class="container" data-sd-comm-host></div>
  </section>

  <div class="container sd-layout" data-sd-layout>
    <article class="bible-chapter sd-text" data-sd-text>
      <p class="bible-status" role="status">Loading scripture&hellip;</p>
    </article>
    <aside class="sd-side" data-sd-side hidden aria-label="Verse"></aside>
  </div>

  <p class="container bible-attribution sd-attribution" data-sd-attribution></p>
</main>

<script src="{{asset "js/page/scripture-dev-core.js"}}&amp;frv=e8c14ebb6f36dcb3"></script>
<script src="{{asset "js/page/scripture-dev.js"}}&amp;frv=ad659b48229d44d8"></script>
<script src="{{asset "js/page/faith-tfr-rail.js"}}" defer></script>
