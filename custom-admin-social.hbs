{{!< default}}
{{!-- /admin/social/ — social media dashboard.
     Three manual actions: Generate (create social posts via Claude),
     Delete (remove from Buffer), Push (send to Buffer).
     Staff-only; talks to the admin worker. --}}

<main class="admin-page admin-workspace">

  {{#if @member}}

    {{> "admin-sidebar" active="social"}}
    <div class="admin-main">
      <header class="admin-topbar">
        <h1 class="admin-topbar-title">Social Dashboard</h1>
        <p class="admin-topbar-sub">Generate, review, and push social posts to Buffer.</p>
      </header>

    <section class="admin-body">
      <div class="container container-narrow">
        <div class="admin-social"
             data-admin-social
             data-worker-url="{{@custom.admin_worker_url}}">

          {{!-- Action buttons --}}
          <div class="social-actions" data-social-actions>
            <button type="button" class="social-action-btn social-action-btn--generate" data-action="generate">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
              Generate
            </button>
            <button type="button" class="social-action-btn social-action-btn--delete" data-action="delete" disabled>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
              Delete
            </button>
            <button type="button" class="social-action-btn social-action-btn--push" data-action="push" disabled>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
              Push to Buffer
            </button>
          </div>

          {{!-- Status bar --}}
          <div class="social-status" data-social-status hidden>
            <p class="social-status-text" data-status-text></p>
          </div>

          {{!-- Generated drafts --}}
          <div class="social-drafts" data-social-drafts hidden>
            <div class="social-drafts-header">
              <h2 class="social-drafts-title">Generated Posts</h2>
              <label class="social-select-all">
                <input type="checkbox" data-select-all checked> Select all
              </label>
            </div>
            <div class="social-drafts-list" data-drafts-list></div>
          </div>

          {{!-- Delete modal --}}
          <div class="social-modal-backdrop" data-delete-modal hidden>
            <div class="social-modal">
              <h3 class="social-modal-title">Delete Posts</h3>
              <div class="social-modal-body" data-delete-body></div>
              <div class="social-modal-actions">
                <button type="button" class="social-action-btn social-action-btn--delete" data-delete-confirm>Delete Selected</button>
                <button type="button" class="social-modal-cancel" data-delete-cancel>Cancel</button>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    </div>

  {{else}}
    {{> "admin-denied"}}
  {{/if}}

</main>

<script src="{{asset "js/admin-auth.js"}}"></script>
<script src="{{asset "js/admin-sidebar.js"}}"></script>
<script src="{{asset "js/admin-social.js"}}"></script>
