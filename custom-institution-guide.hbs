<meta property="og:title" content="Using Your Organizational Membership" />
<meta property="og:description" content="How to get your church, seminary, or organization signed up, and how to curate reading for them." />
<meta name="twitter:title" content="Using Your Organizational Membership" />
<meta name="twitter:description" content="How to get your church, seminary, or organization signed up, and how to curate reading for them." />
