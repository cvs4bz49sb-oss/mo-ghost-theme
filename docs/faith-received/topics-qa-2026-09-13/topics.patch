+test('repeated cursors, unchanged pages, wrong sources and incomplete totals fail without destroying previous records',()=>{const a=R.mergeTopicEvidence({},page([row('one')]),scope);for(const bad of [page([row('two')]),page([row('one')],'n2'),page([{...row('two'),author_id:'other'}],'n2'),page([row('two')],null,3),{...page([row('two')],null),snapshot_id:'old'}, {...page([row('two')],null),filters:{...page([]).filters,work_id:'other'}}])assert.throws(()=>R.mergeTopicEvidence(a,bad,scope));assert.equal(a.rows.length,1);});
+test('extracted statements are labelled and do not request a purported quote highlight',()=>{const html=R.statementHTML(row('one'),{evidenceKind:true},{readerHrefHl:(w,p,hl)=>'/read?w='+w+(hl?'&hl=unexpected':'')+'#b'+p+'-0',readerHref:()=>'',pgl:()=> 'col.',previewBtn:()=>'',pinBtn:()=>''});assert.match(html,/Extracted statement/);assert.doesNotMatch(html,/hl=unexpected/);assert.match(html,/data-evidence-id="one"/);assert.match(html,/52:0183A/);});
