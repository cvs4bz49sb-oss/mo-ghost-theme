+const {test}=require('node:test'),assert=require('node:assert/strict'),fs=require('node:fs'),vm=require('node:vm');
+const box={module:{exports:{}}};vm.runInNewContext(fs.readFileSync(__dirname+'/research-tools.js','utf8'),box);const R=box.module.exports;
+const scope={snapshot:'s1',topic:'god',author:'a1',work:'w1'},row=id=>({id,w:'w1',p:'52:0183A',author_id:'a1',q:'An extracted statement'}),page=(items,next='n1',total=2)=>({snapshot_id:'s1',filters:{topic_id:'god',author_id:'a1',work_id:'w1'},items,next_cursor:next,has_more:!!next,total});
+test('statement pages remain bounded and clamp after filters change',()=>{const rows=Array.from({length:622},(_,i)=>i);assert.equal(R.topicWindow(rows,1).rows.length,20);assert.equal(R.topicWindow(rows,1).rows[0],20);assert.equal(R.topicWindow(rows,99).page,31);assert.equal(R.topicWindow([],99).page,0);assert.equal(R.topicWindow(rows,0,8).rows.length,8);});
