+test('topic opening and late metadata do not start an exhaustive fetch or reset via outline callbacks',()=>{const source=fs.readFileSync(__dirname+'/research_shell.html','utf8'),topic=source.slice(source.indexOf('async function topicPage('),source.indexOf('/* ── scripture ── */'));assert.doesNotMatch(topic,/fr-sections-ready/);assert.match(topic,/loadEvidence\(i,le.dataset.loadAll==='true'\)/);assert.match(topic,/RX\.topicWindow\(group,shelfLimits.get\(sh\)\|\|0,8\)/);for(const m of source.matchAll(/<script\b[^>]*>([\s\S]*?)<\/script>/gi))if(m[1].trim())new vm.Script(m[1]);});
