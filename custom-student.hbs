{{!< default}}
{{!-- /student/ — .edu-gated student membership signup. Two options:
     Print + Digital ($50/yr) and Digital Only ($20/yr). The student
     email is validated client-side (student-checkout.js) and again by
     the mo-membership Worker (/api/create-student-checkout) before a
     Stripe Checkout subscription session is created. Like the group
     flow, the member is comped in Ghost via the Stripe webhook and
     revoked on customer.subscription.deleted.
     See website/workers/membership/lib/student.js. --}}

<main class="membership membership-support student-page">

  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Student Membership</p>
      <h1 class="page-hero-headline"><em>Mere&nbsp;Orthodoxy</em> for students.</h1>
      <p class="page-hero-sub">
        A discounted membership for students, verified with your school email. Full access to everything we publish, at a student rate.
      </p>
    </div>
  </section>

  <section class="student-signup">
    <div class="container container-narrow">
      <form class="student-form" data-student-form novalidate>
        <fieldset class="student-options">
          <legend class="student-legend">Choose your membership</legend>

          <label class="student-option">
            <input type="radio" name="student-variant" value="print">
            <span class="student-option-body">
              <span class="student-option-head">
                <span class="student-option-name">Print + Digital</span>
                <span class="student-option-price">$50<span class="student-option-per">/year</span></span>
              </span>
              <span class="student-option-desc">Everything digital, plus the quarterly print journal mailed to you.</span>
            </span>
          </label>

          <label class="student-option">
            <input type="radio" name="student-variant" value="digital">
            <span class="student-option-body">
              <span class="student-option-head">
                <span class="student-option-name">Digital Only</span>
                <span class="student-option-price">$20<span class="student-option-per">/year</span></span>
              </span>
              <span class="student-option-desc">Full digital access. Everything except the print journal.</span>
            </span>
          </label>
        </fieldset>

        {{!-- Mailing address — revealed by student-checkout.js only when
             "Print + Digital" is selected (the journal ships physically).
             Carried through the confirm token → Stripe metadata →
             provisionStudent → member_addresses. --}}
        <div class="student-address" data-student-address hidden>
          <p class="student-address-legend">Where should we mail the journal?</p>
          <div class="student-field">
            <label class="student-field-label" for="student-addr-line1">Street address</label>
            <input class="student-field-input" type="text" id="student-addr-line1" name="student-addr-line1" autocomplete="address-line1" maxlength="120" data-student-addr-line1>
          </div>
          <div class="student-field">
            <label class="student-field-label" for="student-addr-line2">Apt, suite, etc. <span class="student-field-optional">(optional)</span></label>
            <input class="student-field-input" type="text" id="student-addr-line2" name="student-addr-line2" autocomplete="address-line2" maxlength="120" data-student-addr-line2>
          </div>
          <div class="student-name-row">
            <div class="student-field">
              <label class="student-field-label" for="student-addr-city">City</label>
              <input class="student-field-input" type="text" id="student-addr-city" name="student-addr-city" autocomplete="address-level2" maxlength="80" data-student-addr-city>
            </div>
            <div class="student-field">
              <label class="student-field-label" for="student-addr-state">State / Province</label>
              <input class="student-field-input" type="text" id="student-addr-state" name="student-addr-state" autocomplete="address-level1" maxlength="80" data-student-addr-state>
            </div>
          </div>
          <div class="student-name-row">
            <div class="student-field">
              <label class="student-field-label" for="student-addr-postal">ZIP / Postal code</label>
