        <div class="student-name-row">
          <div class="student-field">
            <label class="student-field-label" for="student-first-name">First name</label>
            <input
              class="student-field-input"
              type="text"
              id="student-first-name"
              name="student-first-name"
              autocomplete="given-name"
              maxlength="60"
              data-student-first-name
              required
            >
          </div>
          <div class="student-field">
            <label class="student-field-label" for="student-last-name">Last name</label>
            <input
              class="student-field-input"
              type="text"
              id="student-last-name"
              name="student-last-name"
              autocomplete="family-name"
              maxlength="60"
              data-student-last-name
              required
            >
          </div>
        </div>

        <div class="student-field">
          <label class="student-field-label" for="student-school">Your school</label>
          <input
            class="student-field-input"
            type="text"
            id="student-school"
            name="student-school"
            autocomplete="organization"
            placeholder="e.g. Wheaton College"
            maxlength="120"
            data-student-school
            required
          >
        </div>

        <div class="student-field">
          <label class="student-field-label" for="student-grad-year">Graduation year</label>
          <select
            class="student-field-input student-field-select"
            id="student-grad-year"
            name="student-grad-year"
            data-student-grad-year
            required
          >
            <option value="" selected disabled>Select a year</option>
            <option value="2026">2026</option>
            <option value="2027">2027</option>
            <option value="2028">2028</option>
            <option value="2029">2029</option>
            <option value="2030">2030</option>
            <option value="2031">2031</option>
            <option value="2032">2032</option>
          </select>
        </div>

        <div class="student-field">
          <label class="student-field-label" for="student-email">Student email</label>
          <input
            class="student-field-input"
            type="email"
            id="student-email"
            name="student-email"
            inputmode="email"
            autocomplete="email"
            placeholder="you@university.edu"
            data-student-email
            required
          >
          <p class="student-field-hint">Use your school email (e.g. <strong>.edu</strong>, <strong>.ac.uk</strong>, <strong>.edu.au</strong>). It's how we verify you're a student.</p>
        </div>

        <p class="student-error" data-student-error role="alert"></p>

        <button type="submit" class="btn btn-primary btn-lg" data-student-submit disabled>Email me a confirmation link</button>
        <p class="student-fineprint">We'll email a link to confirm your school address, then take you to checkout. This is a one-time annual payment, not a subscription. We'll remind you before it expires so you can renew.</p>
      </form>

      <div class="student-success" data-student-success hidden>
        <h2 class="student-success-heading"><em>Check your email</em></h2>
        <p>We sent a confirmation link to <strong data-student-success-email></strong>. Click it to confirm your school address and finish signing up.</p>
        <p class="student-success-note">The link works for one hour. If it doesn't arrive, check your spam folder, then try again.</p>
      </div>
    </div>
