{{!< default}}
{{#contentFor "moHead"}}
<title>Faith Received Engagement | MO Admin</title>
<meta name="robots" content="noindex, nofollow" />
<meta name="description" content="Internal Mere Orthodoxy staff tool." />
<meta property="og:title" content="Faith Received Engagement | MO Admin" />
<meta property="og:description" content="Internal Mere Orthodoxy staff tool." />
<meta name="twitter:title" content="Faith Received Engagement | MO Admin" />
<meta name="twitter:description" content="Internal Mere Orthodoxy staff tool." />
{{/contentFor}}
{{!-- /admin/tfr/ — reading and search engagement for The Faith Received.

     Reads GET /stats on mo-tfr-events, which is Ghost-staff gated. The
     page skeleton renders for any signed-in member; nothing is disclosed
     until the fetch succeeds, same pattern as the rest of /admin/.

     Search queries are aggregate-only and are not attributable to a
     reader: the queries table has no member column, identity is not
     written on search events at all, and /stats suppresses anything
     seen fewer than three times. See workers/tfr-events/schema.sql.

     Window is capped at 90 days server-side; longer needs a rollup
     table, not a bigger scan. --}}

<main class="admin-page admin-workspace">

  {{#if @member}}

    {{> "admin-sidebar" active="tfr"}}
    <div class="admin-main">
      <header class="admin-topbar">
        <h1 class="admin-topbar-title"><em>Faith Received</em> Engagement</h1>
        <p class="admin-topbar-sub">What is being read, how deeply, which features get used, and what readers searched for and did not find.</p>
      </header>

      <section class="admin-body">
        <div class="container">
          <div class="admin-tfr"
               data-admin-tfr
               data-worker-url="https://mo-tfr-events.mo-podcast-feed.workers.dev">

            <div class="admin-tfr-controls">
              <label class="dashboard-form-field">
                <span class="dashboard-form-label">Window</span>
                <select data-tfr-range>
                  <option value="7">Last 7 days</option>
                  <option value="30" selected>Last 30 days</option>
                  <option value="90">Last 90 days</option>
                </select>
              </label>
              <p class="admin-tfr-status" data-tfr-status role="status" aria-live="polite">Loading…</p>
            </div>

            {{!-- Totals --}}
            <div class="admin-tfr-totals" data-tfr-totals hidden></div>

            {{!-- Ask spend and budget -- the $100/month beta cap added
                  2026-09 (see tfr-library/lib/budget.js). Reads GET
                  /admin/ask-usage on the same tfr-library worker
                  (Ghost staff only), not mo-tfr-events -- this is
                  spend history, a different concern from the
                  engagement stats the rest of this page shows. Leads
                  with today's numbers because "are we about to run out
                  today" is the question this panel exists to answer
                  first. --}}
            <section class="admin-tfr-section" data-tfr-budget
                     data-worker-url="https://mo-tfr-library.mo-podcast-feed.workers.dev">
              <h2 class="admin-tfr-section-title"><em>Ask</em> spend &amp; budget</h2>
              <p class="admin-tfr-section-note">Daily spend against the beta's $3.35/day (~$100/month) shared budget across /v1/ask and the paid-translation branch of /v1/dtc-translate. /v1/vsearch is not included -- it never calls Claude, see lib/budget.js.</p>
              <div class="admin-tfr-totals" data-tfr-budget-totals hidden></div>
              <div data-tfr-budget-trend></div>
            </section>

            {{!-- Reader reports lead. Everything else on this page is a
                  measurement; this is the only panel where a person has
                  asked for something and is waiting on an answer. --}}
            <section class="admin-tfr-section" data-tfr-issues
                     data-admin-url="{{@custom.admin_worker_url}}">
              <h2 class="admin-tfr-section-title"><em>Reported issues</em></h2>
              <p class="admin-tfr-section-note">Problems readers have reported from inside a work: a bad translation, broken formatting, a page that will not load.</p>
              <div class="tfr-issue-bar">
                <div class="tfr-issue-tabs" data-issues-tabs role="group" aria-label="Which reports">
                  <button type="button" class="tfr-issue-tab is-current" data-issue-status="open">Open</button>
                  <button type="button" class="tfr-issue-tab" data-issue-status="done">Completed</button>
                </div>
                <p class="admin-tfr-status" data-issues-status role="status" aria-live="polite"></p>
              </div>
              <div data-issues-list></div>
              <div class="tfr-issue-pager" data-issues-pager></div>
            </section>

            {{!-- Zero-result searches lead. This is the one panel that
                  generates work: it is a standing list of what the library
                  is missing, written by the readers. --}}
            <section class="admin-tfr-section">
              <h2 class="admin-tfr-section-title"><em>Searched for, not found</em></h2>
              <p class="admin-tfr-section-note">Queries that returned nothing. The strongest acquisition signal available. No other measure can show what is absent.</p>
              <div data-tfr-zero></div>
            </section>

            <section class="admin-tfr-section">
              <h2 class="admin-tfr-section-title"><em>Most read</em></h2>
              <p class="admin-tfr-section-note">Opens per work, with the number of distinct signed-in members. Anonymous readers are counted in opens but cannot be counted as members.</p>
              <div data-tfr-works></div>
            </section>

            <section class="admin-tfr-section">
              <h2 class="admin-tfr-section-title"><em>Reading depth</em></h2>
              <p class="admin-tfr-section-note">Page-shards loaded per session. The difference between opening a work and reading it.</p>
              <div data-tfr-depth></div>
            </section>

            <section class="admin-tfr-section">
              <h2 class="admin-tfr-section-title"><em>By collection</em></h2>
              <div data-tfr-corpora></div>
            </section>

            <section class="admin-tfr-section">
              <h2 class="admin-tfr-section-title"><em>Features</em></h2>
              <div data-tfr-features></div>
            </section>

            <section class="admin-tfr-section">
              <h2 class="admin-tfr-section-title"><em>All searches</em></h2>
              <p class="admin-tfr-section-note">Aggregate only, and shown at three or more occurrences. Queries are stored in a table with no member column, and identity is not recorded on search events.</p>
              <div data-tfr-queries></div>
            </section>

          </div>
        </div>
      </section>
    </div>

  {{else}}
    {{> "admin-denied"}}
  {{/if}}

</main>

<script src="{{asset "js/admin-sidebar.js"}}"></script>
<script src="{{asset "js/admin-tfr.js"}}"></script>
<script src="{{asset "js/admin-tfr-issues.js"}}"></script>
<script src="{{asset "js/admin-tfr-budget.js"}}"></script>
