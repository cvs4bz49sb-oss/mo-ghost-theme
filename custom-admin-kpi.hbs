{{!< default}}
{{#contentFor "moHead"}}
<title>KPI Dashboard | MO Admin</title>
<meta name="robots" content="noindex, nofollow" />
<meta name="description" content="Internal Mere Orthodoxy staff tool." />
<meta property="og:title" content="KPI Dashboard | MO Admin" />
<meta property="og:description" content="Internal Mere Orthodoxy staff tool." />
<meta name="twitter:title" content="KPI Dashboard | MO Admin" />
<meta name="twitter:description" content="Internal Mere Orthodoxy staff tool." />
{{/contentFor}}
{{!-- /admin/kpi/ — nightly KPI snapshot across Ghost, Stripe, HubSpot,
     Kit, Plausible and Buzzsprout. The snapshot is written by the
     04:59 UTC cron on mo-admin; this page only reads it, so it loads
     fast and shows the same numbers to everyone. Page skeleton renders
     for any signed-in member; the worker gates the data by Ghost staff
     membership and admin-kpi.js surfaces that as a denied state. --}}

<main class="admin-page admin-workspace">

  {{#if @member}}
    {{> "admin-sidebar" active="kpi"}}
    <div class="admin-main">
      <header class="admin-topbar">
        <h1 class="admin-topbar-title"><em>KPI Dashboard</em></h1>
        <p class="admin-topbar-sub">
          Every headline number, pulled nightly and kept forever.
          <span class="kpi-stamp" data-kpi-stamp></span>
        </p>
      </header>

      <section class="admin-body">
        <div class="container" data-kpi-root data-worker-url="{{@custom.admin_worker_url}}">

          <div class="kpi-toolbar">
            <div class="kpi-history">
              <label class="kpi-history-label" for="kpi-date">Showing</label>
              <input type="date" id="kpi-date" class="kpi-date" data-kpi-date />
              <button type="button" class="kpi-btn" data-kpi-today>Latest</button>
            </div>
            <div class="kpi-toolbar-right">
              <span class="kpi-sources" data-kpi-sources></span>
              <button type="button" class="kpi-btn" data-kpi-refresh>Refresh now</button>
            </div>
          </div>

          <div class="kpi-granrow" data-kpi-gran></div>

          <div class="kpi-action" data-kpi-action hidden>
            <div class="kpi-action-mark">Today's action</div>
            <div class="kpi-action-body">
              <h2 class="kpi-action-title" data-kpi-action-title></h2>
              <p class="kpi-action-text" data-kpi-action-text></p>
              <p class="kpi-action-meta">
                <span class="kpi-action-metric" data-kpi-action-metric></span>
                <span class="kpi-action-alt" data-kpi-action-alt></span>
              </p>
            </div>
          </div>

          <details class="kpi-sec" open>
            <summary><span class="kpi-chev"></span>KPIs</summary>
            <div class="kpi-tiles" data-kpi-tiles>
              <p class="kpi-empty">Loading the latest snapshot…</p>
            </div>
            <details class="kpi-sub">
              <summary><span class="kpi-chev"></span>Substack — enter the numbers<span class="kpi-scount" data-kpi-ss-count></span></summary>
              <div class="kpi-panel">
                <p class="kpi-note" style="margin:0 0 12px">
                  Substack publishes no API, so these are read off the Substack Overview page and entered by hand.
                  Add updates the totals above immediately; Save writes them to the snapshot so every future
                  reading keeps its history.
                </p>
                <div class="kpi-ssform">
                  <label>Date<input type="date" data-ss-date /></label>
                  <label>Gross annualised revenue<input type="text" inputmode="decimal" placeholder="$6,494" data-ss-revenue /></label>
                  <label>Paid subscribers<input type="text" inputmode="numeric" placeholder="74" data-ss-paid /></label>
                  <label>Total subscribers<input type="text" inputmode="numeric" placeholder="5,838" data-ss-total /></label>
                  <div class="kpi-ssbtns">
                    <button type="button" class="kpi-btn is-primary" data-ss-add>Add</button>
                    <button type="button" class="kpi-btn" data-ss-remove>Remove</button>
                    <button type="button" class="kpi-btn" data-ss-save>Save</button>
                  </div>
                </div>
                <p class="kpi-ssmsg" data-ss-msg></p>
                <div class="kpi-sstable" data-ss-table></div>
              </div>
              <div class="kpi-charts" data-kpi-substack></div>
            </details>
          </details>

          <details class="kpi-sec" open>
            <summary><span class="kpi-chev"></span>Revenue</summary>
            <div class="kpi-charts" data-kpi-revenue></div>
          </details>

          <details class="kpi-sec" open>
            <summary><span class="kpi-chev"></span>Acquisition</summary>
            <div class="kpi-charts" data-kpi-acquisition></div>
          </details>

          <details class="kpi-sec" open>
            <summary><span class="kpi-chev"></span>Traffic</summary>
            <div class="kpi-charts" data-kpi-traffic></div>
          </details>

          <details class="kpi-sec" open>
            <summary><span class="kpi-chev"></span>Email</summary>
            <div class="kpi-charts" data-kpi-email></div>
          </details>

          <details class="kpi-sec" open>
            <summary><span class="kpi-chev"></span>Podcasts</summary>
            <div class="kpi-charts" data-kpi-podcasts></div>
          </details>

          <details class="kpi-sec" open>
            <summary><span class="kpi-chev"></span>Warnings</summary>
            <div class="kpi-panel" data-kpi-flags></div>
          </details>

          <details class="kpi-sec" open>
            <summary><span class="kpi-chev"></span>Suggestions</summary>
            <div class="kpi-panel" data-kpi-analysis></div>
          </details>

          <div class="kpi-tip" data-kpi-tip role="status" aria-live="polite"></div>

          <p class="kpi-foot">
            Snapshots are taken at 11:59pm Central and never overwritten. Pick any past date to see that evening's
            numbers; dates before 3 Aug 2026 are reconstructed from platform history rather than snapshotted.
          </p>

        </div>
      </section>
    </div>
  {{else}}
    {{> "admin-denied"}}
  {{/if}}

</main>

<script src="{{asset "js/admin-auth.js"}}"></script>
<script src="{{asset "js/admin-sidebar.js"}}"></script>
<script src="{{asset "js/admin-kpi.js"}}"></script>
