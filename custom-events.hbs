{{!< default}}
{{#contentFor "moHead"}}{{#is "post"}}<title>{{meta_title}}</title>{{else}}
<title>Events | Mere Orthodoxy</title>
<meta name="description" content="Online forums and in-person conversations from Mere Orthodoxy. Upcoming events and past replays." />
<meta property="og:title" content="Events" />
<meta property="og:description" content="Online forums and in-person conversations from Mere Orthodoxy. Upcoming events and past replays." />
<meta name="twitter:title" content="Events" />
<meta name="twitter:description" content="Online forums and in-person conversations from Mere Orthodoxy. Upcoming events and past replays." />
{{/is}}{{/contentFor}}
{{!-- /events/ is the library of every #event post, split into
     Upcoming and Past Events. An event is past once its post carries
     the internal tag #past-event or has a replay embed. The tag is the
     reliable signal: a members-only replay is invisible to anyone
     signed out, so the embed alone would put a finished event back
     under Upcoming for them. The event detail and registration form live at
     /forum/ and on each event's own post. --}}

{{!-- Guard: if a post is given this template in Ghost's post settings,
     render it as an event page, not as a second copy of this list. --}}
{{#is "post"}}
{{#post}}{{> "event-post"}}{{/post}}
{{else}}
<main class="events-page">

  <div data-events-source hidden>
    {{#get "posts" filter="tag:hash-event" include="tags" order="published_at desc" limit="all"}}
      {{#foreach posts}}
        <article class="events-item"
                 data-slug="{{slug}}"
                 data-url="{{url}}"
                 data-title="{{title}}"
                 data-excerpt="{{custom_excerpt}}"
                 data-summary="{{excerpt words="32"}}"
                 data-past="{{#has tag="#past-event"}}1{{/has}}"
                 data-members-only="{{#match visibility "!=" "public"}}1{{/match}}"
                 data-feature-image="{{#if feature_image}}{{img_url feature_image size="xl"}}{{/if}}"
                 data-published-at="{{published_at}}">
          <div class="events-item-content">{{content}}</div>
        </article>
      {{/foreach}}
    {{/get}}
  </div>

  <section class="hero events-library-hero">
    <div class="container">
      <p class="hero-kicker"><span class="dot"></span> Online Forums</p>
      <h1 class="hero-headline">Conversations <span class="highlight"><em>For Humans</em></span>.</h1>
      <p class="hero-sub">Online gatherings with editors, contributors, and leading thinkers on theology, culture, and faithful public witness. Register for what's next; revisit every past event in the library.</p>
    </div>
  </section>

  <section class="events-library-body">
    <div class="container">

      <div class="events-library-section">
        <div class="events-library-head">
          <p class="eyebrow">Upcoming</p>
          <h2 class="events-library-title"><em>What's next.</em></h2>
        </div>
        <ol class="events-grid" data-events-library-upcoming-list></ol>
        <div class="events-none{{#unless @member}} events-none--signup{{/unless}}" data-events-library-none hidden>
          <div class="events-none-copy">
            <p class="events-none-title">No upcoming events right now.</p>
            <p class="events-none-sub">We announce new forums in the Weekly Digest first. Free, every Thursday.</p>
          </div>
          {{#unless @member}}
          {{!-- Same Ghost-native signup as the homepage Weekly Digest form
               (partials/digest-cta.hbs); inline-signup.js handles it. --}}
          <div class="digest-form" data-inline-signup data-newsletter="weekly-digest" data-source="events-page">
            <div class="digest-field">
              <label for="events-digest-first">First Name</label>
              <input id="events-digest-first" type="text" autocomplete="given-name" placeholder="First" data-signup-first required />
            </div>
            <div class="digest-field">
              <label for="events-digest-last">Last Name</label>
              <input id="events-digest-last" type="text" autocomplete="family-name" placeholder="Last" data-signup-last required />
            </div>
            <div class="digest-field">
              <label for="events-digest-email">Email</label>
              <input id="events-digest-email" type="email" autocomplete="email" placeholder="you@example.com" data-signup-email required />
            </div>
            {{> "digest-also-daily"}}
            <button type="button" class="digest-submit" data-signup-submit data-hm-goal="digest-signup">Subscribe</button>
            <p class="digest-fineprint">Free. Delivered Thursday mornings.</p>
            <p class="digest-status" data-signup-status></p>
          </div>
          {{/unless}}
        </div>
      </div>

      <div class="events-library-section" data-events-library-past hidden>
        <div class="events-library-head">
          <p class="eyebrow">Past Events</p>
          <h2 class="events-library-title"><em>The archive.</em></h2>
          <p class="events-library-sub">Paid Members can watch every replay in <a href="/dashboard/replays/">the replay library</a>.</p>
        </div>
        <ol class="events-grid" data-events-library-past-list></ol>
      </div>

    </div>
  </section>

</main>

<script src="{{asset "js/events.js"}}"></script>
{{/is}}
