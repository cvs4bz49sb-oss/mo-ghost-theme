<h1 style="color:var(--accent);text-wrap:balance">Search The Faith Received</h1>
<div class="smodes-wrap"><div class="smodes" role="group" aria-label="Search mode">
  <button data-m="title" class="active sm-core" aria-pressed="true" title="Find a work, author, or section">Works</button>
  <button data-m="full" class="sm-core" aria-pressed="false" title="Find passages in the texts">Passages</button>
  <button data-m="scripture" class="sm-core" aria-pressed="false" title="Find commentary on a Bible passage">Scripture</button>
  <button data-m="ask" class="sm-core" aria-pressed="false" title="Ask a question of the library">Ask</button>
</div></div>
<div id="passageMethod" class="passage-method" role="group" aria-label="Find passages by" hidden><button type="button" data-passage="full" aria-pressed="true">Exact words</button><button type="button" data-passage="meaning" aria-pressed="false">By idea</button></div>
<div class="search-query"><input class="search-box" id="q" placeholder="Find a work or author" aria-label="Search the library" enterkeyhint="search" autocomplete="off" autofocus><button type="button" id="runSearch">Search</button></div>
<div class="shint" id="hint"></div>
</div>
<button type="button" class="scope-toggle" id="scopeToggle" aria-expanded="false" hidden>Scope <span class="st-sum" id="stSum"></span> <span class="st-car">▾</span></button>
<div class="scope-wrap" id="scopeWrap">
<div class="facets" id="facets">
  <input class="fac-in" id="fAuthor" list="facAuthors" placeholder="Filter by author…" autocomplete="off">
  <datalist id="facAuthors"></datalist>
  <input class="fac-in" id="fWork" list="facWorks" placeholder="Filter by work…" autocomplete="off">
  <datalist id="facWorks"></datalist>
  <select class="fac-sel" id="fTrad" aria-label="Filter by tradition"><option value="">All traditions</option></select>
  <button class="fac-x" id="fClear" hidden title="Clear filters">clear ✕</button>
</div>
<div class="corpus-chips" id="corpusChips" hidden>
  <span class="cc-lab">Corpus:</span>
  <button type="button" class="cc on" data-c="">All</button>
  <button type="button" class="cc" data-c="library" title="The early-modern library — 1,400+ works">Library</button>
  <button type="button" class="cc" data-c="pg" title="Greek Fathers (Patrologia Graeca)">Greek Fathers</button>
  <button type="button" class="cc" data-c="pld" title="Latin Fathers (Patrologia Latina)">Latin Fathers</button>
  <button type="button" class="cc" data-c="po" title="Oriental Fathers (Patrologia Orientalis)">Oriental</button>
  <button type="button" class="cc" data-c="eebo" title="Early English Books — 3,800+ divines">EEBO</button>
  <button type="button" class="cc" data-c="confessions" title="Creeds and confessions">Confessions</button>
</div>
<div class="scopebar" id="scopeBar">
  <input class="scope-in" id="scopeAuthorIn" list="scopeAuthors" placeholder="Scope to author…" autocomplete="off">
  <datalist id="scopeAuthors"></datalist>
  <input class="scope-in" id="scopeWorkIn" list="scopeWorks" placeholder="Scope to work…" autocomplete="off">
  <datalist id="scopeWorks"></datalist>
  <div class="scope-chips" id="scopeChips"></div>
</div>
</div>
<div class="count-row"><div class="shint" id="count" aria-live="polite" aria-atomic="false"></div><button type="button" class="density-btn" id="densityBtn" aria-pressed="false">Compact</button></div><div id="results" aria-live="polite" aria-atomic="false"></div></main>
