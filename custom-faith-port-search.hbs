<div class="faith-port-search-page">

{{!-- OUTSIDE the port's <main class="main">, which is a narrow
     reading column: the header and the rail rendered inside it came
     out the width of the search form instead of the width of the
     page. Full-bleed here, the tool below keeps its column. --}}
{{!-- The header this page had only in its signed-out branch. The
     member view opened straight onto the mode tabs with a bare h1
     and no header at all, which is what Ian was looking at. Same
     .bhero as every other landing surface, then the rail. --}}
<section class="bhero bhero--tool">
  <div class="bhero-inner container">
    <p class="bhero-kicker"><a href="/the-faith-received/">The Faith Received</a> <span aria-hidden="true">&middot;</span> Search</p>
    <h1>Search</h1>
    <p class="bhero-sub">Every creed, confession, catechism and work in the library. Look for a work, a passage, a Scripture reference, or ask a question and follow the citations.</p>
  </div>
</section>
<script src="{{asset "js/page/faith-tfr-rail.js"}}" defer></script>
<a class="skip-link" href="#main">Skip to text</a><main class="main" id="main"><link rel="stylesheet" href="{{asset "css/port/search.in04.css"}}&amp;frv=f6bb85f15374fe45">


<div class="smodes-wrap"><div class="smodes" role="group" aria-label="Search mode">
  <button data-m="title" class="active sm-core" aria-pressed="true" title="Find a work, author, or section">Works</button>
  <button data-m="full" class="sm-core" aria-pressed="false" title="Find passages in the texts">Passages</button>
  <button data-m="scripture" class="sm-core" aria-pressed="false" title="Find indexed references to a Bible passage">Scripture</button>
  <button data-m="ask" class="sm-core" aria-pressed="false" title="Ask a question of the library">Ask</button>
</div></div>
<div id="passageMethod" class="passage-method" role="group" aria-label="Find passages by" hidden><button type="button" data-passage="full" aria-pressed="true">Exact words</button><button type="button" data-passage="meaning" aria-pressed="false">By idea</button></div>
<div class="search-query"><input class="search-box" id="q" placeholder="Find a work or author" aria-label="Search the library" enterkeyhint="search" autocomplete="off" type="search"><button type="button" id="runSearch">Search</button></div>
<div class="shint" id="hint"></div>
<div class="shelf-controls"><label for="fTrad">Shelf<select class="fac-sel" id="fTrad" aria-label="Shelf"><option value="">All shelves</option></select></label><button type="button" class="scope-toggle" id="scopeToggle" aria-controls="scopeWrap" aria-expanded="false">Filters &amp; order <span id="stSum"></span></button></div>
<p class="active-search-scope" id="activeSearchScope" hidden></p>
<div class="scope-wrap" id="scopeWrap" hidden>
<div class="facets" id="facets">
<label>Author<input class="fac-in" id="fAuthor" list="facAuthors" placeholder="Name or part of a name" autocomplete="off"></label><datalist id="facAuthors"></datalist>
<label>Work<input class="fac-in" id="fWork" list="facWorks" placeholder="Title or part of a title" autocomplete="off"></label><datalist id="facWorks"></datalist>
<label>Collection<select class="fac-sel" id="fCollection"><option value="">All works</option><option value="confessions">Confessions</option></select></label>
<label for="fGroup">Group<select class="fac-sel" id="fGroup"><option value="">All groups</option><option value="westminster">Westminster Divines</option><option value="puritan">Puritans</option><option value="anglican">Anglicans</option></select></label><label class="organize-label">Organize<select id="groupOrder"><option value="shelf">Shelf → author → work</option><option value="author">Author → work</option><option value="relevance">Relevance</option></select></label>
<button type="button" class="fac-x" id="fClear" hidden>Clear filters</button>
</div>
<div class="scopebar" id="scopeBar">
  <input class="scope-in" id="scopeAuthorIn" list="scopeAuthors" placeholder="Scope to author…" autocomplete="off">
  <datalist id="scopeAuthors"></datalist>
  <input class="scope-in" id="scopeWorkIn" list="scopeWorks" placeholder="Scope to work…" autocomplete="off">
  <datalist id="scopeWorks"></datalist>
  <div class="scope-chips" id="scopeChips"></div>
</div>
</div>
<div class="count-row"><div class="shint" id="count" aria-live="polite" aria-atomic="false"></div><button type="button" class="density-btn" id="densityBtn" aria-pressed="false">Compact</button></div><div id="results" role="region" aria-label="Search results"></div></main>
<script src="{{asset "js/port/research-tools.js"}}&amp;frv=79bdff36d4871537"></script><script src="{{asset "js/port/search-tools.js"}}&amp;frv=023f450e243e66c1"></script><script src="{{asset "js/page/faith-port-search-results.js"}}&amp;frv=c92dd81a5ae6f6b2"></script>
<script src="{{asset "js/port/search.in03.js"}}&amp;frv=333429ac5b50ec3d"></script>

<script src="{{asset "js/port/search.in04.js"}}&amp;frv=403b777ff0059b49"></script>

</div>
