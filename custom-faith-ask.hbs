{{!< default}}
{{#contentFor "moHead"}}
<title>Ask | The Faith Received</title>
<meta name="description" content="Ask a question of the library. The answer is written from the corpus, with every claim cited to a page you can open." />
<meta property="og:title" content="Ask | The Faith Received" />
<meta property="og:description" content="Ask a question of the library. The answer is written from the corpus, with every claim cited to a page you can open." />
<meta name="twitter:title" content="Ask | The Faith Received" />
<meta name="twitter:description" content="Ask a question of the library. The answer is written from the corpus, with every claim cited to a page you can open." />
{{/contentFor}}
{{!-- /the-faith-received/ask/ — a question answered from the library,
     with inline citations that resolve to a real reader page. Talks
     to the mo-tfr-library Worker's POST /v1/ask (see
     website/workers/tfr-library/lib/ask.js). Rendered as an editorial
     set piece, per the data owner's spec: the question becomes a
     heading, the answer is running prose, and citations are footnotes
     linking into the reader — not a chat bubble.

     Standalone route rather than a tab inside the library search page
     the "Find/Full-text/Scripture/Tradition" track is building: that
     track had not landed a search-modes page at the time this was
     built, and the task brief said not to block on it. If that page
     lands with its own "Ask" tab placeholder, this page's markup and
     assets/js/page/faith-ask.js are the pieces to wire in there —
     nothing here assumes it owns the URL forever. --}}

<main class="faith-received faith-feature">

  <section class="bhero bhero--tool">
    <div class="bhero-inner container">
      <p class="bhero-kicker"><a href="/the-faith-received/">The Faith Received</a> <span aria-hidden="true">&middot;</span> <a href="/the-faith-received/ask/">Ask</a></p>
      <h1>Ask</h1>
      <p class="bhero-sub">Ask a question of the library. The answer is written from the corpus itself, with every claim cited to a page you can open.</p>
    </div>
  </section>

  <section class="bband faith-feature-body">
    <div class="container container-narrow" data-ask-page>

      <form class="ask-form" data-ask-form>
        <label class="ask-label" for="ask-question">Your question</label>
        <textarea
          id="ask-question"
          class="ask-input"
          data-ask-input
          rows="2"
          maxlength="600"
          placeholder="e.g. What does the tradition teach about justification?"
          required
        ></textarea>
        <button type="submit" class="btn btn-primary ask-submit" data-feature-gate="ask" data-ask-submit>
          Ask the library
        </button>
      </form>

      {{!-- Usage meter -- a beta capacity cap on /v1/ask, added
            2026-09. Mirrors Anthropic's own console pattern (a labeled
            bar, a percentage, a reset time), per the shape Ian asked
            for. Reads GET /v1/ask/usage on page load and after each
            answer -- see assets/js/page/faith-ask.js. Hidden until
            that first read succeeds, so a fetch failure degrades to
            "no meter shown" rather than a stuck "Loading…" line. Reuses
            the same bar/fill/pct visual language as Memorize mode's
            progress bar (.faith-memorize-progress in
            faith-received.css) rather than inventing a new component. --}}
      <div class="ask-usage" data-ask-usage hidden>
        <div class="ask-usage-row" data-ask-usage-mine hidden>
          <div class="ask-usage-meta">
            <span class="ask-usage-label">Your questions today</span>
            <span class="ask-usage-pct" data-ask-usage-mine-text></span>
          </div>
          <div class="ask-usage-bar"><span class="ask-usage-fill" data-ask-usage-mine-fill></span></div>
        </div>
        <div class="ask-usage-row">
          <div class="ask-usage-meta">
            <span class="ask-usage-label">Beta capacity today</span>
            <span class="ask-usage-pct" data-ask-usage-global-text></span>
          </div>
          <div class="ask-usage-bar"><span class="ask-usage-fill" data-ask-usage-global-fill></span></div>
        </div>
      </div>

      <p class="ask-status" data-ask-status role="status" aria-live="polite" hidden></p>

      <article class="ask-result" data-ask-result hidden>
        <h2 class="ask-question" data-ask-heading></h2>
        <div class="ask-answer" data-ask-answer></div>

        <p class="ask-gaps" data-ask-gaps hidden></p>

        <div class="ask-footnotes-wrap" data-ask-footnotes-wrap hidden>
          <h3 class="ask-footnotes-title">Sources</h3>
          <ol class="ask-footnotes" data-ask-footnotes></ol>
        </div>
      </article>

      <p class="ask-error" data-ask-error role="alert" hidden></p>

    </div>
  </section>

  {{!-- No prices here on purpose: /membership/ is where they live. --}}
  <section class="bband bband--cream faith-tools">
    <div class="container">
      <header class="bhead">
        <p class="blabel">For members</p>
        <h2>Get the most from The Faith Received.</h2>
      </header>
      <ul class="blist blist--2 blist--tools">
        <li><span class="brow-t">Ask</span><span class="brow-m">A question answered from the corpus. Every page it drew on is cited inline.</span></li>
        <li><span class="brow-t">Semantic search</span><span class="brow-m">Search by meaning rather than by word across every collection.</span></li>
        <li><span class="brow-t">Latin word forms</span><span class="brow-m">One search across every inflection of a word.</span></li>
        <li><span class="brow-t">Constellations</span><span class="brow-m">The passages that stand behind a passage. Share the set as a link.</span></li>
        <li><span class="brow-t">Citation export</span><span class="brow-m">Copy, permalink, BibTeX or Zotero. Each one carries its locus.</span></li>
        <li><span class="brow-t">The notebook</span><span class="brow-m">Highlight a paragraph, keep a private note, or write your own translation.</span></li>
      </ul>
    </div>
  </section>

<section class="faith-join">
  <div class="container">
    <p class="blabel">Become a member</p>
    <h2>Use the tools and support the work.</h2>
      <div class="toggle-wrap" role="tablist" aria-label="Billing interval">
        <div class="toggle">
          <button type="button" class="toggle-option is-active" data-interval="annual" role="tab" aria-selected="true" data-hm-goal="plan-annual">
            Annual
            <span class="badge">Save 17%</span>
          </button>
          <button type="button" class="toggle-option" data-interval="monthly" role="tab" aria-selected="false" data-hm-goal="plan-monthly">Monthly</button>
        </div>
      </div>
  </div>
</section>

{{> "membership-pricing"}}
</main>
{{> "membership-cta"}}

<script src="{{asset "js/page/membership-toggle.js"}}"></script>
<script src="{{asset "js/page/membership-cards.js"}}"></script>
<script src="{{asset "js/feature-gate.js"}}"></script>
<script src="{{asset "js/page/faith-ask.js"}}"></script>
<script src="{{asset "js/faith-gate.js"}}"></script>
