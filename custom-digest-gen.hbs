{{!< default}}
{{!-- /digest-gen/ — admin-only Weekly Digest email composer.

     Single-page React tool (loaded via Babel-standalone) that lets
     admin users compose a Weekly Digest, pull essays from Ghost
     Content API, pull podcasts from Buzzsprout (via the mo-podcast-feed
     worker), preview Free vs Paid versions, and export flat HTML for
     paste-into-Kit.

     Auth pattern matches the other /admin/* tools: shell renders for
     any signed-in member; the actual sensitive bits (Ghost Content
     API key, Cloudflare Worker URL) are user-supplied and stored in
     the user's own browser localStorage. Non-staff who navigate here
     see the tool but can't pull anything until they paste their own
     keys, which only Ian holds.

     Source-of-truth for the tool lives in
     emails/weekly-digest-tool/ in the MOCA repo. Changes there should
     be mirrored here in assets/js/digest/. The two diverge only by
     the moDigestAsset() lookup added to email-template.jsx and the
     window-global lookup in app.jsx. --}}

<main class="admin-page admin-workspace">

  {{#if @member}}

    {{> "admin-sidebar" active="digest"}}
    <div class="admin-main">
      <header class="admin-topbar">
        <h1 class="admin-topbar-title"><em>Email Builder</em></h1>
        <p class="admin-topbar-sub">Compose, preview, and export emails for Kit.</p>
      </header>

      <section class="admin-body admin-body--digest" style="padding:0;">
        <div id="mo-digest-root" data-worker-url="{{@custom.admin_worker_url}}" style="background:#f1e0c9;min-height:calc(100vh - 280px);"></div>
      </section>

    </div>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IM+Fell+English:ital@0;1&family=IM+Fell+DW+Pica:ital@0;1&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet">

    <meta name="mo-digest-assets" content='{"mere-o-logo.png":"{{@site.url}}/assets/images/mere-o-logo.png","mere-fidelity.jpg":"{{@site.url}}/assets/images/mere-fidelity.jpg","christians-reading-classics.jpg":"{{@site.url}}/assets/images/christians-reading-classics.jpg"}' />

    <script src="https://unpkg.com/react@18.3.1/umd/react.production.min.js"
            integrity="sha384-DGyLxAyjq0f9SPpVevD6IgztCFlnMF6oW/XQGmfe+IsZ8TqEiDrcHkMLKI6fiB/Z"
            crossorigin="anonymous"></script>
    <script src="https://unpkg.com/react-dom@18.3.1/umd/react-dom.production.min.js"
            integrity="sha384-gTGxhz21lVGYNMcdJOyq01Edg0jhn/c22nsx0kyqP0TxaV5WVdsSH1fSDUf5YJj1"
            crossorigin="anonymous"></script>

    <script src="{{asset "js/page/digest-bootstrap.js"}}"></script>
    <script src="{{asset "js/digest/tweaks-panel.js"}}"></script>
    <script src="{{asset "js/digest/email-template.js"}}"></script>
    <script src="{{asset "js/digest/content-editor.js"}}"></script>
    <script src="{{asset "js/digest/export-html.js"}}"></script>
    <script src="{{asset "js/admin-auth.js"}}"></script>
    <script src="{{asset "js/digest/app.js"}}"></script>

  {{else}}
    {{> "admin-denied"}}
  {{/if}}

</main>

<script src="{{asset "js/admin-sidebar.js"}}"></script>
