{{!< default}}
{{#contentFor "moHead"}}
<title>Student Memberships | MO Admin</title>
<meta name="robots" content="noindex, nofollow" />
<meta name="description" content="Internal Mere Orthodoxy staff tool." />
<meta property="og:title" content="Student Memberships | MO Admin" />
<meta property="og:description" content="Internal Mere Orthodoxy staff tool." />
<meta name="twitter:title" content="Student Memberships | MO Admin" />
<meta name="twitter:description" content="Internal Mere Orthodoxy staff tool." />
{{/contentFor}}
{{!-- /admin/members/students/ — every student (.edu) membership on the
     platform. Data comes from the mo-membership Worker's student_members
     table via GET /api/admin/students; the generic admin-table.js
     hydrates the table and wires the CSV download. --}}

<main class="admin-page admin-workspace">
  {{#if @member}}
    {{> "admin-sidebar" active="members"}}
    <div class="admin-main">
      <header class="admin-topbar">
        <h1 class="admin-topbar-title"><em>Student Memberships</em></h1>
        <p class="admin-topbar-sub">Every student (.edu) membership on the platform. Download the CSV for reporting.</p>
      </header>

    <section class="admin-body">
      <div class="container">
        <div class="admin-members-layout">
          <aside class="admin-members-sidebar">
            {{> "admin-members-subnav" active="students"}}
          </aside>
          <div class="admin-members-main">
            {{!-- Pending-student rescue: students who filled the form but
                 haven't paid (often the confirmation email was blocked by
                 their school inbox). Send the payment link directly, or
                 comp a student whose school issues no academic email.
                 Hydrated by admin-students-actions.js. --}}
            <div class="admin-student-actions" data-student-actions
                 data-api-base="{{@custom.membership_api_base}}" hidden>
              <h2 class="admin-section-heading">Pending &mdash; needs payment link</h2>
              <p class="admin-section-sub">Filled out the form but haven't paid yet. Copy their payment link and send it from your own email, or comp a student whose school issues no academic email.</p>
              <ul class="admin-student-pending-list" data-pending-list></ul>
              <p class="admin-student-actions-empty" data-pending-empty hidden>No pending students right now.</p>
            </div>
            <div class="admin-table-host"
                 data-admin-table
                 data-title="Students"
                 data-endpoint="/api/admin/students"
                 data-collection="students"
                 data-api-base="{{@custom.membership_api_base}}"
                 data-member-email="{{@member.email}}"
                 data-columns="first_name,last_name,email,school,grad_year,variant,status,expires_at,line1,line2,city,state,postal_code,country,created_at"
                 data-column-labels="First,Last,Email,School,Grad Year,Plan,Status,Expires,Address,Address 2,City,State,ZIP,Country,Joined">
              <div class="admin-table-toolbar">
                <p class="admin-table-count" data-count-label>Loading&hellip;</p>
                <a href="#" class="btn btn-primary btn-sm" data-download-csv hidden>Download CSV</a>
              </div>
              <p class="admin-table-status" data-status></p>
              <div class="admin-table-wrap">
                <table class="admin-table" data-table hidden>
                  <thead><tr data-thead></tr></thead>
                  <tbody data-tbody></tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    </div>
  {{else}}
    {{> "admin-denied"}}
  {{/if}}
</main>

<script src="{{asset "js/admin-auth.js"}}"></script>
<script src="{{asset "js/admin-sidebar.js"}}"></script>
<script src="{{asset "js/admin-table.js"}}"></script>
<script src="{{asset "js/admin-students-actions.js"}}"></script>
