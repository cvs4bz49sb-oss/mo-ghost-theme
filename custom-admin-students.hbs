{{!< default}}
{{!-- /admin/members/students/ — every student (.edu) membership on the
     platform. Data comes from the mo-membership Worker's student_members
     table via GET /api/admin/students; the generic admin-table.js
     hydrates the table and wires the CSV download. --}}

<main class="admin-page admin-workspace">
  {{#if @member}}
    {{> "admin-sidebar" active="members"}}
    <div class="admin-main">
      <header class="admin-topbar">
        <h1 class="admin-topbar-title"><em>Student Memberships</em></h1>
        <p class="admin-topbar-sub">Every student (.edu) membership on the platform. Download the CSV for reporting.</p>
      </header>

    <section class="admin-body">
      <div class="container">
        <div class="admin-members-layout">
          <aside class="admin-members-sidebar">
            {{> "admin-members-subnav" active="students"}}
          </aside>
          <div class="admin-members-main">
            <div class="admin-table-host"
                 data-admin-table
                 data-title="Students"
                 data-endpoint="/api/admin/students"
                 data-collection="students"
                 data-api-base="{{@custom.membership_api_base}}"
                 data-member-email="{{@member.email}}"
                 data-columns="first_name,last_name,email,school,grad_year,variant,status,created_at"
                 data-column-labels="First,Last,Email,School,Grad Year,Plan,Status,Joined">
              <div class="admin-table-toolbar">
                <p class="admin-table-count" data-count-label>Loading&hellip;</p>
                <a href="#" class="btn btn-primary btn-sm" data-download-csv hidden>Download CSV</a>
              </div>
              <p class="admin-table-status" data-status></p>
              <div class="admin-table-wrap">
                <table class="admin-table" data-table hidden>
                  <thead><tr data-thead></tr></thead>
                  <tbody data-tbody></tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    </div>
  {{else}}
    {{> "admin-denied"}}
  {{/if}}
</main>

<script src="{{asset "js/admin-auth.js"}}"></script>
<script src="{{asset "js/admin-sidebar.js"}}"></script>
<script src="{{asset "js/admin-table.js"}}"></script>
